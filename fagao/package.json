{
  "name": "publish-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "珂抖屁公众号一期：稿件、预览与审核工作台",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "dev:ui": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/bundle-worker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply fagao --local",
    "db:migrate:remote": "wrangler d1 migrations apply fagao --remote",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8788"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "latest",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.0"
  }
}
