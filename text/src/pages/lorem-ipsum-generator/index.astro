---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'Lorem Ipsum Generator - Free Filler Text';
const description = 'Generate Lorem Ipsum placeholder text — paragraphs, words, sentences, list items. Free, fast, instant copy-to-clipboard.';

const faqs = [
  {
    q: 'When should I use Lorem Ipsum?',
    a: 'Use it when you need neutral placeholder copy to test layout, spacing, typography, CMS fields, or content slots before final writing is ready.',
  },
  {
    q: 'When should I avoid placeholder text?',
    a: 'Avoid it for final reviews, legal pages, product claims, pricing pages, or any screen where the real words affect design decisions. Real content should replace filler before launch.',
  },
  {
    q: 'Does this generator upload anything?',
    a: 'No. The text is generated in your browser from a local word pool and can be copied directly from the page.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/lorem-ipsum-generator/">
  <section class="space-y-2 mb-6">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Lorem Ipsum Generator</h1>
    <p class="text-slate-600 max-w-2xl">Generate filler text for mockups and designs. Pick paragraphs, words, sentences, or list items, hit generate, and copy.</p>
  </section>

  <AdSense adSlot="lorem-top" style="min-height:90px" />

  <section class="bg-white border border-slate-200 rounded-lg p-5 mt-4">
    <form id="lorem-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end" autocomplete="off">
      <div>
        <label for="lorem-format" class="block text-sm font-medium text-slate-700 mb-1">Output type</label>
        <select id="lorem-format" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-violet-500">
          <option value="paragraphs">Paragraphs</option>
          <option value="words">Words</option>
          <option value="sentences">Sentences</option>
          <option value="list">List items</option>
        </select>
      </div>

      <div>
        <label for="lorem-count" class="block text-sm font-medium text-slate-700 mb-1">Count</label>
        <input id="lorem-count" type="number" min="1" max="200" value="3"
               class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-violet-500" />
        <p id="lorem-count-hint" class="text-xs text-slate-500 mt-1">1–50 paragraphs</p>
      </div>

      <div id="lorem-wpp-wrap">
        <label for="lorem-wpp" class="block text-sm font-medium text-slate-700 mb-1">Words per paragraph</label>
        <input id="lorem-wpp" type="number" min="10" max="200" value="50"
               class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-violet-500" />
        <p class="text-xs text-slate-500 mt-1">Paragraph mode only</p>
      </div>

      <div class="flex flex-col gap-2">
        <label class="inline-flex items-center text-sm text-slate-700">
          <input id="lorem-classic" type="checkbox" class="mr-2" checked />
          Start with "Lorem ipsum…"
        </label>
        <button type="button" id="lorem-regen" class="px-4 py-2 bg-violet-600 text-white rounded hover:bg-violet-700 text-sm font-medium">Regenerate</button>
      </div>
    </form>
  </section>

  <section class="mt-6 bg-slate-50 border border-slate-200 rounded-lg p-5">
    <div class="flex items-center justify-between mb-2">
      <label for="lorem-output" class="text-sm font-medium text-slate-700">Generated text</label>
      <div class="flex items-center gap-3">
        <span id="lorem-copy-status" class="text-xs text-emerald-600 hidden">Copied!</span>
        <button type="button" id="lorem-copy" class="text-sm text-violet-600 hover:text-violet-700 font-medium">Copy to clipboard</button>
      </div>
    </div>
    <textarea id="lorem-output" rows="14" readonly
              class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm leading-relaxed resize-y bg-white"></textarea>
  </section>

  <section class="mt-10 space-y-3 text-slate-700 leading-relaxed">
    <h2 class="text-2xl font-bold mb-3">About Lorem Ipsum</h2>
    <p class="mb-3">"Lorem Ipsum" is dummy text used in design and typesetting. It dates back to a 1st-century BC Latin text by Cicero (<em>De finibus bonorum et malorum</em>) that was scrambled by an unknown printer in the 1500s — and stuck around because it gives designers something readable-looking but meaning-free, so layout choices aren't biased by content.</p>
    <p class="mb-3">The classic opener — <em>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</em> — is a corruption of "neque porro quisquam est qui dolorem ipsum quia dolor sit amet…" ("there is no one who loves pain itself, who seeks after it and wants to have it…").</p>
    <p class="mb-3">Use this generator for: design mockups, content slot sizing, testing typography, page layouts, content management systems, or anywhere you need realistic-looking placeholder copy.</p>

    <h2 class="text-2xl font-bold mt-8 mb-3">How this generator works</h2>
    <p class="mb-3">The generator builds paragraphs, sentences, words, or list items from a local Latin-style word pool. Paragraphs are assembled from sentence-length chunks, and the optional classic opener replaces the first sentence when enabled.</p>
    <p class="mb-3"><strong>Limitations:</strong> generated filler can hide real copy problems. It will not reveal whether a headline is too long, whether product claims are clear, or whether legal/compliance language is correct. Replace placeholder text before launch.</p>
    <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. This page intentionally uses fewer ad placements because the tool is simple and the main value should stay visible.</p>

    <section class="mt-10">
      <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
      <div class="space-y-2">
        {faqs.map((f) => (
          <details class="border border-slate-200 rounded p-4 group">
            <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })} />
  </section>

  <AdSense adSlot="lorem-bottom" style="min-height:90px" />

  <script>
    const POOL = 'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam quis nostrud exercitation ullamco laboris nisi aliquip ex ea commodo consequat duis aute irure in reprehenderit voluptate velit esse cillum fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa qui officia deserunt mollit anim id est laborum vero accusamus iusto odio dignissimos ducimus blanditiis praesentium voluptatum corrupti quos dolores quas molestias'.split(/\s+/);
    const CLASSIC_OPENER = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.';

    const $format = document.getElementById('lorem-format') as HTMLSelectElement;
    const $count = document.getElementById('lorem-count') as HTMLInputElement;
    const $countHint = document.getElementById('lorem-count-hint') as HTMLElement;
    const $wpp = document.getElementById('lorem-wpp') as HTMLInputElement;
    const $wppWrap = document.getElementById('lorem-wpp-wrap') as HTMLElement;
    const $classic = document.getElementById('lorem-classic') as HTMLInputElement;
    const $output = document.getElementById('lorem-output') as HTMLTextAreaElement;
    const $regen = document.getElementById('lorem-regen') as HTMLButtonElement;
    const $copy = document.getElementById('lorem-copy') as HTMLButtonElement;
    const $copyStatus = document.getElementById('lorem-copy-status') as HTMLElement;

    function rand(n: number) { return Math.floor(Math.random() * n); }

    function randomWord(): string {
      return POOL[rand(POOL.length)];
    }

    function capitalize(s: string): string {
      return s.charAt(0).toUpperCase() + s.slice(1);
    }

    // Build a sentence: 5-15 words, first capitalized, ends with period.
    // Optionally inject one comma in the middle for realism.
    function buildSentence(): string {
      const len = 5 + rand(11); // 5..15
      const words: string[] = [];
      for (let i = 0; i < len; i++) words.push(randomWord());
      words[0] = capitalize(words[0]);
      // Optional comma — roughly 1 in 3 sentences
      if (len >= 7 && rand(3) === 0) {
        const pos = 2 + rand(len - 4);
        words[pos] = words[pos] + ',';
      }
      return words.join(' ') + '.';
    }

    // Build a paragraph that targets ~targetWords total, made of full sentences.
    function buildParagraph(targetWords: number): string {
      const sentences: string[] = [];
      let count = 0;
      while (count < targetWords) {
        const s = buildSentence();
        sentences.push(s);
        count += s.split(/\s+/).length;
      }
      return sentences.join(' ');
    }

    function updateCountHint() {
      const fmt = $format.value;
      const labels: Record<string, string> = {
        paragraphs: '1–50 paragraphs',
        words: '1–1000 words',
        sentences: '1–200 sentences',
        list: '1–100 list items',
      };
      $countHint.textContent = labels[fmt] || '';
      $wppWrap.style.display = fmt === 'paragraphs' ? '' : 'none';
      // Adjust max
      const maxes: Record<string, number> = { paragraphs: 50, words: 1000, sentences: 200, list: 100 };
      $count.max = String(maxes[fmt] ?? 50);
      const cur = parseInt($count.value || '1', 10);
      if (!isNaN(cur) && cur > maxes[fmt]) $count.value = String(maxes[fmt]);
    }

    function clamp(n: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, n)); }

    function generate(): string {
      const fmt = $format.value;
      const count = clamp(parseInt($count.value || '1', 10) || 1, 1, 1000);
      const wpp = clamp(parseInt($wpp.value || '50', 10) || 50, 10, 200);
      const useClassic = $classic.checked;

      if (fmt === 'words') {
        const words: string[] = [];
        for (let i = 0; i < count; i++) words.push(randomWord());
        if (useClassic) {
          // Replace the leading words with the classic opener words
          const openers = ['lorem','ipsum','dolor','sit','amet','consectetur','adipiscing','elit'];
          for (let i = 0; i < Math.min(openers.length, words.length); i++) words[i] = openers[i];
        }
        words[0] = capitalize(words[0]);
        return words.join(' ') + '.';
      }

      if (fmt === 'sentences') {
        const out: string[] = [];
        for (let i = 0; i < count; i++) out.push(buildSentence());
        if (useClassic && out.length > 0) out[0] = CLASSIC_OPENER;
        return out.join(' ');
      }

      if (fmt === 'list') {
        const items: string[] = [];
        for (let i = 0; i < count; i++) {
          // 3-8 word list items, no trailing period
          const len = 3 + rand(6);
          const words: string[] = [];
          for (let j = 0; j < len; j++) words.push(randomWord());
          words[0] = capitalize(words[0]);
          items.push('- ' + words.join(' '));
        }
        return items.join('\n');
      }

      // paragraphs
      const paragraphs: string[] = [];
      for (let i = 0; i < count; i++) {
        let p = buildParagraph(wpp);
        if (useClassic && i === 0) {
          // Replace first sentence with classic opener
          const rest = p.split(/(?<=\.)\s+/).slice(1).join(' ');
          p = (rest ? CLASSIC_OPENER + ' ' + rest : CLASSIC_OPENER);
        }
        paragraphs.push(p);
      }
      return paragraphs.join('\n\n');
    }

    function regenerate() {
      $output.value = generate();
    }

    $format.addEventListener('change', () => { updateCountHint(); regenerate(); });
    $count.addEventListener('input', regenerate);
    $wpp.addEventListener('input', regenerate);
    $classic.addEventListener('change', regenerate);
    $regen.addEventListener('click', regenerate);

    $copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText($output.value);
        $copyStatus.classList.remove('hidden');
        setTimeout(() => $copyStatus.classList.add('hidden'), 1500);
      } catch (e) {
        // Fallback: select & copy
        $output.select();
        document.execCommand('copy');
        $copyStatus.classList.remove('hidden');
        setTimeout(() => $copyStatus.classList.add('hidden'), 1500);
      }
    });

    updateCountHint();
    regenerate();
  </script>
</BaseLayout>
