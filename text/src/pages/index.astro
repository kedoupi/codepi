---
import BaseLayout from '@shared/layouts/BaseLayout.astro';

const title = 'Free Text Utilities for Word Counts';
const description = 'Free word counter for words, characters, sentences, and reading time. Instant browser results, no signup.';

const tools = [
  { href: '/word-counter/', name: 'Word Counter', blurb: 'Real-time word, character, sentence, paragraph counts plus reading time.' },
];
---
<BaseLayout title={title} description={description} pathname="/" schemaType="WebSite">
  <section class="mb-10 max-w-4xl space-y-4">
    <p class="kdp-section-label">Writing checks without a login wall</p>
    <h1 class="text-5xl font-semibold leading-[1.02] sm:text-6xl">Free Text Utilities</h1>
    <p class="max-w-3xl text-xl leading-8 text-stone-700">Fast, no-signup text tools for writers, editors, students, and developers. Count words and characters, and estimate reading time before you publish or send a draft.</p>
    <p class="max-w-3xl text-stone-600 leading-7">TextKDP is intentionally small: each page solves one text task, explains when to use it, and runs locally in your browser so drafts and pasted notes are not uploaded to a server.</p>
  </section>


  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    {tools.map((c) => (
      <a href={c.href} class="kdp-card block rounded-2xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2">
        <article>
          <h2 class="font-serif text-2xl font-semibold tracking-normal mb-2">{c.name}</h2>
          <p class="text-sm leading-6 text-stone-600 mb-4">{c.blurb}</p>
          <p class="kdp-link text-sm">Use Tool -></p>
        </article>
      </a>
    ))}
  </section>

  <section class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">Text checks that fit real workflows</h2>
      <p>
        Word and character limits appear everywhere: essays, article briefs, meta descriptions, social posts, newsletter subject lines, product copy, and speech drafts. The word counter gives a quick read on length, structure, and estimated reading time before you publish or send a draft.
      </p>
    </div>

    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">Privacy and limitations</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li>Text is processed locally in the browser for the active tools.</li>
        <li>Counts are practical estimates; different editors may treat punctuation, emoji, or non-Latin scripts differently.</li>
        <li>Reading time depends on audience, subject complexity, and whether the reader is skimming or studying.</li>
        <li>Placeholder copy should be replaced before launch so real claims, legal language, and calls to action can be reviewed.</li>
      </ul>
    </div>
  </section>

  <section class="mt-12 pt-8 border-t border-[#e6d9c8]">
    <h2 class="kdp-section-label mb-3">About this site</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li><a href="/about/" class="text-violet-600 hover:underline">About</a></li>
      <li><a href="/privacy/" class="text-violet-600 hover:underline">Privacy</a></li>
      <li><a href="/terms/" class="text-violet-600 hover:underline">Terms</a></li>
      <li><a href="/contact/" class="text-violet-600 hover:underline">Contact</a></li>
    </ul>
  </section>

</BaseLayout>
