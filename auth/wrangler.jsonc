{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kdp-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "auth.kdp.cool", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_ORIGIN": "https://auth.kdp.cool",
    "SSO_EXTRA_REDIRECT_URIS": "{\"gu\":[\"https://gu.kdp.cool/api/auth/callback\"]}"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "kdp-auth",
    "database_id": "2a208e2f-50b5-48be-8cbb-a2893e63c658",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 3 * * *"] }
}
