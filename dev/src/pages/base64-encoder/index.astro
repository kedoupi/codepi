---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'Base64 Encoder & Decoder - Free Online URL-Safe Base64 Tool';
const description = 'Encode and decode Base64 in your browser. Supports text, files, and URL-safe variant. UTF-8 round-trip safe. Free, fast, no signup.';

const faqs = [
  {
    q: 'Is Base64 encryption?',
    a: 'No. Base64 is reversible text encoding, not encryption. Anyone who has the encoded string can decode it.',
  },
  {
    q: 'Why is the output larger than the input?',
    a: 'Base64 packs three input bytes into four text characters, so the encoded output is usually about 33% larger before line wrapping or metadata.',
  },
  {
    q: 'Are uploaded files sent to a server?',
    a: 'No. File encoding uses the browser File API and runs locally on your device.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/base64-encoder/">
  <CalculatorShell
    title="Base64 Encoder / Decoder"
    intro="Encode any text or file to Base64, or decode a Base64 string back to text. UTF-8 round-trip safe. URL-safe variant supported. Everything runs in your browser — files never leave your device."
  >
    <AdSense slot="top-ad" adSlot="b64-top" style="min-height:90px" />

    <div slot="inputs" class="space-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <label class="text-sm font-medium text-slate-700">Mode</label>
        <label class="inline-flex items-center text-sm">
          <input type="radio" name="b64-mode" value="encode" class="mr-1.5" checked /> Encode
        </label>
        <label class="inline-flex items-center text-sm">
          <input type="radio" name="b64-mode" value="decode" class="mr-1.5" /> Decode
        </label>
        <label class="inline-flex items-center text-sm ml-2">
          <input type="checkbox" id="b64-urlsafe" class="mr-1.5" /> URL-safe
        </label>
      </div>

      <label for="b64-input" class="block text-sm font-medium text-slate-700">Input</label>
      <textarea id="b64-input" rows="10" spellcheck="false" placeholder="Type text to encode, or paste Base64 to decode..."
                class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-orange-500 font-mono text-sm leading-relaxed resize-y"></textarea>

      <div class="border-t border-slate-200 pt-3">
        <label for="b64-file" class="block text-sm font-medium text-slate-700 mb-1">…or upload a file to encode</label>
        <input id="b64-file" type="file" class="block w-full text-sm text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:bg-orange-600 file:text-white file:text-sm file:font-medium hover:file:bg-orange-700" />
        <p id="b64-file-info" class="text-xs text-slate-500 mt-1">Encodes file bytes to Base64. Output appears in the right panel.</p>
      </div>

      <div class="flex items-center justify-between">
        <button type="button" id="b64-clear" class="text-sm text-slate-500 hover:text-slate-700">Clear</button>
        <button type="button" id="b64-swap" class="text-sm text-orange-600 hover:text-orange-700 font-medium">Swap input ⇄ output</button>
      </div>
    </div>

    <div slot="results" class="space-y-3">
      <div id="b64-status" class="rounded border px-3 py-2 text-sm font-medium border-emerald-200 bg-emerald-50 text-emerald-800">Ready</div>
      <div class="grid grid-cols-2 gap-2">
        <div class="rounded-lg border border-slate-200 p-3 bg-white">
          <p class="text-xs uppercase tracking-wider text-slate-500">Input bytes</p>
          <p id="b64-in-bytes" class="text-xl font-bold tabular-nums">0</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-3 bg-white">
          <p class="text-xs uppercase tracking-wider text-slate-500">Output bytes</p>
          <p id="b64-out-bytes" class="text-xl font-bold tabular-nums">0</p>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <label for="b64-output" class="text-sm font-medium text-slate-700">Output</label>
        <div class="flex items-center gap-3">
          <span id="b64-copy-status" class="text-xs text-emerald-600 hidden">Copied!</span>
          <button type="button" id="b64-copy" class="text-sm text-orange-600 hover:text-orange-700 font-medium">Copy</button>
        </div>
      </div>
      <textarea id="b64-output" rows="14" readonly spellcheck="false"
                class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm leading-relaxed resize-y bg-white"></textarea>
    </div>

    <AdSense slot="middle-ad" adSlot="b64-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">How Base64 works</h2>
      <p class="mb-3">Base64 turns arbitrary bytes into a 64-character ASCII alphabet — <code>A–Z</code>, <code>a–z</code>, <code>0–9</code>, <code>+</code>, and <code>/</code> — by packing three input bytes (24 bits) into four output characters (6 bits each). Every encoded output is roughly 4/3 the size of the input, padded with one or two <code>=</code> signs so the total length is a multiple of 4.</p>
      <p class="mb-3">It's not encryption — anyone can decode it. The point is to safely transmit binary data through systems that only handle text: email bodies (MIME), <code>data:</code> URIs, JSON strings, basic-auth headers, JWT segments, cookies, etc.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">URL-safe Base64</h3>
      <p class="mb-3">Standard Base64 uses <code>+</code> and <code>/</code>, which have special meanings in URLs. The URL-safe variant (RFC 4648 §5) replaces them with <code>-</code> and <code>_</code> respectively, and usually drops the trailing <code>=</code> padding. JWTs use this variant: each header / payload / signature segment is URL-safe Base64 with no padding. Toggle <em>URL-safe</em> on the left to switch.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">UTF-8 round-trip safety</h3>
      <p class="mb-3">JavaScript's built-in <code>btoa()</code> / <code>atob()</code> only handle Latin-1 — they choke on emoji, Chinese, Cyrillic, etc. This tool wraps them with <code>encodeURIComponent</code> + <code>unescape</code> on encode, and the inverse on decode, so any UTF-8 string round-trips correctly: <code>"Hello 世界 🌍"</code> → <code>"SGVsbG8g5LiW55WMIPCfjI0="</code> → <code>"Hello 世界 🌍"</code>. File uploads encode the raw bytes as-is via <code>FileReader.readAsArrayBuffer</code> — no UTF-8 reinterpretation, so binaries (PNG, PDF, ZIP) survive a round trip unchanged.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Common uses</h3>
      <ul class="list-disc pl-6 space-y-1 mb-3">
        <li><strong>data: URIs</strong> — <code>data:image/png;base64,iVBORw0…</code> embeds a small image directly in HTML or CSS without a separate request.</li>
        <li><strong>HTTP basic auth</strong> — <code>Authorization: Basic dXNlcjpwYXNz</code> is just <code>user:pass</code> Base64-encoded (always use HTTPS — Base64 is not a secret).</li>
        <li><strong>JWT</strong> — header.payload.signature, each segment URL-safe Base64.</li>
        <li><strong>API tokens / signed cookies</strong> — making opaque blobs cookie- and URL-safe.</li>
        <li><strong>Email attachments</strong> — MIME wraps binary parts in Base64 with line breaks every 76 characters.</li>
      </ul>
      <p class="mb-3">Use this tool to: decode a JWT payload, inspect a <code>data:</code> URI, prepare a basic-auth header, or just see what your file looks like in Base64.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Limitations and source</h3>
      <p class="mb-3">Base64 is defined in RFC 4648. This page supports the standard alphabet and the URL-safe alphabet from section 5. It does not encrypt, sign, compress, virus-scan, or validate what the decoded bytes mean.</p>
      <p class="mb-3">Large files may use significant browser memory because the encoded result has to be displayed as text. For very large binaries, use a local command-line tool instead.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. Text and file processing happen in the browser; uploaded files are not sent to a server.</p>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

    <AdSense slot="bottom-ad" adSlot="b64-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    const $input = document.getElementById('b64-input') as HTMLTextAreaElement;
    const $output = document.getElementById('b64-output') as HTMLTextAreaElement;
    const $file = document.getElementById('b64-file') as HTMLInputElement;
    const $fileInfo = document.getElementById('b64-file-info') as HTMLElement;
    const $urlsafe = document.getElementById('b64-urlsafe') as HTMLInputElement;
    const $status = document.getElementById('b64-status') as HTMLDivElement;
    const $inBytes = document.getElementById('b64-in-bytes') as HTMLElement;
    const $outBytes = document.getElementById('b64-out-bytes') as HTMLElement;
    const $clear = document.getElementById('b64-clear') as HTMLButtonElement;
    const $swap = document.getElementById('b64-swap') as HTMLButtonElement;
    const $copy = document.getElementById('b64-copy') as HTMLButtonElement;
    const $copyStatus = document.getElementById('b64-copy-status') as HTMLElement;

    function setOk(msg: string) {
      $status.textContent = msg;
      $status.className = 'rounded border px-3 py-2 text-sm font-medium border-emerald-200 bg-emerald-50 text-emerald-800';
    }
    function setErr(msg: string) {
      $status.textContent = msg;
      $status.className = 'rounded border px-3 py-2 text-sm font-medium border-red-200 bg-red-50 text-red-800';
    }

    function utf8Bytes(s: string): number {
      return new TextEncoder().encode(s).length;
    }

    function getMode(): 'encode' | 'decode' {
      const checked = document.querySelector<HTMLInputElement>('input[name="b64-mode"]:checked');
      return (checked?.value as 'encode' | 'decode') ?? 'encode';
    }

    function toUrlSafe(b64: string): string {
      return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
    }

    function fromUrlSafe(b64: string): string {
      let s = b64.replace(/-/g, '+').replace(/_/g, '/');
      // Restore padding to multiple of 4
      const pad = s.length % 4;
      if (pad === 2) s += '==';
      else if (pad === 3) s += '=';
      else if (pad === 1) throw new Error('Invalid Base64 length');
      return s;
    }

    function encodeText(text: string): string {
      // UTF-8 safe: encodeURIComponent escapes multi-byte sequences,
      // unescape decodes the %XX back to a Latin-1-compatible string for btoa.
      const b64 = btoa(unescape(encodeURIComponent(text)));
      return $urlsafe.checked ? toUrlSafe(b64) : b64;
    }

    function decodeText(b64: string): string {
      const cleaned = b64.replace(/\s+/g, '');
      const std = $urlsafe.checked || /[-_]/.test(cleaned) ? fromUrlSafe(cleaned) : cleaned;
      return decodeURIComponent(escape(atob(std)));
    }

    function update() {
      const mode = getMode();
      const text = $input.value;
      $inBytes.textContent = utf8Bytes(text).toLocaleString();
      if (!text) {
        $output.value = '';
        $outBytes.textContent = '0';
        setOk(mode === 'encode' ? 'Ready to encode' : 'Ready to decode');
        return;
      }
      try {
        const out = mode === 'encode' ? encodeText(text) : decodeText(text);
        $output.value = out;
        $outBytes.textContent = utf8Bytes(out).toLocaleString();
        setOk(mode === 'encode' ? 'Encoded' : 'Decoded');
      } catch (e) {
        const err = e as Error;
        $output.value = '';
        $outBytes.textContent = '0';
        setErr(`${mode === 'encode' ? 'Encode' : 'Decode'} error: ${err.message || 'invalid input'}`);
      }
    }

    function bytesToBase64(bytes: Uint8Array): string {
      // Build a binary string in chunks to avoid blowing the call stack.
      let bin = '';
      const CHUNK = 0x8000;
      for (let i = 0; i < bytes.length; i += CHUNK) {
        bin += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
      }
      const b64 = btoa(bin);
      return $urlsafe.checked ? toUrlSafe(b64) : b64;
    }

    $input.addEventListener('input', update);
    document.querySelectorAll<HTMLInputElement>('input[name="b64-mode"]').forEach((r) => r.addEventListener('change', update));
    $urlsafe.addEventListener('change', update);

    $file.addEventListener('change', async () => {
      const f = $file.files?.[0];
      if (!f) return;
      $fileInfo.textContent = `Encoding ${f.name} (${f.size.toLocaleString()} bytes)…`;
      try {
        const buf = await f.arrayBuffer();
        const bytes = new Uint8Array(buf);
        const b64 = bytesToBase64(bytes);
        // Switch to encode mode and put the file Base64 in the output, leave input untouched
        const encRadio = document.querySelector<HTMLInputElement>('input[name="b64-mode"][value="encode"]');
        if (encRadio) encRadio.checked = true;
        $output.value = b64;
        $outBytes.textContent = utf8Bytes(b64).toLocaleString();
        $inBytes.textContent = bytes.length.toLocaleString();
        setOk(`Encoded ${f.name} (${bytes.length.toLocaleString()} bytes → ${b64.length.toLocaleString()} chars)`);
        $fileInfo.textContent = `Encoded ${f.name} — ${bytes.length.toLocaleString()} bytes input.`;
      } catch (e) {
        const err = e as Error;
        setErr(`File encode error: ${err.message}`);
        $fileInfo.textContent = 'Encodes file bytes to Base64. Output appears in the right panel.';
      }
    });

    $clear.addEventListener('click', () => {
      $input.value = '';
      $file.value = '';
      $fileInfo.textContent = 'Encodes file bytes to Base64. Output appears in the right panel.';
      update();
      $input.focus();
    });

    $swap.addEventListener('click', () => {
      const out = $output.value;
      $input.value = out;
      // Toggle mode
      const enc = document.querySelector<HTMLInputElement>('input[name="b64-mode"][value="encode"]')!;
      const dec = document.querySelector<HTMLInputElement>('input[name="b64-mode"][value="decode"]')!;
      if (enc.checked) { dec.checked = true; } else { enc.checked = true; }
      update();
    });

    $copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText($output.value);
        $copyStatus.classList.remove('hidden');
        setTimeout(() => $copyStatus.classList.add('hidden'), 1500);
      } catch (e) {
        $output.select();
        document.execCommand('copy');
        $copyStatus.classList.remove('hidden');
        setTimeout(() => $copyStatus.classList.add('hidden'), 1500);
      }
    });

    update();
  </script>
</BaseLayout>
