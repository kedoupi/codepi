---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import FaqSection from '../../components/FaqSection.astro';

const title = 'Auto Loan Calculator - Free Car Payment Estimator';
const description = 'Calculate your auto loan monthly payment instantly. Enter vehicle price, down payment, trade-in, sales tax, APR and term. Free car loan calculator for US buyers.';

const faqs = [
  {
    q: 'What formula does this auto loan calculator use?',
    a: 'The same fully amortizing installment formula as the mortgage calculator: M = P · [r(1+r)^n] / [(1+r)^n − 1], where P is the amount financed, r is APR ÷ 12, and n is the term in months. On the default loan, P is $32,450, r is 7.5% / 12, n is 60, and M is $650.23.',
  },
  {
    q: 'How is the amount financed calculated?',
    a: 'Principal = vehicle price − down payment − trade-in + sales tax. Sales tax is vehicle price × the tax rate you type. Defaults: $35,000 − $5,000 − $0 + ($35,000 × 7%) = $32,450. The $2,450 of tax is rolled into the loan in this model; some buyers pay tax in cash at the dealer instead.',
  },
  {
    q: 'Does a trade-in reduce sales tax in this calculator?',
    a: 'No. This is a simple nationwide sketch: tax is always computed on the full vehicle price. Some states (including California and New York, for many private-party or dealer trades) reduce the taxable basis by a qualifying trade-in. Others tax the full price. An $8,000 trade-in here lowers principal from $32,450 to $24,450 and the payment from $650.23 to $489.93, but the $2,450 tax line does not move. Check your DMV worksheet for the local rule.',
  },
  {
    q: 'How much does a longer term cost on the default car?',
    a: 'Same $32,450 principal at 7.5% APR: 36 months is $1,009.40 / month and about $3,888 of interest; 60 months is $650.23 / month and about $6,564 of interest; 72 months is $561.06 / month and about $7,947 of interest. Stretching from 36 to 72 months cuts the payment by about $448 and adds about $4,058 of interest.',
  },
  {
    q: 'Are title, documentation, and dealer fees included?',
    a: 'No. Title, registration, documentation fees, destination charges already in the sticker, extended warranties, GAP, paint protection, and dealer add-ons are out of scope unless you raise the vehicle price to include them. Those fees can add hundreds to thousands of dollars and sometimes are taxed.',
  },
  {
    q: 'What if I have negative equity on a trade-in?',
    a: 'If you still owe more than the car is worth, the unpaid balance is often rolled into the new loan. This form only subtracts a positive trade-in value. It does not add leftover payoff. If you owe $12,000 on a car worth $8,000, the $4,000 of negative equity is extra principal this page will not invent.',
  },
  {
    q: 'Is the APR I type the same as the dealer’s “zero down” ad rate?',
    a: 'Not necessarily. Advertised rates are often tiered by credit, require a down payment, or exclude add-on products. This calculator uses the APR you enter as the monthly amortizing rate. It does not compute a money-factor lease, a balloon residual, or a buy-here-pay-here schedule.',
  },
  {
    q: 'Does this work for a lease?',
    a: 'No. A lease payment is depreciation + rent charge + fees, not this principal-and-interest formula. Residual value and money factor are out of scope.',
  },
  {
    q: 'Should I pay cash or finance?',
    a: 'This page prices the loan. It does not decide for you. A useful comparison is the interest you will pay here versus what the same down-payment cash could earn. On the default 60-month loan, interest is about $6,564. The compound-interest calculator can show the opportunity cost of that cash if you invest it instead — with the usual caveat that a 7% market return is not a guarantee and is pre-tax.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/auto-loan-calculator/">
  <CalculatorShell
    title="Auto Loan Calculator"
    intro="Estimate your monthly car payment, total interest, and out-the-door cost. Includes sales tax on the vehicle price."
  >

    <form id="al-form" class="space-y-5" slot="inputs" autocomplete="off">
      <div>
        <label for="al-price" class="block text-sm font-medium text-slate-700 mb-1">Vehicle Price</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">$</span>
          <input id="al-price" name="vehiclePrice" type="number" min="0" step="500" value="35000"
                 class="w-full pl-7 pr-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="al-down" class="block text-sm font-medium text-slate-700 mb-1">Down Payment</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">$</span>
            <input id="al-down" type="number" min="0" step="500" value="5000"
                   class="w-full pl-7 pr-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
        <div>
          <label for="al-trade" class="block text-sm font-medium text-slate-700 mb-1">Trade-in Value</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">$</span>
            <input id="al-trade" type="number" min="0" step="500" value="0"
                   class="w-full pl-7 pr-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700 mb-1">Loan Term</span>
        <div class="grid grid-cols-5 gap-2">
          <button type="button" data-term="36" class="al-term-btn py-2 rounded border border-slate-300 bg-white text-sm">36 mo</button>
          <button type="button" data-term="48" class="al-term-btn py-2 rounded border border-slate-300 bg-white text-sm">48 mo</button>
          <button type="button" data-term="60" class="al-term-btn py-2 rounded border-blue-600 bg-blue-600 text-white text-sm">60 mo</button>
          <button type="button" data-term="72" class="al-term-btn py-2 rounded border border-slate-300 bg-white text-sm">72 mo</button>
          <button type="button" data-term="84" class="al-term-btn py-2 rounded border border-slate-300 bg-white text-sm">84 mo</button>
        </div>
        <input type="hidden" id="al-term" value="60" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="al-rate" class="block text-sm font-medium text-slate-700 mb-1">APR</label>
          <div class="relative">
            <input id="al-rate" type="number" min="0" step="0.01" value="7.5"
                   class="w-full pr-7 pl-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">%</span>
          </div>
        </div>
        <div>
          <label for="al-tax" class="block text-sm font-medium text-slate-700 mb-1">Sales Tax</label>
          <div class="relative">
            <input id="al-tax" type="number" min="0" step="0.1" value="7"
                   class="w-full pr-7 pl-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">%</span>
          </div>
        </div>
      </div>
    </form>

    <div slot="results" class="space-y-5">
      <div>
        <p class="text-sm uppercase tracking-wider text-slate-500">Monthly Payment</p>
        <p id="al-r-monthly" class="text-4xl sm:text-5xl font-bold text-slate-900 tabular-nums">$0</p>
      </div>

      <div class="flex items-center gap-5">
        <svg id="al-chart" viewBox="0 0 100 100" class="w-32 h-32 shrink-0" aria-label="Cost breakdown"></svg>
        <ul class="text-sm space-y-1.5 flex-1">
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-blue-600 inline-block"></i>Principal</span>
            <span id="al-r-principal" class="tabular-nums font-medium">$0</span>
          </li>
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-amber-500 inline-block"></i>Total Interest</span>
            <span id="al-r-interest" class="tabular-nums font-medium">$0</span>
          </li>
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-emerald-500 inline-block"></i>Sales Tax</span>
            <span id="al-r-tax" class="tabular-nums font-medium">$0</span>
          </li>
          <li class="flex items-center justify-between gap-3 border-t border-slate-200 pt-2 mt-2">
            <span class="font-semibold">Total Cost (price + interest + tax)</span>
            <span id="al-r-total" class="tabular-nums font-semibold">$0</span>
          </li>
        </ul>
      </div>
    </div>


    <div slot="content">
      <p class="mb-6 text-sm text-slate-600 border border-slate-200 bg-slate-50 rounded p-3">
        Educational estimate only. This is not a dealer buy sheet, a credit-union quote, or a state DMV tax worksheet. Sales tax here is a simple percentage of vehicle price.
      </p>

      <h2 class="text-2xl font-bold mb-3">Who this is for</h2>
      <p class="mb-3">Use this page when you are comparing a vehicle price, down payment, trade-in, APR, or term and want a transparent monthly payment plus lifetime interest. The decision it helps is “what does financing this car cost each month, and how much extra do I pay to stretch the term?” It is for a US-style installment auto loan. It is not a lease, a balloon residual, or a buy-here-pay-here schedule.</p>

      <h2 class="text-2xl font-bold mb-3 mt-8">How this auto loan calculator works</h2>
      <p class="mb-3">The amount financed is:</p>
      <p class="mb-3 font-mono text-sm bg-slate-100 inline-block px-3 py-1.5 rounded">Principal = Vehicle Price − Down Payment − Trade-in + (Vehicle Price × Sales Tax %)</p>
      <p class="mb-3">Monthly payment then uses the standard amortizing formula <em>M = P · [r(1+r)<sup>n</sup>] / [(1+r)<sup>n</sup> − 1]</em>, with <em>r</em> = APR / 12 and <em>n</em> = term in months — the same helper as the mortgage calculator. If APR is 0%, <em>M</em> is <em>P / n</em>.</p>
      <p>Sales tax is a simple model: it always taxes the full vehicle price. It does not apply state-specific trade-in credits, destination-charge rules, or municipal add-ons. Title, registration, documentation fees, GAP, and dealer add-ons are not included unless you raise the price to fold them in.</p>

      <h2 class="text-2xl font-bold mb-3 mt-8">Worked example (form defaults, no JavaScript required)</h2>
      <p class="mb-3">Vehicle $35,000, down $5,000, trade-in $0, sales tax 7%, APR 7.5%, 60 months.</p>
      <ul class="list-disc list-inside space-y-1 mb-3">
        <li>Sales tax = $35,000 × 7% = <strong>$2,450</strong></li>
        <li>Principal = $35,000 − $5,000 − $0 + $2,450 = <strong>$32,450</strong></li>
        <li>Monthly rate = 7.5% / 12 = 0.625%</li>
        <li>Payment <em>M</em> = <strong>$650.23</strong></li>
        <li>Total interest = $650.23 × 60 − $32,450 = <strong>$6,563.89</strong></li>
        <li>Total cost (price + interest + tax) = $35,000 + $6,563.89 + $2,450 = <strong>$44,013.89</strong></li>
      </ul>
      <div class="my-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-sm text-left">
          <caption class="sr-only">Static auto-loan example matching the calculator defaults</caption>
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 font-semibold">Item</th>
              <th class="px-3 py-2 font-semibold">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Vehicle price</td><td class="px-3 py-2 tabular-nums">$35,000.00</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Down payment</td><td class="px-3 py-2 tabular-nums">$5,000.00</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Sales tax (7% of price)</td><td class="px-3 py-2 tabular-nums">$2,450.00</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Amount financed</td><td class="px-3 py-2 tabular-nums">$32,450.00</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Monthly payment (60 mo)</td><td class="px-3 py-2 tabular-nums">$650.23</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Total interest</td><td class="px-3 py-2 tabular-nums">$6,563.89</td></tr>
            <tr class="border-t border-slate-200 font-semibold"><td class="px-3 py-2">Price + interest + tax</td><td class="px-3 py-2 tabular-nums">$44,013.89</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold mb-2 mt-6">Same car, $8,000 trade-in — tax still on full price</h3>
      <p class="mb-3">Principal becomes $35,000 − $5,000 − $8,000 + $2,450 = <strong>$24,450</strong>. Payment falls to <strong>$489.93</strong> and interest to about <strong>$4,946</strong>. The tax line stays <strong>$2,450</strong> because this model does not give a trade-in tax credit. If your state taxes only the difference after trade-in, the live total here is high on the tax line.</p>

      <h3 class="text-xl font-semibold mb-2 mt-6">Term comparison on the default principal</h3>
      <div class="my-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-sm text-left">
          <caption class="sr-only">36-, 60-, and 72-month comparison for the default auto loan</caption>
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 font-semibold">Term</th>
              <th class="px-3 py-2 font-semibold">Monthly</th>
              <th class="px-3 py-2 font-semibold">Total interest</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">36 months</td><td class="px-3 py-2 tabular-nums">$1,009.40</td><td class="px-3 py-2 tabular-nums">$3,888.28</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">60 months (default)</td><td class="px-3 py-2 tabular-nums">$650.23</td><td class="px-3 py-2 tabular-nums">$6,563.89</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">72 months</td><td class="px-3 py-2 tabular-nums">$561.06</td><td class="px-3 py-2 tabular-nums">$7,946.62</td></tr>
          </tbody>
        </table>
      </div>

      <details class="mt-6 group">
        <summary class="cursor-pointer text-sm font-medium text-blue-700 hover:text-blue-800">Show the math</summary>
        <div id="al-show-math" class="mt-3 text-sm text-slate-700 leading-relaxed bg-slate-50 border border-slate-200 rounded p-4 font-mono">
          Sales Tax = $35,000 × 7% = $2450.00<br />
          Principal = $35,000 − $5,000 − $0 + $2450.00 = $32450.00<br />
          r (monthly) = 7.5% ÷ 12 = 0.6250%<br />
          n = 60<br />
          M = P · [r(1+r)<sup>n</sup>] / [(1+r)<sup>n</sup> − 1] = <strong>$650.23</strong><br />
          Total Interest = M × n − P = $6563.89<br />
          <strong>Total Cost = price + interest + tax = $44013.89</strong>
        </div>
      </details>

      <h2 class="text-2xl font-bold mb-3 mt-8">Assumptions and limitations</h2>
      <ul class="list-disc list-inside space-y-2 mb-3">
        <li>Fixed APR, fully amortizing, monthly payments. No leases, balloons, or skip-a-payment products.</li>
        <li>Sales tax is a flat percent of vehicle price. No trade-in tax credit, no municipal add-on, no tax on fees unless you raise the price.</li>
        <li>Trade-in is a positive credit only. Negative equity / leftover payoff is not added to principal.</li>
        <li>No title, registration, documentation, destination, GAP, warranty, or dealer-product fees.</li>
        <li>No credit-tier pricing, prepaid finance charges, or dealer reserve. The APR you type is the amortizing rate.</li>
        <li>Total cost is defined here as vehicle price + interest + sales tax (you still own the car). It is not cash-to-leave-the-lot.</li>
      </ul>

      <h2 class="text-2xl font-bold mb-3 mt-8">Sources and data vintage</h2>
      <p class="mb-3">Payment equation: standard fully amortizing installment formula, same as the CFPB’s description of a level principal-and-interest payment on a fixed-rate installment loan. We do not treat it as a vehicle-finance statute. Sales-tax treatment is an intentional simplification; state departments of motor vehicles publish the taxable-basis rules that actually apply at registration.</p>
      <p>The numeric example uses the calculator’s shipped defaults (reviewed <strong>2026-09-16</strong>). The 7% tax and 7.5% APR are planning inputs, not a 2026 national average.</p>

      <FaqSection
        faqs={faqs}
        related={[
          { href: '/mortgage-calculator/', label: 'Mortgage Calculator', note: 'the same amortizing formula on a much longer term.' },
          { href: '/paycheck-calculator/', label: 'Paycheck Calculator', note: 'see whether the payment fits estimated take-home pay.' },
          { href: '/compound-interest-calculator/', label: 'Compound Interest Calculator', note: 'opportunity cost of a larger down payment or of paying cash.' },
          { href: 'https://kdp.cool/guides/how-monthly-mortgage-payments-are-calculated/', label: 'Guide: how amortizing payments are calculated', note: 'the long-form walkthrough of the shared installment formula.', external: true },
        ]}
      />
    </div>

  </CalculatorShell>

  <script>
    import { calcAutoLoan } from '../../lib/auto-loan.js';
    import { renderPie } from '@shared/lib/charts.js';
    import { decodeState, pushUrlState } from '@shared/lib/url-state.js';

    const fmt = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    const DEFAULTS = { price: 35000, down: 5000, trade: 0, term: 60, rate: 7.5, tax: 7 };
    const init = decodeState(window.location.search, DEFAULTS);

    const $price = document.getElementById('al-price');
    const $down  = document.getElementById('al-down');
    const $trade = document.getElementById('al-trade');
    const $rate  = document.getElementById('al-rate');
    const $tax   = document.getElementById('al-tax');
    const $term  = document.getElementById('al-term');

    $price.value = String(init.price);
    $down.value  = String(init.down);
    $trade.value = String(init.trade);
    $rate.value  = String(init.rate);
    $tax.value   = String(init.tax);
    $term.value  = String(init.term);

    document.querySelectorAll('.al-term-btn').forEach((b) => {
      const active = String(b.dataset.term) === String(init.term);
      b.classList.toggle('bg-blue-600', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('border-blue-600', active);
      b.classList.toggle('bg-white', !active);
      b.classList.toggle('border-slate-300', !active);
      b.addEventListener('click', () => {
        document.querySelectorAll('.al-term-btn').forEach((x) => {
          x.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
          x.classList.add('bg-white', 'border-slate-300');
        });
        b.classList.remove('bg-white', 'border-slate-300');
        b.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
        $term.value = b.dataset.term;
        update();
      });
    });

    let urlTimer;
    function syncUrl() {
      clearTimeout(urlTimer);
      urlTimer = setTimeout(() => pushUrlState({
        price: +$price.value || 0, down: +$down.value || 0, trade: +$trade.value || 0,
        term: +$term.value || 60, rate: +$rate.value || 0, tax: +$tax.value || 0,
      }), 250);
    }

    function update() {
      const inputs = {
        vehiclePrice: +$price.value || 0,
        downPayment:  +$down.value  || 0,
        tradeIn:      +$trade.value || 0,
        salesTaxPct:  +$tax.value   || 0,
        annualRatePct: +$rate.value || 0,
        termMonths:   +$term.value  || 60,
      };
      const r = calcAutoLoan(inputs);
      document.getElementById('al-r-monthly').textContent = fmt(r.monthlyPayment);
      document.getElementById('al-r-principal').textContent = fmt(r.principal);
      document.getElementById('al-r-interest').textContent = fmt(r.totalInterest);
      document.getElementById('al-r-tax').textContent = fmt(r.salesTax);
      document.getElementById('al-r-total').textContent = fmt(r.totalCost);
      renderPie(document.getElementById('al-chart'), [
        { value: r.principal,     color: '#2563eb', label: 'Principal' },
        { value: r.totalInterest, color: '#f59e0b', label: 'Interest' },
        { value: r.salesTax,      color: '#10b981', label: 'Sales Tax' },
      ]);
      const monthlyR = inputs.annualRatePct / 100 / 12;
      document.getElementById('al-show-math').innerHTML = `
Sales Tax = $${inputs.vehiclePrice.toLocaleString()} × ${inputs.salesTaxPct}% = $${r.salesTax.toFixed(2)}<br>
Principal = $${inputs.vehiclePrice.toLocaleString()} − $${inputs.downPayment.toLocaleString()} − $${inputs.tradeIn.toLocaleString()} + $${r.salesTax.toFixed(2)} = $${r.principal.toFixed(2)}<br>
r (monthly) = ${inputs.annualRatePct}% ÷ 12 = ${(monthlyR * 100).toFixed(4)}%<br>
n = ${inputs.termMonths}<br>
M = P · [r(1+r)<sup>n</sup>] / [(1+r)<sup>n</sup> − 1] = <strong>$${r.monthlyPayment.toFixed(2)}</strong><br>
Total Interest = M × n − P = $${r.totalInterest.toFixed(2)}<br>
<strong>Total Cost = price + interest + tax = $${r.totalCost.toFixed(2)}</strong>
      `.trim();
      syncUrl();
    }

    document.getElementById('al-form').addEventListener('input', update);
    update();
  </script>
</BaseLayout>
