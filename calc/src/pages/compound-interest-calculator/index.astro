---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';
import FaqSection from '../../components/FaqSection.astro';

const title = 'Compound Interest Calculator - Investment Growth';
const description = 'See how your investments grow with compound interest. Enter initial deposit, monthly contribution, rate and years. Free compound interest calculator with year-by-year chart.';

const faqs = [
  {
    q: 'What formula does this compound interest calculator use?',
    a: 'The closed-form lump-sum relation is A = P(1 + r/n)^(n t), where P is the starting balance, r is the annual rate as a decimal, n is compounds per year, and t is years. With monthly contributions, this page instead grows the balance month by month: each month the balance is multiplied by (1 + r/n)^(n/12) and then the contribution is added. That produces the year-by-year chart and matches the closed form when the contribution is $0.',
  },
  {
    q: 'How much does compounding frequency change a $10,000 lump sum at 7% for 10 years?',
    a: 'With no ongoing contributions: annual compounding ends at $19,671.51; quarterly at $20,015.97; monthly at $20,096.61; daily (365) at $20,136.18. Monthly versus annual is about $425 extra. Daily versus monthly is only about $40. Frequency matters; it rarely dwarfs the rate or the contribution.',
  },
  {
    q: 'What do the default inputs grow to?',
    a: '$10,000 start + $500 per month at 7% for 30 years, compounded monthly, ends at about $691,150. You contributed $190,000 ($10,000 + $500 × 360). Interest earned is about $501,150. After 10 years the balance is only about $106,639 — most of the total appears in the later years.',
  },
  {
    q: 'Does this adjust for inflation?',
    a: 'No. The final balance is a nominal (pre-inflation) dollar figure. If inflation ran 2.5% a year, $691,150 in 30 years would buy less than $691,150 buys today. This page does not compute a real return, a CPI series, or purchasing-power adjustment.',
  },
  {
    q: 'Are taxes included?',
    a: 'No. The rate you type is treated as a full credited rate. A taxable brokerage account may owe tax on dividends and realized gains each year; a traditional 401(k) or IRA is pre-tax going in and taxable coming out; a Roth is after-tax going in and generally tax-free if qualified. None of those drag or deferral effects are modeled. Use the income tax calculator only as a rough sense of today’s ordinary-income bracket, not as a future-withdrawal tax engine.',
  },
  {
    q: 'Is 7% a forecast?',
    a: 'No. 7% is a planning input — a common long-run stock-market illustration after some fee drag, not a promise. Sequence of returns, fees, and withdrawals can produce a very different path with the same average. Past index performance is not a guarantee.',
  },
  {
    q: 'When are monthly contributions added?',
    a: 'At the end of each modeled month, after that month’s growth factor is applied. Changing compound frequency changes the monthly growth factor (1 + r/n)^(n/12); contributions stay monthly. There is no employer match, no raise in the contribution, and no inflation step-up unless you type a larger contribution yourself.',
  },
  {
    q: 'Why is most of the growth in the later years?',
    a: 'Compounding is recursive: interest is earned on a larger and larger base. On the default path, year 1 ends near $16,919 and year 10 near $106,639, while year 30 is about $691,150. Skipping the first decade of contributions hurts more than the same skip in the last decade, because the early dollars have more periods to compound.',
  },
  {
    q: 'Can I use this as a retirement-readiness number?',
    a: 'Only as a sketch. It ignores inflation, taxes, fees, Social Security, required minimum distributions, and sequence-of-returns risk. A target-date fund or an advisor plan will use a richer model. This page answers “if this rate is credited smoothly, what is the ending balance?”',
  },
];
---
<BaseLayout title={title} description={description} pathname="/compound-interest-calculator/">
  <CalculatorShell
    title="Compound Interest Calculator"
    intro="Project your investment growth with regular contributions. See the year-by-year breakdown of contributions vs. interest earned."
  >
    <AdSense slot="top-ad" adSlot="ci-top" style="min-height:90px" />

    <form id="ci-form" class="space-y-5" slot="inputs" autocomplete="off">
      <div>
        <label for="ci-principal" class="block text-sm font-medium text-slate-700 mb-1">Initial Deposit</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">$</span>
          <input id="ci-principal" type="number" min="0" step="500" value="10000"
                 class="w-full pl-7 pr-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>

      <div>
        <label for="ci-contrib" class="block text-sm font-medium text-slate-700 mb-1">Monthly Contribution</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">$</span>
          <input id="ci-contrib" type="number" min="0" step="50" value="500"
                 class="w-full pl-7 pr-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="ci-rate" class="block text-sm font-medium text-slate-700 mb-1">Annual Rate</label>
          <div class="relative">
            <input id="ci-rate" type="number" min="0" step="0.1" value="7"
                   class="w-full pr-7 pl-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">%</span>
          </div>
        </div>
        <div>
          <label for="ci-years" class="block text-sm font-medium text-slate-700 mb-1">Years</label>
          <input id="ci-years" type="number" min="1" max="60" step="1" value="30"
                 class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>

      <div>
        <label for="ci-cpy" class="block text-sm font-medium text-slate-700 mb-1">Compound Frequency</label>
        <select id="ci-cpy" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="365">Daily</option>
          <option value="12" selected>Monthly</option>
          <option value="4">Quarterly</option>
          <option value="1">Annually</option>
        </select>
      </div>
    </form>

    <div slot="results" class="space-y-5">
      <div>
        <p class="text-sm uppercase tracking-wider text-slate-500">Final Balance</p>
        <p id="ci-r-final" class="text-4xl sm:text-5xl font-bold text-slate-900 tabular-nums">$0</p>
      </div>

      <svg id="ci-chart" viewBox="0 0 200 100" preserveAspectRatio="none" class="w-full h-32 bg-slate-50 rounded border border-slate-200"></svg>

      <ul class="text-sm space-y-1.5">
        <li class="flex items-center justify-between gap-3">
          <span>Total Contributed</span>
          <span id="ci-r-contrib" class="tabular-nums font-medium">$0</span>
        </li>
        <li class="flex items-center justify-between gap-3">
          <span>Total Interest Earned</span>
          <span id="ci-r-interest" class="tabular-nums font-medium text-emerald-600">$0</span>
        </li>
      </ul>
    </div>

    <AdSense slot="middle-ad" adSlot="ci-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <p class="mb-6 text-sm text-slate-600 border border-slate-200 bg-slate-50 rounded p-3">
        Educational projection only. The rate you type is a planning assumption, not a forecast. Inflation, taxes, and fees are not subtracted.
      </p>

      <h2 class="text-2xl font-bold mb-3">Who this is for</h2>
      <p class="mb-3">Use this page when you want to see how a starting balance, a monthly contribution, a credited rate, a time horizon, and a compounding frequency combine. The decision it helps is “does raising the contribution or the years change the ending balance more than tweaking the rate?” It is a nominal growth sketch. It is not a retirement-readiness plan, a Monte Carlo, or a tax-lot engine.</p>

      <h2 class="text-2xl font-bold mb-3 mt-8">How compound interest works</h2>
      <p class="mb-3">Compound interest pays interest on interest. Each period, credited earnings are added to the balance, and the next period uses that larger base. For a lump sum with no contributions, the closed form is:</p>
      <p class="mb-3 font-mono text-sm bg-slate-100 inline-block px-3 py-1.5 rounded">A = P(1 + r/n)<sup>nt</sup></p>
      <p class="mb-3">Where <em>P</em> is the starting principal, <em>r</em> is the annual rate as a decimal, <em>n</em> is compounds per year, and <em>t</em> is years. This page also accepts a monthly contribution. Implementation is month-by-month so the chart can show each year: monthly growth factor = (1 + r/n)<sup>n/12</sup>, then add the contribution. When the contribution is $0, that path matches the closed form.</p>
      <p>The year-by-year series is a smooth credited rate. Real markets bounce. Sequence of returns can leave two investors with the same average rate and very different balances if one withdraws along the way.</p>

      <h2 class="text-2xl font-bold mb-3 mt-8">Worked example 1: compounding frequency (no contributions)</h2>
      <p class="mb-3">Start with $10,000, contribute $0, earn 7% for 10 years. These ending balances are static and do not need JavaScript:</p>
      <div class="my-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-sm text-left">
          <caption class="sr-only">$10,000 at 7% for 10 years by compounding frequency</caption>
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 font-semibold">Frequency</th>
              <th class="px-3 py-2 font-semibold">n per year</th>
              <th class="px-3 py-2 font-semibold">Ending balance</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Annually</td><td class="px-3 py-2 tabular-nums">1</td><td class="px-3 py-2 tabular-nums">$19,671.51</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Quarterly</td><td class="px-3 py-2 tabular-nums">4</td><td class="px-3 py-2 tabular-nums">$20,015.97</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Monthly</td><td class="px-3 py-2 tabular-nums">12</td><td class="px-3 py-2 tabular-nums">$20,096.61</td></tr>
            <tr class="border-t border-slate-200"><td class="px-3 py-2">Daily</td><td class="px-3 py-2 tabular-nums">365</td><td class="px-3 py-2 tabular-nums">$20,136.18</td></tr>
          </tbody>
        </table>
      </div>
      <p>Annual compounding: $10,000 × (1.07)<sup>10</sup> = <strong>$19,671.51</strong>. Monthly: $10,000 × (1 + 0.07/12)<sup>120</sup> = <strong>$20,096.61</strong>. Daily versus monthly is about <strong>$40</strong>. Moving from annual to monthly is about <strong>$425</strong>. Frequency is real; it is not the main lever compared with the rate or the contribution.</p>

      <h2 class="text-2xl font-bold mb-3 mt-8">Worked example 2: form defaults with contributions</h2>
      <p class="mb-3">$10,000 start + $500 per month, 7% annual rate, 30 years, compounded monthly.</p>
      <ul class="list-disc list-inside space-y-1 mb-3">
        <li>Total contributed = $10,000 + $500 × 360 = <strong>$190,000</strong></li>
        <li>Year 1 balance ≈ <strong>$16,919</strong></li>
        <li>Year 10 balance ≈ <strong>$106,639</strong></li>
        <li>Year 30 (final) ≈ <strong>$691,150</strong></li>
        <li>Interest earned ≈ <strong>$501,150</strong></li>
      </ul>
      <p>Most of the $691,150 appears after year 10. That is compounding, not a hidden fee. It is also why this number is a poor “I will definitely have this” claim: thirty years of 7% credited smoothly ignore inflation, taxes, and losing years.</p>

      <details class="mt-6 group">
        <summary class="cursor-pointer text-sm font-medium text-blue-700 hover:text-blue-800">Show the math</summary>
        <div id="ci-show-math" class="mt-3 text-sm text-slate-700 leading-relaxed bg-slate-50 border border-slate-200 rounded p-4 font-mono">
          P = $10,000, contribution = $500/mo, r = 7%, n = 12/yr, t = 30 yr<br />
          Monthly growth factor = (1 + 0.0700 / 12)<sup>12/12</sup><br />
          Each month: balance = balance × monthlyGrowth + 500<br />
          Year 1: balance ≈ $16,919.19<br />
          Year 10: balance ≈ $106,639.02<br />
          … Year 30: balance = $691,150.47 ← <strong>Final balance: $691150.47</strong>
        </div>
      </details>

      <h2 class="text-2xl font-bold mb-3 mt-8">Assumptions and limitations</h2>
      <ul class="list-disc list-inside space-y-2 mb-3">
        <li>Nominal (pre-inflation) dollars only. There is no CPI adjustment and no “real return” toggle.</li>
        <li>Pre-tax in the sense that no tax is subtracted. Taxable-account drag, traditional-IRA withdrawals, and Roth basis rules are out of scope.</li>
        <li>No investment fees, bid-ask spread, or fund expense ratio unless you lower the rate yourself to proxy them.</li>
        <li>Contributions are a constant monthly dollar amount. No employer match, no annual raise, no pause.</li>
        <li>The credited rate is smooth. Sequence-of-returns risk and withdrawals are not modeled.</li>
        <li>7% (the default) is an illustration, not a forecast of any index or product.</li>
      </ul>

      <h2 class="text-2xl font-bold mb-3 mt-8">Sources and data vintage</h2>
      <p class="mb-3">The lump-sum equation <em>A = P(1 + r/n)<sup>nt</sup></em> is the standard compound-interest formula taught in introductory finance (periodic compounding). The contribution path is a discrete recurrence, not a statute. There is no IRS table on this page; tax-year 2026 figures live on the income-tax and paycheck tools if you want a sense of today’s ordinary-income bracket.</p>
      <p>Examples reviewed <strong>2026-09-16</strong>. The 7% default is a planning input, not 2026 market data.</p>

      <FaqSection
        faqs={faqs}
        related={[
          { href: '/paycheck-calculator/', label: 'Paycheck Calculator', note: 'estimate how large a monthly contribution take-home pay can support.' },
          { href: '/income-tax-calculator/', label: 'Income Tax Calculator', note: 'today’s ordinary-income bracket — not a future-withdrawal tax engine.' },
          { href: '/auto-loan-calculator/', label: 'Auto Loan Calculator', note: 'compare loan interest with what the same cash might earn if invested.' },
          { href: '/mortgage-calculator/', label: 'Mortgage Calculator', note: 'a larger down payment is cash that is not compounding in a brokerage account.' },
        ]}
      />
    </div>

    <AdSense slot="bottom-ad" adSlot="ci-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    import { calcCompoundInterest } from '../../lib/compound-interest.js';
    import { renderLineChart } from '@shared/lib/charts.js';
    import { decodeState, pushUrlState } from '@shared/lib/url-state.js';

    const fmt = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const DEFAULTS = { principal: 10000, contrib: 500, rate: 7, years: 30, cpy: 12 };
    const init = decodeState(window.location.search, DEFAULTS);

    const $p = document.getElementById('ci-principal');
    const $c = document.getElementById('ci-contrib');
    const $r = document.getElementById('ci-rate');
    const $y = document.getElementById('ci-years');
    const $f = document.getElementById('ci-cpy');

    $p.value = String(init.principal);
    $c.value = String(init.contrib);
    $r.value = String(init.rate);
    $y.value = String(init.years);
    $f.value = String(init.cpy);

    let urlTimer;
    function syncUrl() {
      clearTimeout(urlTimer);
      urlTimer = setTimeout(() => pushUrlState({
        principal: +$p.value || 0, contrib: +$c.value || 0,
        rate: +$r.value || 0, years: +$y.value || 0, cpy: +$f.value || 12,
      }), 250);
    }

    function update() {
      const inputs = {
        principal: +$p.value || 0,
        monthlyContribution: +$c.value || 0,
        annualRatePct: +$r.value || 0,
        years: +$y.value || 0,
        compoundsPerYear: +$f.value || 12,
      };
      const r = calcCompoundInterest(inputs);
      document.getElementById('ci-r-final').textContent = fmt(r.finalAmount);
      document.getElementById('ci-r-contrib').textContent = fmt(r.totalContributed);
      document.getElementById('ci-r-interest').textContent = fmt(r.totalInterest);
      renderLineChart(
        document.getElementById('ci-chart'),
        r.yearByYear.map((y) => ({ x: y.year, y: y.balance })),
        { lineColor: '#2563eb', fillColor: 'rgba(37,99,235,0.15)', xLabels: r.yearByYear.map((y) => `Y${y.year}`) },
      );
      const sample = r.yearByYear.slice(0, 3).map((y) => `Year ${y.year}: balance = $${y.balance.toFixed(2)} (interest so far: $${y.totalInterest.toFixed(2)})`).join('<br>');
      const last = r.yearByYear.length ? `Year ${r.yearByYear.at(-1).year}: balance = $${r.yearByYear.at(-1).balance.toFixed(2)}` : '';
      document.getElementById('ci-show-math').innerHTML = `
P = $${inputs.principal.toLocaleString()}, contribution = $${inputs.monthlyContribution}/mo, r = ${inputs.annualRatePct}%, n = ${inputs.compoundsPerYear}/yr, t = ${inputs.years} yr<br>
Monthly growth factor = (1 + ${(inputs.annualRatePct / 100).toFixed(4)} / ${inputs.compoundsPerYear})<sup>${inputs.compoundsPerYear}/12</sup><br>
Each month: balance = balance × monthlyGrowth + ${inputs.monthlyContribution}<br>
${sample}<br>
… ${last} ← <strong>Final balance: $${r.finalAmount.toFixed(2)}</strong>
      `.trim();
      syncUrl();
    }

    document.getElementById('ci-form').addEventListener('input', update);
    update();
  </script>
</BaseLayout>
