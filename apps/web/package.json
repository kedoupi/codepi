{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "pnpm --dir ../../services/auth run build && node --test test/*.test.mjs",
    "typecheck:desk": "node ../../services/auth/node_modules/typescript/bin/tsc -p tsconfig.desk.json && node ../../services/auth/node_modules/typescript/bin/tsc -p tsconfig.desk-web.json",
    "test:assets": "node --test scripts/assets.test.mjs",
    "test:browser:desk": "node scripts/browser-desk.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.3.0",
    "marked": "^18.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^6.0.2",
    "@kedoupi/shared": "workspace:*",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  }
}
