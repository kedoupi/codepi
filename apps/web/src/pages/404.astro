---
import BaseLayout from '@kedoupi/shared/layouts/BaseLayout.astro';
---
<BaseLayout
  title="404"
  description="这个页面已经不在 kedoupi（codepi）的个人数字空间里了。"
  pathname="/404/"
  schemaType="WebPage"
  robots="noindex, follow"
>
  <div class="brand-page brand-404">
    <section class="brand-hero">
      <div class="brand-wrap">
        <svg class="brand-rings" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <circle cx="60" cy="60" r="52" />
          <circle cx="60" cy="60" r="38" />
          <circle cx="60" cy="60" r="24" />
          <circle cx="60" cy="60" r="6" />
        </svg>
        <p class="brand-eyebrow">404</p>
        <h1 class="brand-title">这里什么也没有。</h1>
        <p class="brand-lead">可能地址输错了，或者这一页已经下线。</p>
        <div class="brand-404-links">
          <a class="brand-link" href="/">回到首页</a>
          <a class="brand-link" href="/blog/">去博客看看</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
