---
import BaseLayout from '@kedoupi/shared/layouts/BaseLayout.astro';
import { articles } from '../../content/articles.js';

const title = '博客';
const description = '整理完成的公开表达：围绕个人数字空间、健康、投资与内容工作的观察与记录。';
---
<BaseLayout title={title} description={description} pathname="/blog/" schemaType="WebPage">
  <div class="blog-page">
    <header class="blog-header">
      <span class="blog-eyebrow">02 / 思考与沉淀</span>
      <h1 class="blog-title">真实想法，<br /><em>慢慢整理成文。</em></h1>
      <p class="blog-lead">
        不追求高频发表，也不迎合算法分发。围绕健康与睡眠、资本与决策、私域智能与生活实践，把每一次值得回看的思考沉淀下来。
      </p>
      <div class="blog-tags" aria-label="写作方向">
        <span class="blog-tag">深度思考</span>
        <span class="blog-tag">确信的经验</span>
        <span class="blog-tag">真实复盘</span>
        <span class="blog-tag">长期主义</span>
      </div>
    </header>

    {articles.length === 0 ? (
      <section class="blog-empty-pavilion" aria-label="文章整理中">
        <div class="blog-empty-hero">
          <div class="blog-status-pill">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>写作与整理中 · 敬请期待</span>
          </div>
          <h2 class="blog-empty-title">思考在日常里发生，在时间中沉淀</h2>
          <p class="blog-empty-desc">
            这里不会放未经推敲的碎片或占位草稿。只有经过真实生活检验、具备长期连接价值的观察与总结，才会梳理成篇公开发布。
          </p>

          <div class="blog-topics-grid">
            <article class="topic-card">
              <span class="topic-num">01</span>
              <span class="topic-tag">健康 · 睡眠 · 节律</span>
              <h3 class="topic-title">身体与恢复的长期观察</h3>
              <p class="topic-desc">从 Oura 的日常记录出发，理解睡眠、静息心率与精力的起伏，探索适合自己的生活节奏。</p>
            </article>

            <article class="topic-card">
              <span class="topic-num">02</span>
              <span class="topic-tag">投资 · 商业 · 复盘</span>
              <h3 class="topic-title">资本与决策的真实依据</h3>
              <p class="topic-desc">把持仓变化、研究依据与当时的心态完整保留下来，在市场的周期震荡中检验认知与执行。</p>
            </article>

            <article class="topic-card">
              <span class="topic-num">03</span>
              <span class="topic-tag">私域 · 智能 · MCP</span>
              <h3 class="topic-title">个人数据与专属 AI</h3>
              <p class="topic-desc">探索如何把自己的数据交给自己信任的 AI，让智能在严密的隐私边界内真正成为日常助手。</p>
            </article>
          </div>

          <div class="blog-quote-block">
            <p class="blog-quote-text">
              “写下确信的事，留给未来的自己回看，也让 AI 能够理解真实的你。”
            </p>
          </div>

          <p class="blog-empty-note">
            所有正式文章均发布于 codepi.app 主域名内，支持全文检索与 CodePi MCP 结构化只读接口。
          </p>
        </div>
      </section>
    ) : (
      <section class="blog-list" aria-label="文章列表">
        {articles.map((article) => (
          <a href={`/blog/${article.slug}/`} class="blog-card">
            <div class="blog-card-meta">
              <time datetime={article.date}>{article.displayDate}</time>
              {article.tag && <span class="blog-card-tag">{article.tag}</span>}
            </div>
            <h2 class="blog-card-title">{article.title}</h2>
            <p class="blog-card-summary">{article.summary}</p>
            <span class="blog-card-action">
              <span>阅读全文</span>
              <span class="arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .blog-header {
    max-width: 760px;
  }
  .blog-eyebrow {
    display: inline-block;
    color: var(--brand-orange-interactive);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .blog-title {
    margin: 0 0 20px;
    font-size: clamp(34px, 4.4vw, 50px);
    line-height: 1.16;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .blog-title em {
    font-style: normal;
    color: var(--brand-orange);
  }
  .blog-lead {
    margin: 0 0 24px;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .blog-tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 1px 4px rgba(45, 42, 40, 0.02);
  }

  /* 空状态 / 写作与整理展馆 */
  .blog-empty-pavilion {
    margin-top: 8px;
  }
  .blog-empty-hero {
    padding: 44px 44px 40px;
    border-radius: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 12px rgba(45, 42, 40, 0.02), 0 16px 40px rgba(45, 42, 40, 0.03);
  }
  .blog-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-orange-interactive);
    background: var(--brand-soft);
    margin-bottom: 24px;
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
    box-shadow: 0 0 0 3px rgba(255, 113, 61, 0.2);
  }
  .blog-empty-title {
    margin: 0 0 14px;
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .blog-empty-desc {
    margin: 0 0 36px;
    max-width: 720px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .blog-topics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    padding: 24px 22px;
    border-radius: 16px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    transition: transform var(--motion-normal) cubic-bezier(0.16, 1, 0.3, 1),
                border-color var(--motion-normal) ease;
  }
  .topic-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 113, 61, 0.4);
  }
  .topic-num {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-orange);
    margin-bottom: 8px;
  }
  .topic-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }
  .topic-title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 650;
    color: var(--color-text);
    line-height: 1.4;
  }
  .topic-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .blog-quote-block {
    padding: 22px 28px;
    border-radius: 14px;
    background: linear-gradient(90deg, rgba(255, 230, 217, 0.35) 0%, rgba(255, 248, 244, 0.5) 100%);
    border-left: 3px solid var(--brand-orange);
    margin-bottom: 24px;
  }
  .blog-quote-text {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.6;
  }
  .blog-empty-note {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* 文章已发布状态 */
  .blog-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 8px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 30px;
    border-radius: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(45, 42, 40, 0.02), 0 12px 32px rgba(45, 42, 40, 0.03);
    text-decoration: none;
    transition: transform var(--motion-normal) cubic-bezier(0.16, 1, 0.3, 1),
                border-color var(--motion-normal) ease,
                box-shadow var(--motion-normal) ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 113, 61, 0.4);
    box-shadow: 0 4px 16px rgba(45, 42, 40, 0.04), 0 20px 48px rgba(255, 113, 61, 0.08);
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .blog-card-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-orange-interactive);
    font-weight: 600;
    font-size: 12px;
  }
  .blog-card-title {
    margin: 0 0 12px;
    font-size: 22px;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }
  .blog-card-summary {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
    flex: 1 1 auto;
  }
  .blog-card-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-orange-interactive);
  }
  .blog-card-action .arrow {
    transition: transform var(--motion-normal) ease;
  }
  .blog-card:hover .blog-card-action .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .blog-topics-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .blog-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .blog-page {
      gap: 36px;
    }
    .blog-empty-hero {
      padding: 28px 20px;
      border-radius: 20px;
    }
    .blog-quote-block {
      padding: 16px 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .topic-card, .blog-card, .blog-card-action .arrow {
      transition: none;
    }
  }
</style>
