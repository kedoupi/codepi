---
import BaseLayout from '@kedoupi/shared/layouts/BaseLayout.astro';
import '../../styles/blog.css';
const title = '博客';
const description = '整理完成的公开表达：围绕个人数字空间、健康、投资与内容工作的观察与记录。';
---
<BaseLayout title={title} description={description} pathname="/blog/" schemaType="WebPage">
  <div class="blog-page">
    <header class="blog-header">
      <h1 class="blog-title">博客</h1>
      <p class="blog-lead">关于个人数字空间、健康、投资与内容工作的观察与记录。把值得回看的想法，慢慢整理成文。</p>
    </header>
    <section id="blog-list-mount" class="blog-list-section" hidden aria-label="文章列表"></section>
    <section class="blog-empty-pavilion" aria-labelledby="blog-empty-title">
      <h2 id="blog-empty-title">文章正在整理中</h2>
      <p>这里将收录经过审阅的公开文章。内容准备好后，会在这里发布。</p>
      <a class="kdp-link" href="/about/">先了解我在做什么</a>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../scripts/blog';
</script>
