    <!-- 交互权限控制区 -->
    <section class="orange" aria-labelledby="permission-title">
      <div class="orange-inner" data-reveal>
        <span class="label">主权归你</span>
        <h2 id="permission-title">靠近，<br />由你决定。</h2>
        <p>点击中央圆环，模拟一次授权与收回。AI 可以离你很近，但决定权必须始终握在你手里。</p>
        <button class="permission-control" type="button" data-permission-toggle aria-pressed="true" aria-label="收回或允许 AI 靠近">
          <span class="permission-core" aria-hidden="true"></span>
        </button>
        <p class="status" role="status" aria-live="polite">
          <span data-permission-status>正在允许 AI 靠近</span>
        </p>
      </div>
