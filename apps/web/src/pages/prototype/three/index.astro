---
import { PRODUCT_BRAND } from '@kedoupi/shared/brand';
import { products } from '@kedoupi/shared/products';
import '@kedoupi/shared/styles/tokens.css';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="AI，先从你开始。kedoupi（codepi）Three.js 首页原型。" />
  <meta name="theme-color" content="#FAF8F4" />
  <title>AI，先从你开始 | kedoupi（codepi）</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>document.documentElement.classList.add('motion-ready');</script>
  <style is:global>
    :root{
      color-scheme:light;
      --paper:var(--color-background);
      --surface:var(--color-surface);
      --ink:var(--color-text);
      --muted:var(--color-text-muted);
      --orange:var(--brand-orange);
      --action:var(--color-action-hover);
      --line:color-mix(in srgb,var(--ink) 12%,transparent);
      --soft:color-mix(in srgb,var(--ink) 5%,transparent);
      --gutter:clamp(20px,5.2vw,96px);
      --max:1400px;
    }
    *,*:before,*:after{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--paper)}
    body{
      margin:0;
      min-width:0;
      overflow-x:hidden;
      background:var(--paper);
      color:var(--ink);
      font-family:var(--font-sans);
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }
    ::selection{background:var(--brand-soft);color:var(--ink)}
    a{color:inherit}
    button{font:inherit;color:inherit}
    button,a{-webkit-tap-highlight-color:transparent}
    :focus-visible{outline:2px solid var(--color-focus);outline-offset:5px}
    .width{width:min(calc(100% - var(--gutter)*2),var(--max));margin-inline:auto}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

    /* 顶栏 Header */
    .header{
      position:fixed;
      inset:0 0 auto;
      z-index:20;
      min-height:76px;
      border-bottom:1px solid transparent;
      background:color-mix(in srgb,var(--paper) 80%,transparent);
      backdrop-filter:blur(20px);
      -webkit-backdrop-filter:blur(20px);
      transition:border-color .3s,background-color .3s;
    }
    .header.is-scrolled{
      border-color:var(--soft);
      background:color-mix(in srgb,var(--paper) 92%,transparent);
    }
    .header-inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      min-height:76px;
      gap:28px;
    }
    .brand{display:inline-flex;align-items:center;min-height:44px;text-decoration:none}
    .brand img{display:block;width:124px;height:auto;aspect-ratio:1800/500;object-fit:contain}
    .nav{
      display:flex;
      gap:clamp(18px,3vw,38px);
      align-items:center;
      color:var(--muted);
      font-size:12px;
      font-weight:600;
    }
    .nav a{text-decoration:none;transition:color .2s}
    .nav a:hover{color:var(--ink)}
    .nav a:last-child{
      padding:9px 16px;
      border:1px solid var(--line);
      border-radius:999px;
      color:var(--ink);
      transition:all .2s;
    }
    .nav a:last-child:hover{
      background:var(--ink);
      color:var(--paper);
      border-color:var(--ink);
    }

    /* Hero & 3D Stage */
    .hero{
      position:relative;
      height:560svh;
      min-height:3600px;
      background:var(--paper);
    }
    .hero-stage{
      position:sticky;
      top:0;
      height:100svh;
      min-height:680px;
      overflow:hidden;
      isolation:isolate;
    }
    .hero-stage:before{
      content:"";
      position:absolute;
      inset:0;
      z-index:-2;
      background:radial-gradient(circle at 60% 48%,color-mix(in srgb,var(--brand-soft) 42%,transparent),transparent 28%),linear-gradient(90deg,transparent 0 74%,color-mix(in srgb,var(--ink) 3%,transparent) 74.05% 74.12%,transparent 74.18%);
    }
    .hero-stage:after{
      content:"";
      position:absolute;
      inset:auto 0 0;
      z-index:4;
      height:18%;
      background:linear-gradient(transparent,var(--paper));
      pointer-events:none;
    }
    .stage-canvas{
      position:absolute;
      inset:0;
      z-index:1;
      width:100%;
      height:100%;
      pointer-events:none;
    }
    .fallback-thread{
      position:absolute;
      top:48%;
      left:50%;
      z-index:0;
      width:min(62vw,900px);
      height:2px;
      background:linear-gradient(90deg,transparent,var(--orange) 35%,var(--ink) 65%,transparent);
      transform:translate(-50%,-50%) rotate(-12deg);
      opacity:.25;
    }

    /* 首屏主标题 Hero Copy */
    .hero-copy{
      position:absolute;
      top:50%;
      left:var(--gutter);
      z-index:6;
      width:min(680px,72vw);
      transform:translateY(-50%);
      transition:opacity .4s ease,transform .4s ease;
      will-change:opacity,transform;
    }
    .eyebrow,.label{
      display:block;
      margin-bottom:24px;
      color:var(--muted);
      font-size:12px;
      letter-spacing:.04em;
    }
    .hero-copy h1{
      margin:0;
      font-size:clamp(62px,10vw,156px);
      font-weight:680;
      line-height:.96;
      letter-spacing:-.08em;
    }
    .hero-copy h1 span{display:block}
    .hero-copy h1 span.nowrap{white-space:nowrap}
    .hero-copy h1 em,.future h2 em,.dark h2 em,.quote em{
      color:var(--action);
      font-style:normal;
    }
    .hero-copy p{
      max-width:330px;
      margin:42px 0 0;
      color:var(--muted);
      font-size:clamp(14px,1.2vw,17px);
      line-height:1.85;
    }
    .scroll-note{
      display:flex;
      align-items:center;
      gap:14px;
      margin-top:36px;
      color:var(--muted);
      font-size:11px;
    }
    .scroll-note:before{
      content:"";
      width:38px;
      height:1px;
      background:var(--orange);
    }

    /* 滚动章节 Overlays */
    .scenes{
      position:absolute;
      inset:0;
      z-index:6;
      pointer-events:none;
    }
    .scene{
      position:absolute;
      inset:0;
      display:grid;
      align-items:center;
      width:min(calc(100% - var(--gutter)*2),var(--max));
      margin:auto;
      opacity:0;
      transform:translateY(36px);
      transition:opacity .55s ease,transform .85s cubic-bezier(.22,1,.36,1);
    }
    .scene.active{
      opacity:1;
      transform:none;
    }
    .scene-copy{
      grid-column:2;
      justify-self:end;
      width:min(320px,28vw);
      margin-top:32vh;
    }
    .scene-badge{
      display:inline-block;
      margin-bottom:10px;
      color:var(--action);
      font-family:var(--font-mono);
      font-size:11px;
      font-weight:600;
      letter-spacing:.05em;
    }
    .scene-copy strong{
      display:block;
      margin-bottom:12px;
      font-size:clamp(17px,1.6vw,22px);
      font-weight:640;
      letter-spacing:-.04em;
      line-height:1.25;
    }
    .scene-copy p{
      margin:0;
      color:var(--muted);
      font-size:13px;
      line-height:1.85;
    }
    .scene.last .scene-copy{
      margin-top:-34vh;
    }

    /* 章节计数器 */
    .count{
      position:absolute;
      right:var(--gutter);
      bottom:32px;
      z-index:7;
      display:flex;
      align-items:center;
      gap:12px;
      color:var(--muted);
      font-family:var(--font-mono);
      font-size:10px;
    }
    .count:before{
      content:"";
      width:36px;
      height:1px;
      background:var(--orange);
    }
    .count strong{
      color:var(--ink);
      font-size:14px;
      font-weight:600;
    }

    /* 暗调沉浸章节 */
    .dark{
      display:grid;
      place-items:center;
      min-height:92svh;
      padding:150px var(--gutter);
      text-align:center;
      background:var(--ink);
      color:var(--paper);
    }
    .dark-inner{
      position:relative;
      z-index:1;
      width:min(100%,940px);
    }
    .dark .label{color:color-mix(in srgb,var(--paper) 56%,transparent)}
    .dark h2,.day h2,.spaces h2,.orange h2,.future h2{
      margin:0;
      font-size:clamp(46px,6.5vw,98px);
      font-weight:660;
      line-height:1.08;
      letter-spacing:-.06em;
      text-wrap:balance;
    }
    .dark h2{color:var(--paper)}
    .dark p,.orange p{
      max-width:32rem;
      margin:40px auto 0;
      color:color-mix(in srgb,currentColor 64%,transparent);
      font-size:15px;
      line-height:1.9;
    }

    /* 你的一天 & 空间列表 & 结尾通用间距 */
    section[id]{
      scroll-margin-top:96px;
    }
    .day,.spaces,.future{
      padding:clamp(140px,17vw,260px) 0;
    }
    .day{background:var(--paper)}
    .spaces{background:var(--surface)}
    .future{background:var(--paper)}

    .day-head,.spaces-head,.future-head{
      display:grid;
      grid-template-columns:minmax(0,.82fr) minmax(260px,.5fr);
      gap:clamp(44px,12vw,180px);
      align-items:end;
    }
    .day h2,.spaces h2,.future h2{max-width:min(100%, 720px)}
    .day-head p,.spaces-head p,.future-head p{
      max-width:27rem;
      margin:0 0 8px;
      color:var(--muted);
      font-size:15px;
      line-height:1.9;
    }

    /* 时间轴 Timeline */
    .timeline{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:clamp(28px,4.5vw,72px);
      margin-top:clamp(96px,14vw,180px);
      padding-top:42px;
      border-top:1px solid var(--line);
    }
    .moment{position:relative;padding-top:28px}
    .moment:before{
      content:"";
      position:absolute;
      top:-1px;
      left:0;
      width:36px;
      height:2px;
      background:var(--orange);
    }
    .moment .moment-time{
      display:block;
      margin-bottom:8px;
      color:var(--action);
      font-family:var(--font-mono);
      font-size:11px;
      font-weight:600;
      letter-spacing:.04em;
    }
    .moment strong{
      display:block;
      margin-bottom:12px;
      font-size:clamp(22px,2.4vw,34px);
      font-weight:620;
      letter-spacing:-.05em;
    }
    .moment p{
      margin:0;
      color:var(--muted);
      font-size:13px;
      line-height:1.8;
    }
    .quote{
      margin:clamp(80px,12vw,160px) 0 0;
      font-size:clamp(30px,4.4vw,66px);
      font-weight:620;
      line-height:1.06;
      letter-spacing:-.075em;
    }

    /* 空间列表 Space List */
    .space-list{
      margin-top:clamp(80px,12vw,170px);
      border-top:1px solid var(--line);
    }
    .space-list a{
      display:grid;
      grid-template-columns:58px minmax(150px,.6fr) minmax(0,1fr) 24px;
      align-items:center;
      gap:20px;
      min-height:106px;
      border-bottom:1px solid var(--line);
      text-decoration:none;
      transition:padding .36s cubic-bezier(.22,1,.36,1),background-color .22s;
    }
    .space-list a:hover{
      padding-inline:20px;
      background:var(--brand-soft);
    }
    .index{
      color:var(--muted);
      font-family:var(--font-mono);
      font-size:10px;
    }
    .space-name{
      font-size:clamp(22px,2.6vw,38px);
      font-weight:620;
      letter-spacing:-.065em;
    }
    .space-description{
      color:var(--muted);
      font-size:13px;
      line-height:1.7;
    }
    .arrow{
      color:var(--action);
      font-size:19px;
      transition:transform .3s;
    }
    .space-list a:hover .arrow{
      transform:translate(4px,-4px);
    }

    /* 权限控制橙色模块 */
    .orange{
      position:relative;
      display:grid;
      place-items:center;
      min-height:94svh;
      padding:150px var(--gutter);
      overflow:hidden;
      background:var(--orange);
      color:var(--ink);
      text-align:center;
    }
    .orange:before{
      content:"";
      position:absolute;
      top:50%;
      left:50%;
      width:min(72vw,920px);
      aspect-ratio:1;
      border:1px solid color-mix(in srgb,var(--ink) 18%,transparent);
      border-radius:50%;
      transform:translate(-50%,-50%) rotateX(68deg);
      pointer-events:none;
    }
    .orange-inner{
      position:relative;
      z-index:1;
      width:min(100%,940px);
    }
    .orange h2{color:var(--ink)}
    .permission-control{
      position:relative;
      display:grid;
      place-items:center;
      width:126px;
      height:126px;
      margin:52px auto 0;
      border:1px solid color-mix(in srgb,var(--ink) 45%,transparent);
      border-radius:50%;
      background:transparent;
      cursor:pointer;
      transition:transform .5s cubic-bezier(.22,1,.36,1);
    }
    .permission-control:hover{transform:scale(1.05)}
    .permission-control:before,.permission-control:after{
      content:"";
      position:absolute;
      border:1px solid color-mix(in srgb,var(--ink) 26%,transparent);
      border-radius:50%;
      transition:.6s cubic-bezier(.22,1,.36,1);
    }
    .permission-control:before{inset:-17px}
    .permission-control:after{inset:-37px;opacity:.46}
    .permission-control[aria-pressed="false"]:before{transform:scale(.7);opacity:.2}
    .permission-control[aria-pressed="false"]:after{transform:scale(.45);opacity:.08}
    .permission-core{
      width:34px;
      height:34px;
      border-radius:50%;
      background:var(--ink);
      box-shadow:0 0 58px color-mix(in srgb,var(--ink) 45%,transparent);
      transition:.5s;
    }
    .permission-control[aria-pressed="false"] .permission-core{
      transform:scale(.55);
      background:color-mix(in srgb,var(--ink) 36%,transparent);
      box-shadow:none;
    }
    .status{
      margin:32px 0 0;
      font-size:13px;
      font-weight:650;
    }

    /* 尾声 Epilogue */
    .future-rule{
      margin-top:clamp(86px,12vw,170px);
      padding:28px 0;
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
      font-size:clamp(26px,4vw,62px);
      font-weight:620;
      line-height:1.08;
      letter-spacing:-.075em;
    }
    .future-note{
      max-width:32rem;
      margin:32px 0 0;
      color:var(--muted);
      font-size:13px;
      line-height:1.8;
    }
    .actions{
      display:flex;
      flex-wrap:wrap;
      gap:18px 26px;
      margin-top:40px;
    }
    .primary,.secondary{
      display:inline-flex;
      align-items:center;
      min-height:48px;
      font-size:13px;
      font-weight:650;
      text-decoration:none;
    }
    .primary{
      padding:0 26px;
      border-radius:999px;
      background:var(--ink);
      color:var(--paper);
      transition:.22s;
    }
    .primary:hover{
      background:var(--action);
      transform:translateY(-2px);
    }
    .secondary{
      text-decoration:underline;
      text-underline-offset:6px;
      transition:color .2s;
    }
    .secondary:hover{color:var(--action)}

    /* 页脚 Footer */
    .footer{
      padding:32px 0;
      border-top:1px solid var(--line);
      font-size:11px;
      color:var(--muted);
    }
    .footer-inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
    }
    .footer-brand{
      display:inline-flex;
      align-items:center;
      gap:14px;
      text-decoration:none;
    }
    .footer-brand img{display:block;width:104px;height:auto;aspect-ratio:1800/500;object-fit:contain}

    /* 滚动进入动画 Reveal */
    [data-reveal]{opacity:1;transform:none}
    .motion-ready [data-reveal]{
      opacity:0;
      transform:translateY(26px);
      transition:opacity .82s cubic-bezier(.22,1,.36,1) var(--delay,0ms),transform .92s cubic-bezier(.22,1,.36,1) var(--delay,0ms);
    }
    .motion-ready [data-reveal].visible{
      opacity:1;
      transform:none;
    }

    /* 响应式断点 */
    @media(max-width:900px){
      .hero-copy h1{font-size:clamp(56px,10vw,96px)}
      .day-head,.spaces-head,.future-head{grid-template-columns:1fr;gap:34px}
      .day-head p,.spaces-head p,.future-head p{max-width:35rem}
    }
    @media(max-width:767px){
      :root{--gutter:16px}
      .header,.header-inner{min-height:62px}
      .header-inner{width:calc(100% - 24px)}
      .brand img{width:104px}.footer-brand img{width:96px}
      .nav{gap:0}
      .nav a:not(:last-child){display:none}
      .nav a:last-child{min-height:38px;padding:0 13px}
      .hero{height:500svh;min-height:3000px}
      .hero-stage{min-height:620px}
      .hero-copy{top:20%;left:16px;width:calc(100% - 32px);transform:none}
      .eyebrow{margin-bottom:18px;font-size:11px}
      .hero-copy h1{font-size:clamp(48px,12.5vw,72px);line-height:.98}
      .hero-copy p{max-width:280px;margin-top:24px;font-size:13px;line-height:1.8}
      .scroll-note{margin-top:24px;font-size:10px}
      .scene{display:block;width:calc(100% - 32px);padding-top:60vh}
      .scene-copy,.scene.last .scene-copy{width:min(280px,82vw);margin:0 0 0 auto}
      .scene-copy strong{font-size:16px}
      .scene-copy p{font-size:12px}
      .count{right:16px;bottom:24px}
      .dark,.orange{min-height:72svh;padding-block:108px}
      .dark h2,.day h2,.spaces h2,.orange h2,.future h2{font-size:clamp(44px,12vw,68px);line-height:.96}
      .dark p,.day-head p,.spaces-head p,.future-head p,.orange p{font-size:13px;line-height:1.8}
      .day,.spaces,.future{padding-block:104px}
      .timeline{grid-template-columns:1fr;gap:36px;margin-top:64px}
      .moment{padding-top:20px}
      .moment strong{margin-bottom:8px;font-size:20px}
      .moment p{font-size:12px}
      .quote{margin-top:64px;font-size:28px;line-height:1.14}
      .space-list{margin-top:60px}
      .space-list a{grid-template-columns:34px minmax(110px,.7fr) 24px;gap:10px;min-height:88px}
      .space-list a:hover{padding-inline:0}
      .space-name{font-size:20px}
      .space-description{display:none}
      .permission-control{width:110px;height:110px;margin-top:40px}
      .future-rule{margin-top:60px;font-size:26px}
      .future-note{margin-top:22px;font-size:12px}
      .actions{align-items:stretch;flex-direction:column;max-width:240px;margin-top:28px}
      .footer-inner{align-items:flex-start;flex-direction:column;gap:10px}
    }
    @media(prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      .stage-canvas{display:none}
      .hero-stage{position:relative;inset:auto;min-height:70svh}
      .motion-ready [data-reveal]{opacity:1;transform:none;transition:none}
      *,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
    }
  </style>
</head>
<body>
  <header class="header" data-header>
    <div class="width header-inner">
      <a class="brand" href="/prototype/three/" aria-label={`${PRODUCT_BRAND} Three.js 首页原型`}>
        <img
          src="/brand/codepi-logo.png"
          srcset="/brand/codepi-logo-450w.png 450w, /brand/codepi-logo-900w.png 900w, /brand/codepi-logo.png 1800w"
          sizes="(max-width: 767px) 104px, 124px"
          alt="CodePi"
          width="1800"
          height="500"
          decoding="async"
        />
      </a>
      <nav class="nav" aria-label="原型导航">
        <a href="#day">你的一天</a>
        <a href="#spaces">现在的空间</a>
        <a href="/">回到首页</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 3D 滚动 Hero -->
    <section class="hero" data-hero aria-labelledby="hero-title">
      <div id="chapter-01" style="position:absolute;top:0;height:1px;pointer-events:none;"></div>
      <div id="chapter-02" style="position:absolute;top:28%;height:1px;pointer-events:none;"></div>
      <div id="chapter-03" style="position:absolute;top:58%;height:1px;pointer-events:none;"></div>
      <div id="chapter-04" style="position:absolute;top:86%;height:1px;pointer-events:none;"></div>
      <div class="hero-stage">
        <div class="fallback-thread" aria-hidden="true"></div>
        <canvas class="stage-canvas" data-stage-canvas aria-hidden="true"></canvas>

        <div class="hero-copy" data-hero-copy>
          <span class="eyebrow">把自己的数据，交给自己的 AI</span>
          <h1 id="hero-title">
            <span>AI，</span>
            <span class="nowrap">先从<em>你</em>开始。</span>
          </h1>
          <p>它不替你生活。它只从你已经拥有的生活里，慢慢学会靠近。</p>
          <span class="scroll-note">向下，看光线如何凝聚</span>
        </div>

        <div class="scenes" aria-hidden="true">
          <article class="scene active" data-scene></article>
          <article class="scene" data-scene>
            <div class="scene-copy">
              <span class="scene-badge">02 / 汇聚</span>
              <strong>凝聚你的生活上下文。</strong>
              <p>晨起的节律、白天的专注、夜晚的记录。每一个真实的片段，都在这里汇聚成专属你的理解。</p>
            </div>
          </article>
          <article class="scene" data-scene>
            <div class="scene-copy">
              <span class="scene-badge">03 / 授权</span>
              <strong>你决定，它能听见什么。</strong>
              <p>每一次靠近都经过你的允许。没有默认的窥探，只有你授予的边界与信任。</p>
            </div>
          </article>
          <article class="scene last" data-scene>
            <div class="scene-copy">
              <span class="scene-badge">04 / 释放</span>
              <strong>然后，把注意力还给生活。</strong>
              <p>最强大的智能，是在你需要时及时出现，在日常中安静守候。</p>
            </div>
          </article>
        </div>

        <div class="count" aria-hidden="true">
          <strong data-scene-current>01</strong>
          <span>/ 04</span>
        </div>
      </div>
    </section>

    <!-- 暗调哲学过渡 -->
    <section class="dark" aria-labelledby="statement-title">
      <div class="dark-inner" data-reveal>
        <span class="label">安全与主权</span>
        <h2 id="statement-title">不拥有你，<br /><em>才有资格</em>理解你。</h2>
        <p>你的数据不是训练材料，也不是等待被算法切片的燃料。它只是你愿意交出来、并且随时可以收回的真实生活。</p>
      </div>
    </section>

    <!-- 你的一天 Timeline -->
    <section class="day" id="day" aria-labelledby="day-title">
      <div class="width">
        <div class="day-head">
          <div data-reveal>
            <span class="label">连续的生活</span>
            <h2 id="day-title">生活，<br />本就是连续的。</h2>
          </div>
          <p data-reveal style="--delay:100ms">
            醒来、专注、沉淀。每一个片段都属于同一个你，也是明天可以继续的线索。
          </p>
        </div>

        <div class="timeline" data-reveal style="--delay:160ms">
          <article class="moment">
            <span class="moment-time">07:00</span>
            <strong>晨起</strong>
            <p>从身体的节律开始，知道今天的自己在哪里。</p>
          </article>
          <article class="moment">
            <span class="moment-time">14:00</span>
            <strong>专注</strong>
            <p>把手头正在推进的事，放回更长期的思考里。</p>
          </article>
          <article class="moment">
            <span class="moment-time">23:00</span>
            <strong>沉淀</strong>
            <p>让今天的记录与想法，成为明天可以轻松接续的起点。</p>
          </article>
