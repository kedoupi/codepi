    <!-- 空间列表（当前起点，向未知生长） -->
    <section class="spaces" id="spaces" aria-labelledby="spaces-title">
      <div class="width">
        <div class="spaces-head">
          <div data-reveal>
            <span class="label">现在的起点</span>
            <h2 id="spaces-title">从现在开始，<br />向未知生长。</h2>
          </div>
          <p data-reveal style="--delay:100ms">
            健康、投资、思考、创作——当前的空间只是一个起点。未来你可以加入更多生活维度，它不会预设上限。
          </p>
        </div>

        <div class="space-list" data-reveal style="--delay:160ms">
          {products.map((product, index) => (
            <a href={`/apps/#${product.id}`}>
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <strong class="space-name">{product.shortName}</strong>
              <span class="space-description">{product.description}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
