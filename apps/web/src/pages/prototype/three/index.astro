    <!-- 结尾 Epilogue -->
    <section class="future" aria-labelledby="future-title">
      <div class="width">
        <div class="future-head">
          <div data-reveal>
            <span class="label">属于你的私域智能</span>
            <h2 id="future-title">把自己的数据，<br />交给<em>自己的 AI</em>。</h2>
          </div>
          <p data-reveal style="--delay:100ms">
            让它越来越懂你，也始终把你放在中心。开启属于你的数字化个人世界。
          </p>
        </div>

        <div class="future-rule" data-reveal style="--delay:160ms">
          你的世界越完整，<em>AI 越应该保持克制。</em>
        </div>

        <p class="future-note" data-reveal style="--delay:220ms">
          把自己的数据交给自己的 AI，让它更懂你，但不拥有你。
        </p>

        <div class="actions" data-reveal style="--delay:280ms">
          <a class="primary" href="/apps/">看看现在的空间</a>
          <a class="secondary" href="/about/">了解空间理念</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="width footer-inner">
      <a class="footer-brand" href="/prototype/three/" aria-label={`${PRODUCT_BRAND} 首页原型`}>
        <img
          src="/brand/codepi-logo.png"
          srcset="/brand/codepi-logo-450w.png 450w, /brand/codepi-logo-900w.png 900w, /brand/codepi-logo.png 1800w"
          sizes="(max-width: 767px) 96px, 104px"
          alt="CodePi"
          width="1800"
          height="500"
          decoding="async"
          loading="lazy"
        />
        <span>kedoupi（codepi）· Three.js 原型</span>
      </a>
      <span>Local prototype · Not indexed · {year}</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const hero = document.querySelector('[data-hero]');
    const heroCopy = document.querySelector('[data-hero-copy]');
    const header = document.querySelector('[data-header]');
    const scenes = [...document.querySelectorAll('[data-scene]')];
    const sceneCurrent = document.querySelector('[data-scene-current]');
    const reveals = document.querySelectorAll('[data-reveal]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const permissionToggle = document.querySelector('[data-permission-toggle]');
    const permissionStatus = document.querySelector('[data-permission-status]');

    let progress = 0;
    let frame = 0;
    let permission = 1;

    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const ease = v => v * v * (3 - 2 * v);

    function update() {
      if (hero instanceof HTMLElement) {
        const scrollable = hero.offsetHeight - innerHeight;
        const rect = hero.getBoundingClientRect();
        progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;
        
        // 章节激活
        const active = Math.min(scenes.length - 1, Math.floor(progress * scenes.length));
        scenes.forEach((s, i) => s.classList.toggle('active', i === active));
        if (sceneCurrent) sceneCurrent.textContent = String(active + 1).padStart(2, '0');
        
        // 顶栏背景模糊
        header?.classList.toggle('is-scrolled', rect.top < -20);

        // 首屏文字淡出
        if (heroCopy instanceof HTMLElement) {
          const heroFade = clamp(1 - progress * 4.2, 0, 1);
          heroCopy.style.opacity = String(heroFade);
          heroCopy.style.transform = `translateY(calc(-50% - ${(1 - heroFade) * 36}px))`;
          heroCopy.style.pointerEvents = heroFade < 0.1 ? 'none' : 'auto';
        }
      }
      frame = 0;
    }

    function request() {
      if (!frame) frame = requestAnimationFrame(update);
    }

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request, { passive: true });
    update();

    // 观察器
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      reveals.forEach(e => e.classList.add('visible'));
    } else {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(e => observer.observe(e));
    }

    // 授权交互
    permissionToggle?.addEventListener('click', () => {
      permission = permission > 0.5 ? 0 : 1;
      permissionToggle.setAttribute('aria-pressed', String(permission > 0.5));
      if (permissionStatus) {
        permissionStatus.textContent = permission > 0.5
          ? '正在允许 AI 靠近'
          : 'AI 已退回安全边界，等待你的下一次召唤';
      }
    });

    // Three.js 动态光线核心
    const startThree = async () => {
      const canvas = document.querySelector('[data-stage-canvas]');
      if (!(canvas instanceof HTMLCanvasElement) || reduceMotion.matches) return;

      try {
        const THREE = await import('three');
        const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

        const mobile = matchMedia('(max-width:767px)').matches;
        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: !mobile,
          powerPreference: 'high-performance'
        });
        renderer.setClearAlpha(0);
        renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.2 : 1.55));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 40);
        camera.position.z = 7.5;

        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
        pmrem.dispose();

        const token = n => getComputedStyle(root).getPropertyValue(n).trim();
        const colors = {
          ink: new THREE.Color(token('--color-text')),
          muted: new THREE.Color(token('--color-text-muted')),
          orange: new THREE.Color(token('--brand-orange')),
          paper: new THREE.Color(token('--color-background'))
        };

        const world = new THREE.Group();
        scene.add(world);

        // 柔和光晕
        const glow = new THREE.Mesh(
          new THREE.PlaneGeometry(8.8, 8.8),
          new THREE.ShaderMaterial({
            transparent: true,
            depthWrite: false,
            depthTest: false,
            blending: THREE.AdditiveBlending,
            uniforms: {
              uColor: { value: colors.orange },
              uOpacity: { value: 0.12 },
              uPhase: { value: 0 },
              uScale: { value: 1 }
            },
            vertexShader: `
              varying vec2 vUv;
              void main(){
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
              }
            `,
            fragmentShader: `
              uniform vec3 uColor;
              uniform float uOpacity;
              uniform float uPhase;
              uniform float uScale;
              varying vec2 vUv;
              void main(){
                vec2 p = (vUv - 0.5) * 2.0;
                float d = length(p * vec2(1.0, 0.72));
                float ring = exp(-pow((d - (0.28 + uPhase * 0.18)) / (0.12 + uPhase * 0.08), 2.0));
                float core = exp(-d * d * (3.6 / uScale));
                float a = (ring * 0.35 + core * 0.65) * uOpacity;
                gl_FragColor = vec4(uColor, a);
              }
            `
          })
        );
        glow.position.set(0.35, 0.08, -1.8);
        world.add(glow);

        // 4 个戏剧性关键帧形态 (Keyframe Control Points)
        // Stage 0: 舒展流动波浪
        // Stage 1: 强烈向中心聚拢成环形扭结 (Helical Coalesce)
        // Stage 2: 空间三维景深绽放 (Spatial 3D Bloom)
        // Stage 3: 平缓地退向远方地平线 (Calm Horizon Release)
        const KEYFRAMES = [
          // Stage 0: 流动波浪
          [
            [[-5.2,0.4,0.2],[-3.2,-0.2,0.1],[-1.2,0.45,0.3],[0.3,-0.38,0.0],[1.8,0.3,-0.2],[3.4,-0.2,0.1],[5.2,0.45,0.3]],
            [[-5.0,0.0,-0.1],[-3.0,-0.35,-0.1],[-1.0,0.1,0.0],[0.5,-0.5,-0.1],[2.0,0.0,-0.3],[3.6,-0.35,-0.1],[5.0,0.2,0.0]],
            [[-5.0,-0.3,-0.3],[-2.8,0.2,-0.2],[-0.8,-0.25,-0.2],[0.8,0.3,-0.3],[2.4,-0.15,-0.4],[3.8,0.15,-0.3],[5.0,-0.2,-0.2]]
          ],
          // Stage 1: 扭结聚拢
          [
            [[-3.2,1.2,-0.5],[-1.6,-0.8,0.4],[-0.4,1.1,1.5],[0.6,-0.9,1.3],[1.5,0.8,0.2],[2.6,-1.0,-0.4],[3.6,0.9,-0.8]],
            [[-3.0,-1.0,-0.4],[-1.5,0.9,0.1],[-0.2,-0.8,0.8],[0.7,0.9,0.7],[1.6,-0.7,0.0],[2.8,0.8,-0.5],[3.5,-0.7,-0.7]],
            [[-3.4,0.0,0.2],[-2.0,-1.4,0.0],[0.0,-1.6,0.5],[2.0,-1.2,0.0],[3.2,0.2,-0.3],[1.8,1.5,-0.1],[-1.8,1.4,0.1]]
          ],
          // Stage 2: 空间纵深绽放
          [
            [[-4.8,0.2,-1.0],[-2.6,1.5,0.2],[-0.6,1.8,0.9],[1.2,1.3,0.6],[2.8,0.4,-0.2],[4.0,-0.8,-1.0],[5.0,-1.4,-1.8]],
            [[-4.5,-0.4,-0.5],[-2.4,-1.4,-1.2],[-0.5,-1.7,-2.0],[1.4,-1.2,-2.2],[3.0,-0.2,-1.6],[4.2,0.8,-1.0],[5.0,1.2,-0.6]],
            [[-5.2,-0.1,-0.6],[-3.0,0.15,-0.4],[-1.0,-0.1,-0.3],[1.0,0.12,-0.3],[2.8,-0.08,-0.4],[4.2,0.1,-0.5],[5.2,-0.05,-0.6]]
          ],
          // Stage 3: 静谧地平线
          [
            [[-5.5,-0.4,-2.2],[-3.2,-0.48,-2.3],[-1.0,-0.42,-2.4],[1.0,-0.46,-2.4],[3.0,-0.43,-2.3],[4.5,-0.47,-2.2],[5.5,-0.44,-2.2]],
            [[-5.2,-0.6,-2.6],[-3.0,-0.65,-2.7],[-0.8,-0.58,-2.8],[1.2,-0.62,-2.8],[3.2,-0.59,-2.7],[4.6,-0.63,-2.6],[5.2,-0.6,-2.6]],
            [[-5.0,-0.75,-2.9],[-2.8,-0.78,-3.0],[-0.5,-0.72,-3.1],[1.5,-0.76,-3.1],[3.5,-0.73,-3.0],[4.8,-0.77,-2.9],[5.0,-0.75,-2.9]]
          ]
        ];

        function getInterpolatedPoints(ribbonIdx, progressVal) {
          const p = clamp(progressVal, 0, 1);
          const segment = p * (KEYFRAMES.length - 1);
          const idx = Math.min(Math.floor(segment), KEYFRAMES.length - 2);
          const rawT = segment - idx;
          const t = rawT * rawT * (3 - 2 * rawT);
          const from = KEYFRAMES[idx][ribbonIdx];
          const to = KEYFRAMES[idx + 1][ribbonIdx];
          return from.map((ptA, i) => {
            const ptB = to[i];
            return new THREE.Vector3(
              ptA[0] + (ptB[0] - ptA[0]) * t,
              ptA[1] + (ptB[1] - ptA[1]) * t,
              ptA[2] + (ptB[2] - ptA[2]) * t
            );
          });
        }

        const specs = [
          { y: 0.12, z: 0.15, c: colors.orange, r: 0.040, o: 0.96, emissive: 0.28, highlight: 0.78 },
          { y: -0.05, z: 0.02, c: colors.ink, r: 0.020, o: 0.32, emissive: 0.06, highlight: 0.22 },
          { y: -0.22, z: -0.10, c: colors.muted, r: 0.014, o: 0.34, emissive: 0.05, highlight: 0.24 }
        ];

        const ribbons = [];
        const pulses = [];

        specs.forEach((spec, index) => {
          const initialPoints = getInterpolatedPoints(index, 0);
          const curve = new THREE.CatmullRomCurve3(initialPoints, false, 'centripetal', 0.5);
          const segments = mobile ? 72 : 120;
          const tubeGeometry = new THREE.TubeGeometry(curve, segments, spec.r, 10, false);

          const material = new THREE.MeshPhysicalMaterial({
            color: spec.c,
            roughness: index ? 0.18 : 0.14,
            metalness: index ? 0.35 : 0.22,
            clearcoat: 1.0,
            clearcoatRoughness: 0.05,
            ior: 1.48,
            iridescence: index ? 0.08 : 0.3,
            iridescenceIOR: 1.32,
            emissive: spec.c,
            emissiveIntensity: spec.emissive,
            transparent: true,
            opacity: spec.o,
            depthWrite: false
          });

          const mesh = new THREE.Mesh(tubeGeometry, material);

          // 白色高光核心细丝
          const highlightMaterial = new THREE.MeshPhysicalMaterial({
            color: colors.paper,
            roughness: 0.08,
            metalness: 0.05,
            clearcoat: 0.9,
            clearcoatRoughness: 0.04,
            emissive: colors.paper,
            emissiveIntensity: 0.6,
            transparent: true,
            opacity: spec.highlight,
            depthWrite: false
          });
          const highlightGeometry = new THREE.TubeGeometry(curve, segments, spec.r * 0.36, 8, false);
          const highlight = new THREE.Mesh(highlightGeometry, highlightMaterial);

          world.add(mesh, highlight);
          ribbons.push({ mesh, highlight, curve, material, highlightMaterial, spec, segments, index });

          // 移动脉冲光点
          const pulse = new THREE.Mesh(
            new THREE.SphereGeometry(index ? 0.05 : 0.095, 16, 12),
            new THREE.MeshPhysicalMaterial({
              color: colors.paper,
              roughness: 0.1,
              metalness: 0.1,
              clearcoat: 1,
              emissive: colors.orange,
              emissiveIntensity: index ? 0.6 : 1.3,
              transparent: true,
              opacity: 0.95
            })
          );
          world.add(pulse);
          pulses.push({ pulse, curve, offset: index * 0.28 });
        });

        // 粒子尘埃
        const dustCount = mobile ? 90 : 200;
        const positions = new Float32Array(dustCount * 3);
        for (let i = 0; i < dustCount; i++) {
          positions[i * 3] = Math.sin(i * 2.41) * 5.2;
          positions[i * 3 + 1] = Math.cos(i * 1.73) * 2.8;
          positions[i * 3 + 2] = Math.sin(i * 0.91) * 2.0 - 0.7;
        }
        const dustGeometry = new THREE.BufferGeometry();
        dustGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const dust = new THREE.Points(
          dustGeometry,
          new THREE.PointsMaterial({
            color: colors.orange,
            size: mobile ? 0.012 : 0.016,
            transparent: true,
            opacity: 0.24,
            depthWrite: false,
            sizeAttenuation: true,
            blending: THREE.AdditiveBlending
          })
        );
        scene.add(dust);

        // 电影级多光源设置
        const key = new THREE.DirectionalLight(colors.paper, 4.8);
        key.position.set(3.8, 4.8, 6.2);
        scene.add(key);

        const rim = new THREE.DirectionalLight(colors.orange, 2.6);
        rim.position.set(-4.2, 1.2, -2.2);
        scene.add(rim);

        const warm = new THREE.PointLight(colors.orange, 5.8, 14, 2);
        warm.position.set(0, 0.5, 2.4);
        scene.add(warm);

        const fill = new THREE.PointLight(colors.paper, 2.6, 12, 2);
        fill.position.set(-2, 2, 1);
        scene.add(fill);

        // 指针互动
        const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
        const onPointerMove = e => {
          pointer.tx = e.clientX / innerWidth - 0.5;
          pointer.ty = e.clientY / innerHeight - 0.5;
        };
        addEventListener('pointermove', onPointerMove, { passive: true });

        const resize = () => {
          const w = canvas.clientWidth;
          const h = canvas.clientHeight;
          renderer.setSize(w, h, false);
          camera.aspect = w / Math.max(h, 1);
          camera.updateProjectionMatrix();
        };
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(canvas);
        resize();

        let previous = performance.now();
        let started = previous;
        let animation = 0;
        let smoothProgress = 0;
        let smoothPermission = 1;
        let lastBuiltProgress = -1;

        const render = now => {
          animation = requestAnimationFrame(render);
          if (document.hidden) {
            previous = now;
            return;
          }
          const delta = Math.min((now - previous) / 1000 || 0.016, 0.05);
          const elapsed = (now - started) / 1000;
          previous = now;

          smoothProgress += (progress - smoothProgress) * (1 - Math.pow(0.0016, delta));
          smoothPermission += (permission - smoothPermission) * (1 - Math.pow(0.002, delta));
          pointer.x += (pointer.tx - pointer.x) * (1 - Math.pow(0.002, delta));
          pointer.y += (pointer.ty - pointer.y) * (1 - Math.pow(0.002, delta));

          // 核心形态动态重构 (Morphing Geometry Update)
          if (Math.abs(smoothProgress - lastBuiltProgress) > 0.0035) {
            ribbons.forEach(({ mesh, highlight, curve, spec, segments, index }) => {
              const updatedPoints = getInterpolatedPoints(index, smoothProgress);
              curve.points = updatedPoints;
              
              mesh.geometry.dispose();
              mesh.geometry = new THREE.TubeGeometry(curve, segments, spec.r, 10, false);
              
              highlight.geometry.dispose();
              highlight.geometry = new THREE.TubeGeometry(curve, segments, spec.r * 0.36, 8, false);
            });
            lastBuiltProgress = smoothProgress;
          }

          const phase = ease(smoothProgress);
          const stage2 = ease(clamp((phase - 0.16) / 0.32, 0, 1));
          const stage3 = ease(clamp((phase - 0.46) / 0.26, 0, 1));
          const stage4 = ease(clamp((phase - 0.72) / 0.28, 0, 1));
          const breath = Math.sin(elapsed * 0.7) * 0.02;

          // 整体群组视差与位移
          world.position.set(
            pointer.x * 0.28 + Math.sin(phase * Math.PI * 3) * 0.18 + stage3 * 0.22,
            pointer.y * -0.18 + Math.sin(elapsed * 0.42) * 0.035 - stage4 * 0.45,
            -0.36 - stage2 * 0.15 + stage4 * 0.85
          );
          world.rotation.set(
            pointer.y * -0.1 + Math.sin(elapsed * 0.16) * 0.018 + stage3 * 0.14,
            pointer.x * 0.18 + Math.sin(elapsed * 0.13) * 0.028 - stage2 * 0.36 + stage4 * 0.2,
            -0.08 - stage2 * 0.38 + stage4 * 0.22
          );
          world.scale.setScalar((mobile ? 0.72 : 0.86) * (1 + stage2 * 0.18 + stage4 * 0.08));

          // 光晕响应
          glow.material.uniforms.uOpacity.value = (0.045 + stage2 * 0.13 + smoothPermission * 0.06) * (1 - stage4 * 0.68);
          glow.material.uniforms.uPhase.value = stage2 + stage4 * 0.35;
          glow.material.uniforms.uScale.value = 1 + stage2 * 0.8;
          glow.scale.setScalar(1 + stage2 * 0.42 + stage4 * 0.32);

          warm.intensity = 4.0 + stage2 * 4.2 + smoothPermission * 1.8;
          rim.intensity = 1.4 + stage3 * 3.0;

          // 材质透明度与发光过渡
          ribbons.forEach(({ material, highlightMaterial, spec }, i) => {
            material.opacity = spec.o * (0.7 + smoothPermission * 0.3) * (1 - stage4 * 0.42);
            material.emissiveIntensity = spec.emissive + stage2 * 0.28 + smoothPermission * 0.18;
            highlightMaterial.opacity = spec.highlight * (0.55 + smoothPermission * 0.45) * (1 - stage4 * 0.5);
          });

          // 脉冲光点跟随变化后的曲线
          pulses.forEach(({ pulse, curve, offset }, i) => {
            const t = (elapsed * (0.052 + i * 0.011) + offset + stage2 * 0.22 + stage3 * 0.24) % 1;
            pulse.position.copy(curve.getPointAt(t));
            pulse.scale.setScalar((i ? 0.82 : 1) * (1 + stage2 * 0.55 + Math.sin(elapsed * 2.4 + i) * 0.14) * (1 - stage4 * 0.35));
            pulse.material.opacity = (0.34 + smoothPermission * 0.62) * (1 - stage4 * 0.55);
          });

          // 粒子旋转
          dust.rotation.y = elapsed * 0.015 + phase * 0.45;
          dust.rotation.x = Math.sin(elapsed * 0.11) * 0.06 + stage3 * 0.18;

          // 相机推进与拉开 (Cinematic Camera Push & Pull)
          camera.position.set(
            pointer.x * 0.14,
            pointer.y * -0.09,
            7.5 - stage2 * 1.25 + stage4 * 1.75
          );
          camera.lookAt(world.position.x * 0.08, world.position.y + stage3 * 0.08, 0);

          renderer.render(scene, camera);
        };

        root.classList.add('has-webgl');
        animation = requestAnimationFrame(render);

        addEventListener('pagehide', () => {
          cancelAnimationFrame(animation);
          removeEventListener('pointermove', onPointerMove);
          resizeObserver.disconnect();
          ribbons.forEach(({ mesh, highlight, material, highlightMaterial }) => {
            mesh.geometry.dispose();
            material.dispose();
            highlight.geometry.dispose();
            highlightMaterial.dispose();
          });
          pulses.forEach(({ pulse }) => {
            pulse.geometry.dispose();
            pulse.material.dispose();
          });
          dustGeometry.dispose();
          dust.material.dispose();
          glow.geometry.dispose();
          glow.material.dispose();
          renderer.dispose();
        }, { once: true });
      } catch (error) {
        console.warn('Three.js signal field fell back to CSS.', error);
        root.classList.add('webgl-failed');
      }
    };

    requestAnimationFrame(() => void startThree());
  </script>
</body>
</html>
