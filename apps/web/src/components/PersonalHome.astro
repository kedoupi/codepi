---
import { products } from '@kedoupi/shared/products';
---
<script is:inline>document.documentElement.classList.add('home-motion-ready');</script>
<div class="personal-home" data-home>
  <!-- 3D 滚动 Hero -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div id="chapter-01" style="position:absolute;top:0;height:1px;pointer-events:none;"></div>
    <div id="chapter-02" style="position:absolute;top:22%;height:1px;pointer-events:none;"></div>
    <div id="chapter-03" style="position:absolute;top:48%;height:1px;pointer-events:none;"></div>
    <div id="chapter-04" style="position:absolute;top:74%;height:1px;pointer-events:none;"></div>
    <div class="hero-stage">
      <div class="fallback-thread" aria-hidden="true"></div>
      <canvas class="stage-canvas" data-stage-canvas aria-hidden="true"></canvas>

      <div class="hero-copy" data-hero-copy>
        <span class="eyebrow">把自己的数据，交给自己的 AI</span>
        <h1 id="hero-title">
          <span>AI，</span>
          <span class="nowrap">先从<em>你</em>开始。</span>
        </h1>
        <p>它不替你生活。它只从你已经拥有的生活里，慢慢学会靠近。</p>
        <span class="scroll-note">向下，看光线如何凝聚</span>
      </div>

      <div class="scenes" aria-hidden="true">
        <article class="scene active" data-scene></article>
        <article class="scene" data-scene>
          <div class="scene-copy">
            <span class="scene-badge">02 / 汇聚</span>
            <strong>凝聚你的生活上下文。</strong>
            <p>晨起的节律、白天的专注、夜晚的记录。每一个真实的片段，都在这里汇聚成专属你的理解。</p>
          </div>
        </article>
        <article class="scene" data-scene>
          <div class="scene-copy">
            <span class="scene-badge">03 / 授权</span>
            <strong>你决定，它能听见什么。</strong>
            <p>每一次靠近都经过你的允许。没有默认的窥探，只有你授予的边界与信任。</p>
          </div>
        </article>
        <article class="scene last" data-scene>
          <div class="scene-copy">
            <span class="scene-badge">04 / 释放</span>
            <strong>然后，把注意力还给生活。</strong>
            <p>最强大的智能，是在你需要时及时出现，在日常中安静守候。</p>
          </div>
        </article>
      </div>

      <div class="count" aria-hidden="true">
        <strong data-scene-current>01</strong>
        <span>/ 04</span>
      </div>
    </div>
  </section>

  <!-- 暗调哲学过渡 -->
  <section class="dark" aria-labelledby="statement-title">
    <div class="dark-inner" data-reveal>
      <span class="label">安全与主权</span>
      <h2 id="statement-title">不拥有你，<br /><em>才有资格</em>理解你。</h2>
      <p>你的数据不是训练材料，也不是等待被算法切片的燃料。它只是你愿意交出来、并且随时可以收回的真实生活。</p>
    </div>
  </section>

  <!-- 你的一天 Timeline -->
  <section class="day" id="day" aria-labelledby="day-title">
    <div class="width">
      <div class="day-head">
        <div data-reveal>
          <span class="label">连续的生活</span>
          <h2 id="day-title">生活，<br />本就是连续的。</h2>
        </div>
        <p data-reveal style="--delay:100ms">
          醒来、专注、沉淀。每一个片段都属于同一个你，也是明天可以继续的线索。
        </p>
      </div>

      <div class="timeline" data-reveal style="--delay:160ms">
        <article class="moment">
          <span class="moment-time">07:00</span>
          <strong>晨起</strong>
          <p>从身体的节律开始，知道今天的自己在哪里。</p>
        </article>
        <article class="moment">
          <span class="moment-time">14:00</span>
          <strong>专注</strong>
          <p>把手头正在推进的事，放回更长期的思考里。</p>
        </article>
        <article class="moment">
          <span class="moment-time">23:00</span>
          <strong>沉淀</strong>
          <p>让今天的记录与想法，成为明天可以轻松接续的起点。</p>
        </article>
      </div>

      <p class="quote" data-reveal style="--delay:220ms">
        不是把生活交给 AI，<br />
        <em>是让 AI 学会回到生活。</em>
      </p>
    </div>
  </section>

  <!-- 空间列表（当前起点，向未知生长） -->
  <section class="spaces" id="spaces" aria-labelledby="spaces-title">
    <div class="width">
      <div class="spaces-head">
        <div data-reveal>
          <span class="label">现在的起点</span>
          <h2 id="spaces-title">从现在开始，<br />向未知生长。</h2>
        </div>
        <p data-reveal style="--delay:100ms">
          健康、投资、思考、创作——当前的空间只是一个起点。未来你可以加入更多生活维度，它不会预设上限。
        </p>
      </div>

      <div class="space-list" data-reveal style="--delay:160ms">
        {products.map((product, index) => (
          <a href={`/apps/#${product.id}`}>
            <span class="index">{String(index + 1).padStart(2, '0')}</span>
            <strong class="space-name">{product.shortName}</strong>
            <span class="space-description">{product.description}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 交互权限控制区 -->
  <section class="orange" aria-labelledby="permission-title">
    <div class="orange-inner" data-reveal>
      <span class="label">主权归你</span>
      <h2 id="permission-title">靠近，<br />由你决定。</h2>
      <p>点击中央圆环，模拟一次授权与收回。AI 可以离你很近，但决定权必须始终握在你手里。</p>
      <button class="permission-control" type="button" data-permission-toggle aria-pressed="true" aria-label="收回或允许 AI 靠近">
        <span class="permission-core" aria-hidden="true"></span>
      </button>
      <p class="status" role="status" aria-live="polite">
        <span data-permission-status>正在允许 AI 靠近</span>
      </p>
    </div>
  </section>

  <!-- 结尾 Epilogue -->
  <section class="future" aria-labelledby="future-title">
    <div class="width">
      <div class="future-head">
        <div data-reveal>
          <span class="label">属于你的私域智能</span>
          <h2 id="future-title">把自己的数据，<br />交给<em>自己的 AI</em>。</h2>
        </div>
        <p data-reveal style="--delay:100ms">
          让它越来越懂你，也始终把你放在中心。开启属于你的数字化个人世界。
        </p>
      </div>

      <div class="future-rule" data-reveal style="--delay:160ms">
        你的世界越完整，<em>AI 越应该保持克制。</em>
      </div>

      <p class="future-note" data-reveal style="--delay:220ms">
        把自己的数据交给自己的 AI，让它更懂你，但不拥有你。
      </p>

      <div class="actions" data-reveal style="--delay:280ms">
        <a class="primary" href="/apps/">看看现在的空间</a>
        <a class="secondary" href="/about/">了解空间理念</a>
      </div>
    </div>
  </section>

  <script>
    const root = document.documentElement;
    const hero = document.querySelector('[data-hero]');
    const heroCopy = document.querySelector('[data-hero-copy]');
    const scenes = [...document.querySelectorAll('[data-scene]')];
    const sceneCurrent = document.querySelector('[data-scene-current]');
    const reveals = document.querySelectorAll('[data-reveal]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const permissionToggle = document.querySelector('[data-permission-toggle]');
    const permissionStatus = document.querySelector('[data-permission-status]');

    let progress = 0;
    let frame = 0;
    let permission = 1;

    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const ease = v => v * v * (3 - 2 * v);

    function update() {
      if (hero instanceof HTMLElement) {
        const scrollable = hero.offsetHeight - innerHeight;
        const rect = hero.getBoundingClientRect();
        progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;

        // 章节精准激活，消除重叠 ghosting
        let activeIndex = 0;
        if (progress < 0.20) activeIndex = 0;
        else if (progress < 0.46) activeIndex = 1;
        else if (progress < 0.72) activeIndex = 2;
        else activeIndex = 3;

        scenes.forEach((s, i) => s.classList.toggle('active', i === activeIndex));
        if (sceneCurrent) sceneCurrent.textContent = String(activeIndex + 1).padStart(2, '0');


        // 首屏文字淡出（顺滑无残留）
        if (heroCopy instanceof HTMLElement) {
          const heroFade = clamp(1 - (progress - 0.02) / 0.18, 0, 1);
          heroCopy.style.opacity = String(heroFade);
          const isCompactLandscape = innerWidth >= 640 && window.innerHeight < 520 && innerWidth > window.innerHeight;
          const isStackedLayout = innerWidth < 1024 && !isCompactLandscape;
          const heroOffset = isStackedLayout ? '0px' : '-50%';
          heroCopy.style.transform = `translateY(${heroOffset}) translateY(-${(1 - heroFade) * 28}px)`;
          heroCopy.style.pointerEvents = heroFade < 0.05 ? 'none' : 'auto';
          heroCopy.style.visibility = heroFade <= 0.01 ? 'hidden' : 'visible';
        }
      }
      frame = 0;
    }

    function request() {
      if (!frame) frame = requestAnimationFrame(update);
    }

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request, { passive: true });
    update();

    // 观察器
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      reveals.forEach(e => e.classList.add('visible'));
    } else {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(e => observer.observe(e));
    }

    // 授权交互
    permissionToggle?.addEventListener('click', () => {
      permission = permission > 0.5 ? 0 : 1;
      permissionToggle.setAttribute('aria-pressed', String(permission > 0.5));
      if (permissionStatus) {
        permissionStatus.textContent = permission > 0.5
          ? '正在允许 AI 靠近'
          : 'AI 已退回安全边界，等待你的下一次召唤';
      }
    });

    // Three.js 动态光线核心（多设备智能自适应架构）
    const startThree = async () => {
      const canvas = document.querySelector('[data-stage-canvas]');
      if (!(canvas instanceof HTMLCanvasElement) || reduceMotion.matches) return;

      try {
        const THREE = await import('three');
        const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

        let width = canvas.clientWidth || innerWidth;
        let height = canvas.clientHeight || innerHeight;
        let aspect = width / Math.max(height, 1);
        let isCompactLandscape = width >= 640 && height < 520 && width > height;
        let isStacked = width < 1024 && !isCompactLandscape;
        const TAN17 = Math.tan(17 * Math.PI / 180);

        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: 'high-performance'
        });
        renderer.setClearAlpha(0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isStacked ? 1.6 : 2.0));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const scene = new THREE.Scene();
        const baseCamZ = isStacked ? (aspect < 0.65 ? 7.2 : 7.6) : (aspect < 1.3 ? 7.8 : 7.5);
        const camera = new THREE.PerspectiveCamera(34, aspect, 0.1, 40);
        camera.position.z = baseCamZ;

        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
        pmrem.dispose();

        const token = n => getComputedStyle(root).getPropertyValue(n).trim();
        const colors = {
          ink: new THREE.Color(token('--color-text')),
          muted: new THREE.Color(token('--color-text-muted')),
          orange: new THREE.Color(token('--brand-orange')),
          paper: new THREE.Color(token('--color-background'))
        };

        const world = new THREE.Group();
        scene.add(world);

        // 柔和光晕（随布局智能重置在主体 3D 之后）
        const glow = new THREE.Mesh(
          new THREE.PlaneGeometry(8.8, 8.8),
          new THREE.ShaderMaterial({
            transparent: true,
            depthWrite: false,
            depthTest: false,
            blending: THREE.AdditiveBlending,
            uniforms: {
              uColor: { value: colors.orange },
              uOpacity: { value: 0.12 },
              uPhase: { value: 0 },
              uScale: { value: 1 }
            },
            vertexShader: `
              varying vec2 vUv;
              void main(){
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
              }
            `,
            fragmentShader: `
              uniform vec3 uColor;
              uniform float uOpacity;
              uniform float uPhase;
              uniform float uScale;
              varying vec2 vUv;
              void main(){
                vec2 p = (vUv - 0.5) * 2.0;
                float d = length(p * vec2(1.0, 0.72));
                float ring = exp(-pow((d - (0.28 + uPhase * 0.18)) / (0.12 + uPhase * 0.08), 2.0));
                float core = exp(-d * d * (3.6 / uScale));
                float a = (ring * 0.35 + core * 0.65) * uOpacity;
                gl_FragColor = vec4(uColor, a);
              }
            `
          })
        );
        glow.position.set(isStacked ? 0.0 : (isCompactLandscape ? -0.72 : -0.45), isStacked ? 0.38 : 0.10, -1.8);
        world.add(glow);

        // 桌面与平板横屏形态 (双列布局：左侧 3D 光线，右侧文字，各阶段精确安全净空)
        // u in [-1.65, 1.65] (0 = 屏幕中心, -1.0 = 屏幕左边缘, +1.0 = 屏幕右边缘)
        // v in [-1.0, 1.0] (0 = center, +1.0 = top, -1.0 = bottom)
        const DESKTOP_UVZ = [
          // Stage 0: 舒展流动波浪（在左侧低空掠过避开标题与向下提示，右侧昂扬绽放）
          [
            [[-1.65, -0.72, 0.0], [-1.15, -0.73, 0.1], [-0.65, -0.71, 0.2], [-0.15, -0.62, 0.3], [0.35, -0.14, 0.2], [0.80, 0.26, 0.0], [1.25, 0.34, -0.2], [1.65, 0.20, -0.3]],
            [[-1.65, -0.78, -0.2], [-1.12, -0.79, -0.1], [-0.62, -0.77, 0.0], [-0.12, -0.68, 0.1], [0.38, -0.22, -0.1], [0.82, 0.16, -0.3], [1.26, 0.22, -0.4], [1.65, 0.08, -0.5]],
            [[-1.65, -0.84, -0.4], [-1.10, -0.85, -0.2], [-0.60, -0.83, -0.1], [-0.10, -0.74, -0.1], [0.40, -0.30, -0.3], [0.85, 0.04, -0.5], [1.28, 0.08, -0.6], [1.65, -0.04, -0.6]]
          ],
          // Stage 1: 02 / 汇聚（扭结紧密收敛于左半球 u <= -0.15，右侧尾线直接下潜至底端 v <= -0.82 出屏）
          [
            [[-1.65, -0.42, -0.4], [-0.95, 0.48, 0.2], [-0.55, -0.38, 0.9], [-0.22, 0.42, 0.6], [-0.48, -0.35, 0.1], [-0.78, 0.25, -0.5], [0.15, -0.82, -1.0], [1.65, -0.85, -1.4]],
            [[-1.65, -0.48, -0.5], [-0.90, -0.42, 0.1], [-0.50, 0.44, 0.6], [-0.18, -0.38, 0.5], [-0.42, 0.30, 0.0], [-0.75, -0.32, -0.6], [0.18, -0.85, -1.1], [1.65, -0.88, -1.5]],
            [[-1.65, -0.54, -0.6], [-0.98, 0.05, 0.0], [-0.60, -0.46, 0.4], [-0.25, -0.12, 0.3], [-0.40, 0.42, -0.1], [-0.80, 0.06, -0.7], [0.22, -0.88, -1.2], [1.65, -0.92, -1.6]]
          ],
          // Stage 2: 03 / 授权（在左半球空间景深绽放，深度 z 到达 1.2，右侧尾线下潜底端完全不遮挡文字）
          [
            [[-1.65, -0.28, -0.6], [-0.95, 0.54, 0.5], [-0.58, 0.62, 1.2], [-0.22, 0.36, 0.7], [-0.45, -0.25, -0.3], [-0.12, -0.72, -0.9], [0.35, -0.84, -1.3], [1.65, -0.88, -1.6]],
            [[-1.65, -0.38, -0.5], [-0.88, -0.48, -0.7], [-0.52, -0.56, -1.4], [-0.18, -0.42, -1.5], [-0.40, 0.20, -1.0], [-0.10, -0.76, -1.1], [0.38, -0.88, -1.5], [1.65, -0.92, -1.7]],
            [[-1.65, -0.32, -0.6], [-0.92, 0.05, -0.3], [-0.55, 0.08, -0.2], [-0.20, 0.04, -0.3], [-0.38, -0.10, -0.4], [-0.08, -0.80, -1.0], [0.40, -0.90, -1.4], [1.65, -0.94, -1.8]]
          ],
          // Stage 3: 04 / 释放（静谧地平线，退向远方深处，在视野低空平缓伸展）
          [
            [[-1.65, -0.68, -2.2], [-1.05, -0.69, -2.3], [-0.45, -0.67, -2.4], [0.15, -0.70, -2.4], [0.75, -0.68, -2.3], [1.20, -0.69, -2.2], [1.65, -0.68, -2.2], [1.85, -0.68, -2.2]],
            [[-1.65, -0.74, -2.5], [-1.02, -0.76, -2.6], [-0.42, -0.73, -2.7], [0.18, -0.76, -2.7], [0.78, -0.74, -2.6], [1.22, -0.75, -2.5], [1.65, -0.74, -2.5], [1.85, -0.74, -2.5]],
            [[-1.65, -0.80, -2.8], [-1.00, -0.82, -2.9], [-0.40, -0.79, -3.0], [0.20, -0.82, -3.0], [0.80, -0.80, -2.9], [1.25, -0.81, -2.8], [1.65, -0.80, -2.8], [1.85, -0.80, -2.8]]
          ]
        ];

        // 移动端与平板竖屏单列布局形态 (上半部 3D 艺术形态，下半部卡片绝对净空)
        const MOBILE_UVZ = [
          // Stage 0: 纵向流动波浪（斜穿手机中下部 v in [-0.60, -0.30]，托起顶部大标题）
          [
            [[-1.60, -0.58, 0.0], [-1.10, -0.48, 0.1], [-0.60, -0.38, 0.2], [-0.15, -0.32, 0.3], [0.25, -0.38, 0.2], [0.70, -0.46, 0.0], [1.15, -0.36, -0.2], [1.60, -0.30, -0.3]],
            [[-1.60, -0.65, -0.2], [-1.08, -0.55, -0.1], [-0.58, -0.45, 0.0], [-0.12, -0.40, 0.1], [0.28, -0.46, -0.1], [0.72, -0.54, -0.2], [1.18, -0.44, -0.3], [1.60, -0.38, -0.4]],
            [[-1.60, -0.72, -0.4], [-1.05, -0.62, -0.2], [-0.55, -0.52, -0.1], [-0.10, -0.48, -0.1], [0.30, -0.54, -0.2], [0.75, -0.62, -0.4], [1.20, -0.52, -0.5], [1.60, -0.46, -0.5]]
          ],
          // Stage 1: 紧凑光环扭结在屏幕上半部（v in [0.20, 0.70]，下半部为卡片留足绝对净空）
          [
            [[-1.60, 0.24, -0.4], [-0.95, 0.44, 0.0], [-0.55, 0.66, 0.3], [-0.15, 0.34, 0.9], [0.18, 0.68, 0.7], [0.55, 0.38, 0.1], [0.95, 0.50, -0.3], [1.60, 0.26, -0.6]],
            [[-1.60, 0.18, -0.5], [-0.90, 0.38, -0.1], [-0.50, 0.60, 0.2], [-0.12, 0.28, 0.6], [0.22, 0.60, 0.5], [0.52, 0.30, 0.0], [0.92, 0.42, -0.4], [1.60, 0.20, -0.7]],
            [[-1.60, 0.12, -0.6], [-0.85, 0.32, -0.2], [-0.45, 0.54, 0.1], [-0.10, 0.22, 0.4], [0.25, 0.52, 0.3], [0.50, 0.24, -0.1], [0.90, 0.36, -0.5], [1.60, 0.14, -0.8]]
          ],
          // Stage 2: 空间纵深绽放（在屏幕上半部景深内绽放，v in [0.18, 0.74]）
          [
            [[-1.60, 0.24, -0.6], [-0.95, 0.50, 0.0], [-0.50, 0.70, 0.5], [-0.10, 0.74, 1.2], [0.25, 0.60, 0.8], [0.60, 0.34, -0.2], [0.95, 0.48, -0.7], [1.60, 0.22, -1.2]],
            [[-1.60, 0.18, -0.5], [-0.90, 0.44, -0.2], [-0.45, 0.62, 0.3], [-0.08, 0.66, 0.9], [0.28, 0.52, 0.5], [0.58, 0.27, -0.4], [0.92, 0.40, -0.8], [1.60, 0.16, -1.3]],
            [[-1.60, 0.12, -0.6], [-0.85, 0.38, -0.3], [-0.40, 0.54, 0.1], [-0.05, 0.58, 0.6], [0.30, 0.44, 0.3], [0.55, 0.20, -0.5], [0.90, 0.32, -0.9], [1.60, 0.10, -1.4]]
          ],
          // Stage 3: 平缓地平线（悬停在底部卡片上方，v in [0.10, 0.23]）
          [
            [[-1.60, 0.20, -2.2], [-1.10, 0.22, -2.3], [-0.60, 0.21, -2.4], [-0.15, 0.23, -2.4], [0.25, 0.20, -2.3], [0.70, 0.22, -2.3], [1.15, 0.21, -2.2], [1.60, 0.20, -2.2]],
            [[-1.60, 0.15, -2.5], [-1.10, 0.17, -2.6], [-0.60, 0.16, -2.7], [-0.15, 0.18, -2.7], [0.25, 0.15, -2.6], [0.70, 0.17, -2.6], [1.15, 0.16, -2.5], [1.60, 0.15, -2.5]],
            [[-1.60, 0.10, -2.8], [-1.10, 0.12, -2.9], [-0.60, 0.11, -3.0], [-0.15, 0.13, -3.0], [0.25, 0.10, -2.9], [0.70, 0.12, -2.9], [1.15, 0.11, -2.8], [1.60, 0.10, -2.8]]
          ]
        ];

        function getInterpolatedPoints(ribbonIdx, progressVal, isStackedMode) {
          const p = clamp(progressVal, 0, 1);
          const numStages = 4;
          const segment = p * (numStages - 1);
          const idx = Math.min(Math.floor(segment), numStages - 2);
          const rawT = segment - idx;
          const t = rawT * rawT * (3 - 2 * rawT);

          const keyframes = isStackedMode ? MOBILE_UVZ : DESKTOP_UVZ;
          const from = keyframes[idx][ribbonIdx];
          const to = keyframes[idx + 1][ribbonIdx];

          const camZ = isStackedMode ? (aspect < 0.65 ? 7.2 : 7.6) : (aspect < 1.3 ? 7.8 : 7.5);

          return from.map((ptA, i) => {
            const ptB = to[i];

            const uScale = !isStackedMode && isCompactLandscape ? 0.65 : 1;
            const u = (ptA[0] + (ptB[0] - ptA[0]) * t) * uScale;
            const v = ptA[1] + (ptB[1] - ptA[1]) * t;
            const z = ptA[2] + (ptB[2] - ptA[2]) * t;

            // 动态视锥映射：两端无论超宽屏还是窄屏设备，都无损贯穿画面边缘
            const dist = camZ - z;
            const halfH = dist * TAN17;
            const halfW = halfH * aspect;
            return new THREE.Vector3(u * halfW, v * halfH, z);
          });
        }

        const specs = [
          { y: 0.12, z: 0.15, c: colors.orange, r: 0.040, o: 0.96, emissive: 0.28, highlight: 0.78 },
          { y: -0.05, z: 0.02, c: colors.ink, r: 0.020, o: 0.32, emissive: 0.06, highlight: 0.22 },
          { y: -0.22, z: -0.10, c: colors.muted, r: 0.014, o: 0.34, emissive: 0.05, highlight: 0.24 }
        ];

        const ribbons = [];
        const pulses = [];

        specs.forEach((spec, index) => {
          const initialPoints = getInterpolatedPoints(index, 0, isStacked);
          const curve = new THREE.CatmullRomCurve3(initialPoints, false, 'centripetal', 0.5);
          const segments = isStacked ? 80 : 128;
          const dynamicR = spec.r * (isStacked ? 0.88 : 1.0);
          const tubeGeometry = new THREE.TubeGeometry(curve, segments, dynamicR, 10, false);

          const material = new THREE.MeshPhysicalMaterial({
            color: spec.c,
            roughness: index ? 0.18 : 0.14,
            metalness: index ? 0.35 : 0.22,
            clearcoat: 1.0,
            clearcoatRoughness: 0.05,
            ior: 1.48,
            iridescence: index ? 0.08 : 0.3,
            iridescenceIOR: 1.32,
            emissive: spec.c,
            emissiveIntensity: spec.emissive,
            transparent: true,
            opacity: spec.o,
            depthWrite: false
          });

          const mesh = new THREE.Mesh(tubeGeometry, material);

          // 白色高光核心细丝
          const highlightMaterial = new THREE.MeshPhysicalMaterial({
            color: colors.paper,
            roughness: 0.05,
            metalness: 0.1,
            clearcoat: 1.0,
            emissive: colors.paper,
            emissiveIntensity: 0.85,
            transparent: true,
            opacity: spec.highlight,
            depthWrite: false
          });
          const highlightGeometry = new THREE.TubeGeometry(curve, segments, dynamicR * 0.36, 8, false);
          const highlight = new THREE.Mesh(highlightGeometry, highlightMaterial);

          world.add(mesh, highlight);
          ribbons.push({ mesh, highlight, curve, material, highlightMaterial, spec, segments, index });

          // 移动脉冲光点（Apple 级灵动光子，AdditiveBlending 无硬质乒乓球感）
          const pulse = new THREE.Mesh(
            new THREE.SphereGeometry(index === 0 ? 0.042 : 0.026, 16, 12),
            new THREE.MeshBasicMaterial({
              color: index === 0 ? colors.orange : colors.ink,
              transparent: true,
              opacity: index === 0 ? 0.95 : 0.35,
              depthWrite: false
            })
          );
          world.add(pulse);
          pulses.push({ pulse, curve, offset: index * 0.28 });
        });

        // 粒子尘埃
        const dustCount = isStacked ? 100 : 220;
        const positions = new Float32Array(dustCount * 3);
        for (let i = 0; i < dustCount; i++) {
          positions[i * 3] = Math.sin(i * 2.41) * (isStacked ? 2.6 : 5.2);
          positions[i * 3 + 1] = Math.cos(i * 1.73) * (isStacked ? 3.4 : 2.8);
          positions[i * 3 + 2] = Math.sin(i * 0.91) * 2.2 - 0.7;
        }
        const dustGeometry = new THREE.BufferGeometry();
        dustGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const dust = new THREE.Points(
          dustGeometry,
          new THREE.PointsMaterial({
            color: colors.orange,
            size: isStacked ? 0.015 : 0.016,
            transparent: true,
            opacity: 0.24,
            depthWrite: false,
            blending: THREE.AdditiveBlending
          })
        );
        world.add(dust);

        // 柔和主灯
        const key = new THREE.DirectionalLight(0xffffff, 2.8);
        key.position.set(4, 5, 6);
        scene.add(key);

        const fill = new THREE.DirectionalLight(colors.orange, 1.6);
        fill.position.set(-4, -2, -2);
        scene.add(fill);

        const rim = new THREE.DirectionalLight(0xffffff, 2.2);
        rim.position.set(0, -5, 3);
        scene.add(rim);

        // 视差跟踪
        const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
        const onPointerMove = e => {
          pointer.tx = e.clientX / innerWidth - 0.5;
          pointer.ty = e.clientY / innerHeight - 0.5;
        };
        addEventListener('pointermove', onPointerMove, { passive: true });

        let previous = performance.now();
        let started = previous;
        let animation = 0;
        let smoothProgress = 0;
        let smoothPermission = 1;
        let lastBuiltProgress = -1;
        let lastBuiltStacked = isStacked;
        let isHeroVisible = true;

        const resize = () => {
          width = canvas.clientWidth || innerWidth;
          height = canvas.clientHeight || innerHeight;
          if (!width || !height) return;

          aspect = width / height;
          isCompactLandscape = width >= 640 && height < 520 && width > height;
          const newIsStacked = width < 1024 && !isCompactLandscape;
          const layoutChanged = newIsStacked !== isStacked;
          isStacked = newIsStacked;

          renderer.setSize(width, height, false);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isStacked ? 1.6 : 2.0));

          camera.aspect = aspect;
          const baseZ = isStacked ? (aspect < 0.65 ? 7.2 : 7.6) : (aspect < 1.3 ? 7.8 : 7.5);
          camera.position.z = baseZ;
          camera.updateProjectionMatrix();

          glow.position.set(isStacked ? 0.0 : (isCompactLandscape ? -0.72 : -0.45), isStacked ? 0.38 : 0.10, -1.8);

          if (layoutChanged) {
            lastBuiltProgress = -1;
          }
        };
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(canvas);
        const heroVisibilityObserver = new IntersectionObserver(([entry]) => {
          isHeroVisible = entry.isIntersecting;
          if (!isHeroVisible && animation) {
            cancelAnimationFrame(animation);
            animation = 0;
          } else if (isHeroVisible && !animation) {
            previous = performance.now();
            animation = requestAnimationFrame(render);
          }
        });
        heroVisibilityObserver.observe(hero);
        resize();

        const render = now => {
          if (!isHeroVisible) {
            animation = 0;
            return;
          }
          animation = requestAnimationFrame(render);
          if (document.hidden) {
            previous = now;
            return;
          }
          const delta = Math.min((now - previous) / 1000 || 0.016, 0.05);
          const elapsed = (now - started) / 1000;
          previous = now;

          smoothProgress += (progress - smoothProgress) * (1 - Math.pow(0.0016, delta));
          smoothPermission += (permission - smoothPermission) * (1 - Math.pow(0.002, delta));
          pointer.x += (pointer.tx - pointer.x) * (1 - Math.pow(0.002, delta));
          pointer.y += (pointer.ty - pointer.y) * (1 - Math.pow(0.002, delta));

          // 智能微动视差（触屏设备与无指针交互时保持呼吸生机感）
          const ambientDriftX = Math.sin(elapsed * 0.42) * 0.08;
          const ambientDriftY = Math.cos(elapsed * 0.35) * 0.05;
          const interactiveX = pointer.x + ambientDriftX;
          const interactiveY = pointer.y + ambientDriftY;

          // 核心形态动态重构 (当滚动进度变化或布局模式切换时)
          if (Math.abs(smoothProgress - lastBuiltProgress) >= 0.01 || lastBuiltStacked !== isStacked) {
            ribbons.forEach(({ mesh, highlight, curve, spec, segments, index }) => {
              const updatedPoints = getInterpolatedPoints(index, smoothProgress, isStacked);
              curve.points = updatedPoints;

              const dynamicR = spec.r * (isStacked ? 0.88 : 1.0);
              mesh.geometry.dispose();
              mesh.geometry = new THREE.TubeGeometry(curve, segments, dynamicR, 10, false);

              highlight.geometry.dispose();
              highlight.geometry = new THREE.TubeGeometry(curve, segments, dynamicR * 0.36, 8, false);
            });
            lastBuiltProgress = smoothProgress;
            lastBuiltStacked = isStacked;
          }

          const phase = ease(smoothProgress);
          const stage2 = ease(clamp((phase - 0.16) / 0.32, 0, 1));
          const stage3 = ease(clamp((phase - 0.46) / 0.26, 0, 1));
          const stage4 = ease(clamp((phase - 0.72) / 0.28, 0, 1));

          // 整体群组视差与位移（温和克制微动，不破坏坐标系安全净空区）
          world.position.set(
            interactiveX * 0.12,
            interactiveY * -0.08,
            -0.25 - stage2 * 0.12 + stage4 * 0.45
          );
          world.rotation.set(
            interactiveY * -0.04 + Math.sin(elapsed * 0.15) * 0.012,
            interactiveX * 0.06 + Math.sin(elapsed * 0.13) * 0.018,
            -0.03 + Math.sin(elapsed * 0.10) * 0.008
          );
          world.scale.setScalar(1.0);

          // 光晕响应
          glow.material.uniforms.uOpacity.value = (0.045 + stage2 * 0.13 + smoothPermission * 0.06) * (1 - stage4 * 0.68);
          glow.material.uniforms.uPhase.value = stage2 + stage4 * 0.35;
          glow.material.uniforms.uScale.value = 1 + stage2 * 0.8;
          glow.scale.setScalar(1 + stage2 * 0.42 + stage4 * 0.32);

          key.intensity = 2.8 + stage2 * 0.6;
          fill.intensity = 1.6 + stage2 * 1.2 + smoothPermission * 0.8;
          rim.intensity = 1.4 + stage3 * 1.8;

          // 材质透明度与发光过渡
          ribbons.forEach(({ material, highlightMaterial, spec }) => {
            material.opacity = spec.o * (0.7 + smoothPermission * 0.3) * (1 - stage4 * 0.42);
            material.emissiveIntensity = spec.emissive + stage2 * 0.28 + smoothPermission * 0.18;
            highlightMaterial.opacity = spec.highlight * (0.55 + smoothPermission * 0.45) * (1 - stage4 * 0.5);
          });

          // 脉冲光点跟随变化后的曲线
          pulses.forEach(({ pulse, curve, offset }, i) => {
            const rawT = (elapsed * (0.052 + i * 0.011) + offset + stage2 * 0.22 + stage3 * 0.24) % 1;
            if (!Number.isFinite(rawT)) return;
            pulse.position.copy(curve.getPoint(clamp(rawT, 0, 0.999999)));
            pulse.scale.setScalar((i ? 0.85 : 1) * (1 + Math.sin(elapsed * 3.2 + i * 1.5) * 0.16) * (1 - stage4 * 0.35));
            pulse.material.opacity = (0.55 + smoothPermission * 0.40) * (1 - stage4 * 0.5);
          });

          // 粒子旋转
          dust.rotation.y = elapsed * 0.015 + phase * 0.45;
          dust.rotation.x = Math.sin(elapsed * 0.11) * 0.06 + stage3 * 0.18;

          // 相机推进与拉开 (Cinematic Camera Push & Pull)
          const currentCamZ = isStacked ? (aspect < 0.65 ? 7.2 : 7.6) : (aspect < 1.3 ? 7.8 : 7.5);
          camera.position.set(
            interactiveX * 0.12,
            interactiveY * -0.08,
            currentCamZ - stage2 * 1.25 + stage4 * 1.75
          );
          camera.lookAt(world.position.x * 0.06, world.position.y + stage3 * 0.08, 0);

          renderer.render(scene, camera);
        };

        root.classList.add('has-webgl');
        animation = requestAnimationFrame(render);

        canvas.addEventListener('webglcontextlost', event => {
          event.preventDefault();
          cancelAnimationFrame(animation);
          animation = 0;
          root.classList.remove('has-webgl');
          root.classList.add('webgl-failed');
        });
        addEventListener('pagehide', () => {
          cancelAnimationFrame(animation);
          animation = 0;
          heroVisibilityObserver.disconnect();
          removeEventListener('pointermove', onPointerMove);
          resizeObserver.disconnect();
          ribbons.forEach(({ mesh, highlight, material, highlightMaterial }) => {
            mesh.geometry.dispose();
            material.dispose();
            highlight.geometry.dispose();
            highlightMaterial.dispose();
          });
          pulses.forEach(({ pulse }) => {
            pulse.geometry.dispose();
            pulse.material.dispose();
          });
          dustGeometry.dispose();
          dust.material.dispose();
          glow.geometry.dispose();
          glow.material.dispose();
          renderer.dispose();
        }, { once: true });
      } catch (error) {
        console.warn('Three.js signal field fell back to CSS.', error);
        root.classList.add('webgl-failed');
      }
    };

    requestAnimationFrame(() => void startThree());
  </script>
</div>

