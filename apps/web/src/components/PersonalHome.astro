---
import '../styles/home.css';

const solar = [
  [110, '07:10 醒来', '--state-sleep', 5, 0.10],
  [170, '读书笔记', '--state-home', 6, 0.62],
  [235, '晨跑 5 公里', '--state-away', 5, 0.30],
  [235, '项目交接', '--state-desk', 7, 0.80],
  [310, '下午的会', '--state-meeting', 6, 0.05],
  [385, '回家路上', '--state-commute', 5, 0.45],
  [465, '一笔复盘', '--state-out', 6, 0.70],
  [465, '睡前的想法', '--state-sleep', 4, 0.20],
] as const;
const solarOrbits = [110, 170, 235, 310, 385, 465];
const solarDesktop = { width: 1200, height: 560, cx: 600, cy: 280, scale: 1 };
const gateSize = 400;
const gateCenter = gateSize / 2;
const gateLines = Array.from({ length: 18 }, (_, index) => {
  const angle = (index * 20 + 5) * Math.PI / 180;
  const allowed = [2, 9, 14].includes(index);
  const outer = gateCenter * (index % 2 ? 0.98 : 0.84);
  const inner = allowed ? 0 : gateCenter * 0.64;
  return {
    index,
    allowed,
    x1: gateCenter + outer * Math.cos(angle),
    y1: gateCenter + outer * Math.sin(angle),
    x2: gateCenter + inner * Math.cos(angle),
    y2: gateCenter + inner * Math.sin(angle),
  };
});
const schedule = [
  ['430', '--state-sleep'], ['55', '--state-home'], ['50', '--state-commute'],
  ['195', '--state-desk'], ['50', '--state-away'], ['60', '--state-desk'],
  ['60', '--state-meeting'], ['120', '--state-desk'], ['50', '--state-commute'],
  ['240', '--state-home'], ['130', '--state-sleep'],
] as const;
const dataCards = [
  { title: '作息', copy: '几点醒来、几点专注、几点离开。', kind: 'schedule' },
  { title: '健康', copy: '睡眠、心率与恢复，身体每天的节律。', kind: 'health' },
  { title: '项目', copy: '正在推进的事、交接与进展。', kind: 'project' },
  { title: '记忆', copy: '经你确认过的偏好、背景与经历。', kind: 'memory' },
] as const;
---

<div class="personal-home" data-home>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-wrap home-hero-copy">
      <p class="home-eyebrow">把自己的数据，交给自己的 AI</p>
      <h1 id="home-hero-title" class="home-display">AI，先从你开始。</h1>
      <p class="home-lead">它不替你生活。它只从你已经拥有的生活里，慢慢学会靠近。</p>
      <div class="home-actions">
        <a href="/blog/">读读写下来的</a>
        <a href="/about/">了解这里的理念</a>
      </div>
    </div>
    <div class="home-vortex-frame">
      <canvas data-vortex aria-label="示意：无数细线从四面八方螺旋汇向中心的你和你的 AI"></canvas>
    </div>
    <p class="home-caption home-wrap">世界的光，流向你，也流向你的 AI · 示意</p>
  </section>

  <section class="home-section home-data" data-enter-animation aria-labelledby="home-data-title">
    <div class="home-wrap">
      <h2 id="home-data-title" class="home-two-tone"><span>你的 AI，读的是你的生活。</span><span>作息、健康、项目、记忆，这些本来就是你的数据。先留在自己手里，再交给自己的 AI。</span></h2>
      <div class="home-data-grid">
        {dataCards.map((card) => (
          <article class="home-data-card">
            <div class:list={['home-data-visual', `home-data-visual--${card.kind}`]} aria-hidden="true">
              {card.kind === 'schedule' && <div class="home-schedule">{schedule.map(([size, color]) => <i style={`flex:${size};background:var(${color})`}></i>)}</div>}
              {card.kind === 'health' && <div class="home-health">{[62, 74, 55, 80, 68, 71, 86].map((height) => <i style={`height:${height}%`}></i>)}</div>}
              {(card.kind === 'project' || card.kind === 'memory') && <div class="home-progress-list">{(card.kind === 'project' ? [78, 56, 68, 44] : [84, 62, 72]).map((width, index) => <i><b class:list={{ 'is-done': card.kind === 'memory' || index < 2 }}></b><em style={`width:${width}%`}></em></i>)}</div>}
            </div>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
      <p class="home-caption">图形为示例数据。每一种数据都要你授权，AI 才能读到。</p>
    </div>
  </section>

  <section class="home-section home-continuity" data-solar-section aria-labelledby="home-continuity-title">
    <div class="home-wrap">
      <h2 id="home-continuity-title" class="home-two-tone"><span>生活，本就是连续的。</span><span>醒来、专注、沉淀，每一个片段都属于同一个你，也是明天可以继续的线索。</span></h2>
      <svg class="home-solar" data-solar viewBox="0 0 1200 560" data-mobile-viewbox="0 0 390 300" role="img" aria-label="示意：你在中心，生活里的片段像行星一样绕你运行">
        <g data-solar-orbits transform="rotate(19.3 600 280)">
          {solarOrbits.map((radius) => <ellipse data-orbit={radius} cx="600" cy="280" rx={radius} ry={radius * 0.34} />)}
        </g>
        <circle class="home-solar-glow" cx="600" cy="280" r="49" aria-hidden="true"></circle>
        <circle class="home-solar-core" cx="600" cy="280" r="26" aria-hidden="true"></circle>
        <text class="home-solar-you" x="600" y="347" text-anchor="middle">你</text>
        {solar.map(([radius, label, color, planetRadius, phase]) => (
          <g data-solar-planet data-a={radius} data-period={9 * (radius / 110) ** 1.5} data-phase={phase} data-scale={solarDesktop.scale} transform={`translate(${solarDesktop.cx + Math.cos(phase * Math.PI * 2) * radius} ${solarDesktop.cy + Math.sin(phase * Math.PI * 2) * radius * 0.34})`}>
            <circle r={planetRadius} fill={`var(${color})`} />
            <text x={planetRadius + 8} y="4">{label}</text>
          </g>
        ))}
      </svg>
      <p class="home-caption home-caption--center">你在中心，生活的片段绕你运行 · 图中片段为示例</p>
    </div>
  </section>

  <section class="home-section home-words" data-glyph-section aria-labelledby="home-words-title">
    <div class="home-wrap home-center">
      <h2 id="home-words-title" class="home-display home-words-title">汇聚。授权。释放。</h2>
      <div class="home-words-grid">
        <article>
          <svg class="home-glyph" viewBox="0 0 120 120" aria-hidden="true"><path d="M18 18 Q42 42 60 60 M102 24 Q82 46 60 60 M104 96 Q80 78 60 60 M48 108 Q52 78 60 60 M12 78 Q38 66 60 60 M28 30 Q50 36 60 60" /><circle cx="60" cy="60" r="6" /></svg>
          <h3>汇聚</h3>
          <p>晨起的节律、白天的专注、夜晚的记录，汇成只属于你的理解。</p>
        </article>
        <article>
          <svg class="home-glyph" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="30" class="home-glyph-boundary" /><path d="M18 18 L48 44 M102 24 L66 54 M104 96 L74 76 M48 108 L54 78 M12 78 L50 64 M28 30 L44 46" /><circle cx="60" cy="60" r="6" /></svg>
          <h3>授权</h3>
          <p>每一次靠近都经过你的允许。没有默认的窥探，只有你划下的边界。</p>
        </article>
        <article>
          <svg class="home-glyph home-glyph-release" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="24" /><circle cx="60" cy="60" r="38" /><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="6" /></svg>
          <h3>释放</h3>
          <p>在你需要时出现，在日常里安静守候，把注意力还给生活。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section home-boundary" data-boundary-section aria-labelledby="home-boundary-title">
    <div class="home-wrap home-center">
      <h2 id="home-boundary-title" class="home-display">不拥有你，</h2>
      <p class="home-display home-display-muted">才有资格理解你。</p>
      <p class="home-lead">你的数据不是训练材料。它只是你愿意交出来、并且随时可以收回的真实生活。</p>
      <svg class="home-gate" viewBox="0 0 400 400" aria-hidden="true">
        <circle class="home-gate-boundary" cx="200" cy="200" r="120" />
        {gateLines.map((line) => <line class:list={['home-gate-line', { 'home-gate-line--allowed': line.allowed }]} data-allowed={line.allowed ? 'true' : 'false'} x1={line.x1.toFixed(1)} y1={line.y1.toFixed(1)} x2={line.x2.toFixed(1)} y2={line.y2.toFixed(1)} />)}
        <circle class="home-gate-core" cx="200" cy="200" r="12" />
      </svg>
      <p class="home-boundary-note">边界之外的，停在边界外。只有你允许的，才会抵达。</p>
    </div>
  </section>

  <section class="home-section home-blog" data-blog-section hidden aria-labelledby="home-blog-title">
    <div class="home-wrap">
      <div class="home-blog-head">
        <p id="home-blog-title" class="home-eyebrow">写下来的</p>
        <a href="/blog/">所有文章</a>
      </div>
      <div data-blog-feature></div>
      <div data-blog-secondary></div>
    </div>
  </section>

  <section class="home-section home-closing" aria-labelledby="home-closing-title">
    <div class="home-wrap home-center">
      <div class="home-closing-mark" aria-hidden="true"><span></span><b>π</b></div>
      <h2 id="home-closing-title" class="home-display">把自己的数据，<br />交给自己的 AI。</h2>
      <p class="home-lead">你的世界越完整，AI 越应该保持克制。让它更懂你，但不拥有你。</p>
      <div class="home-actions">
        <a href="/blog/">读读写下来的</a>
        <a href="/desk/">进入我的工作台</a>
      </div>
    </div>
  </section>
</div>

<script>
  import '../scripts/home/index.ts';
</script>
