{
  "name": "kdp-gu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private investment dashboard",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8791",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "vitest run",
    "test:scripts": "node --test scripts/check-deploy-regression.mjs scripts/check-sync-status.mjs",
    "db:local": "wrangler d1 migrations apply codepi-gu --local",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "latest",
    "@kedoupi/shared": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.2.8",
    "jsdom": "^30.1.3",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.37.0"
  }
}
