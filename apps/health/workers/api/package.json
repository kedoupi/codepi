{
  "name": "@health-kdp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "CI=true wrangler d1 migrations apply codepi-health --local",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "pnpm build && node --test test/integration/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@kedoupi/shared": "workspace:*",
    "hono": "^4.9.8",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
