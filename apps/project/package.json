{
  "name": "kdp-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private project board and CodePi Project MCP domain",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8795",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "deploy": "pnpm build && node ../../scripts/cloudflare/deploy-domain.mjs --app project",
    "db:local": "wrangler d1 migrations apply codepi-project --local"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "latest",
    "@kedoupi/shared": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.2.8",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.6",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1"
  }
}
