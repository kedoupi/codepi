{
  "name": "publish-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "珂抖屁公众号一期：稿件、预览与审核工作台",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8788",
    "dev:ui": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.web.json --config ./web/svelte.config.js --tsgo",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply codepi-gzh --local",
    "db:migrate:remote": "wrangler d1 migrations apply codepi-gzh --remote"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "latest",
    "@kedoupi/shared": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.2.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.38.6",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
