{
  "name": "@codepi/mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply codepi-mcp --local",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "test": "pnpm --filter @health-kdp/api build && pnpm --filter @kedoupi/codepi build && pnpm build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser:built": "node test/browser.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@kedoupi/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
