{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codepi-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  },
  "workers_dev": false,
  "rules": [{ "type": "Text", "globs": ["**/tokens.css"], "fallthrough": true }],
  "routes": [{ "pattern": "auth.codepi.app", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_ORIGIN": "https://auth.codepi.app",
    "SSO_EXTRA_REDIRECT_URIS": "{\"gu\":[\"https://gu.kdp.cool/api/auth/callback\",\"https://gu.codepi.app/api/auth/callback\"],\"oura\":[\"https://health.kdp.cool/api/auth/callback\",\"https://health.codepi.app/api/auth/callback\"],\"gzh\":[\"https://gzh.codepi.app/api/auth/callback\"],\"desk\":[\"https://kdp.cool/api/auth/callback\",\"https://codepi.app/api/auth/callback\"],\"project\":[\"https://project.codepi.app/api/auth/callback\"],\"me\":[\"https://me.codepi.app/api/auth/callback\"]}"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "codepi-auth",
    "database_id": "ecc90eed-e9ff-459d-99aa-4e7f4c6d6ef1",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 3 * * *"] }
}
