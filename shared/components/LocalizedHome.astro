---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import AdSense from '@shared/components/AdSense.astro';
import { localizedPath } from '@shared/i18n/config.js';
import { getHomeContent, localeChrome, siteMeta } from '@shared/i18n/home-content.js';

interface Props {
  siteKey: 'web' | 'calc' | 'convert' | 'text' | 'dev' | 'ai';
  locale: string;
}

const { siteKey, locale } = Astro.props;
const meta = siteMeta[siteKey];
const copy = getHomeContent(siteKey, locale);
const chrome = localeChrome[locale];
const adPrefix = meta.adSlotPrefix;
const isPortal = siteKey === 'web';

const toolHref = (href) => {
  if (href.startsWith('http')) return href;
  if (locale === 'zh') return `${href}?lang=zh`;
  return href;
};
---
<BaseLayout
  title={copy.title}
  description={copy.description}
  pathname={localizedPath('/', locale)}
  schemaType={meta.schemaType}
  locale={locale}
  robots="noindex, follow"
>
  <section class={isPortal ? 'grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]' : 'mb-10 max-w-4xl space-y-4'}>
    <div class="max-w-4xl">
      <p class="kdp-section-label mb-4">{copy.label}</p>
      <h1 class="text-5xl font-semibold leading-[1.02] sm:text-6xl lg:text-7xl">{copy.heading}</h1>
      <p class="mt-6 max-w-3xl text-xl leading-8 text-stone-700">{copy.intro}</p>
      <p class="mt-4 max-w-3xl text-stone-600 leading-7">{copy.note}</p>
    </div>
    {isPortal && (
      <figure class="relative">
        <div class="absolute -inset-4 rounded-[2rem] bg-[#f3eadc]/70 blur-2xl" aria-hidden="true"></div>
        <img
          src="/toolbench.svg"
          alt=""
          width="960"
          height="640"
          class="relative w-full rounded-[1.75rem] border border-[#e6d9c8] bg-white shadow-[0_20px_60px_rgba(92,64,36,0.14)]"
        />
      </figure>
    )}
  </section>

  <AdSense adSlot={`${adPrefix}-top`} style="min-height:90px" />

  <section class="mt-10">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="kdp-section-label">{copy.collection}</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold tracking-normal text-stone-950">{copy.collection}</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-stone-600">{copy.note}</p>
    </div>

    <div class="grid grid-cols-1 gap-4 mt-6 sm:grid-cols-2 lg:grid-cols-3">
      {copy.tools.map(([name, blurb, href]) => (
        <a href={toolHref(href)} class="kdp-card block rounded-2xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2">
          <article>
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-serif text-2xl font-semibold tracking-normal">{name}</h3>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-emerald-100 whitespace-nowrap">{chrome.status}</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-stone-600">{blurb}</p>
            <p class="kdp-link mt-4 text-sm">{chrome.open} -&gt;</p>
          </article>
        </a>
      ))}
    </div>
  </section>

  <section class="kdp-prose mt-14 max-w-3xl border-t border-[#e6d9c8] pt-8">
    <p class="kdp-section-label mb-2">{copy.label}</p>
    <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">{copy.explainTitle ?? copy.rulesTitle}</h2>
    {copy.explain ? (
      <p class="mt-4">{copy.explain}</p>
    ) : (
      <ul class="mt-5 space-y-3 list-disc pl-6">
        {copy.bullets.map((item) => <li>{item}</li>)}
      </ul>
    )}
  </section>

  <AdSense adSlot={`${adPrefix}-bottom`} style="min-height:90px" />

  <section class="mt-12 border-t border-[#e6d9c8] pt-6 text-sm text-stone-600">
    <p class="flex flex-wrap gap-x-4 gap-y-2">
      {isPortal && <a href="/guides/" class="hover:text-stone-950">{chrome.guides}</a>}
      <a href="/about/" class="hover:text-stone-950">{chrome.about}</a>
      <a href="/privacy/" class="hover:text-stone-950">{chrome.privacy}</a>
      <a href="/terms/" class="hover:text-stone-950">{chrome.terms}</a>
      <a href="/contact/" class="hover:text-stone-950">{chrome.contact}</a>
    </p>
  </section>
</BaseLayout>
