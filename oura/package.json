{
  "name": "oura-kdp",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Oura health dashboard for oura.kdp.cool",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @oura-kdp/api db:migrate:local && pnpm --parallel --filter @oura-kdp/web --filter @oura-kdp/api dev",
    "dev:web": "pnpm --filter @oura-kdp/web dev",
    "dev:api": "pnpm --filter @oura-kdp/api db:migrate:local && pnpm --filter @oura-kdp/api dev",
    "build": "pnpm --filter @oura-kdp/web build && pnpm --filter @oura-kdp/api build",
    "check:api": "node scripts/check-api.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "deploy:web": "pnpm --filter @oura-kdp/api exec wrangler pages deploy ../../apps/web/dist --project-name=oura-kdp --branch=main",
    "deploy:api": "node scripts/deploy-api.mjs",
    "test:browser": "pnpm build && node scripts/run-browser-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node --experimental-strip-types --test apps/web/test/*.test.mjs && pnpm --filter @oura-kdp/api test && pnpm --filter @oura-kdp/api test:integration"
  },
  "engines": {
    "node": ">=20"
  }
}
