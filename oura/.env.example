# Copy to workers/api/.dev.vars for local wrangler (gitignored).
# Never put real Oura client secrets in git.

# --- Local / tonight demo placeholders (safe to copy as-is) ---
# Authorize URL still uses the real Oura host + query shape.
OURA_CLIENT_ID=oura_dev_placeholder_client_id
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5173/api/auth/oura/callback
TOKEN_ENCRYPTION_KEY=dev-only-token-encryption-key-not-for-prod
SESSION_SECRET=dev-only-session-secret-not-for-prod
ALLOW_DEV_LOGIN=1
FRONTEND_ORIGIN=http://localhost:5173

# --- Staged website SSO (keep disabled until central auth is ready) ---
SSO_ENABLED=0
AUTH_CLIENT_ID=oura
AUTH_ORIGIN=https://auth.codepi.app
# AUTH_CLIENT_SECRET must match the central SSO_CLIENTS entry.
# PERSONAL_OWNER_ID must be the EXISTING users.id that owns the encrypted
# tokens, history and MCP grants. Do not invent a new id or change encryption keys.
# AUTH is a Worker service binding to kdp-auth (declared in wrangler.toml).
# Local SSO testing also requires that service binding and an existing owner row.

# --- Production (never commit real values) ---
# From workers/api:
#   npx wrangler secret put OURA_CLIENT_ID
#   npx wrangler secret put OURA_CLIENT_SECRET
#   npx wrangler secret put TOKEN_ENCRYPTION_KEY
#   npx wrangler secret put SESSION_SECRET
# OURA_CLIENT_ID / OURA_CLIENT_SECRET come from
# https://cloud.ouraring.com/oauth/applications
# TOKEN_ENCRYPTION_KEY / SESSION_SECRET: long random strings (32+ bytes).
#
# Exact production URLs (dashboard vars or secret put — still no git values):
#   OURA_REDIRECT_URI=https://health.codepi.app/api/auth/oura/callback
#   FRONTEND_ORIGIN=https://health.codepi.app
# Preview/test Worker: ALLOW_DEV_LOGIN=1 so 「DEV 演示登录」shows and works.
# Production health.codepi.app: ALLOW_DEV_LOGIN must be unset or 0.
