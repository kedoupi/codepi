# Copy to .dev.vars (gitignored). Placeholders only — not real Oura secrets.
# Production: wrangler secret put + OURA_REDIRECT_URI=https://oura.kdp.cool/api/auth/oura/callback
# Preview/test Worker: ALLOW_DEV_LOGIN=1
# Production: FRONTEND_ORIGIN=https://oura.kdp.cool · ALLOW_DEV_LOGIN unset/0
OURA_CLIENT_ID=oura_dev_placeholder_client_id
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5173/api/auth/oura/callback
TOKEN_ENCRYPTION_KEY=dev-only-token-encryption-key-not-for-prod
SESSION_SECRET=dev-only-session-secret-not-for-prod
ALLOW_DEV_LOGIN=1
FRONTEND_ORIGIN=http://localhost:5173
# Stripe test mode (optional locally). Webhook path: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# STRIPE_ENABLE_ALIPAY=0
# STRIPE_ENABLE_WECHAT_PAY=0

