---
import * as siteConfig from '@site/site.config.js';
import { defaultLocale, getLocale } from '@kedoupi/shared/i18n/config.js';
import {
  CODEPI_LOGO_450W_PNG,
  CODEPI_LOGO_450W_WEBP,
  CODEPI_LOGO_900W_PNG,
  CODEPI_LOGO_900W_WEBP,
  CODEPI_LOGO_HEIGHT,
  CODEPI_LOGO_PNG,
  CODEPI_LOGO_WEBP,
  CODEPI_LOGO_WIDTH,
  CODEPI_SYMBOL_HEIGHT,
  CODEPI_SYMBOL_PNG,
  CODEPI_SYMBOL_WIDTH,
  PRODUCT_BRAND,
} from '@kedoupi/shared/brand';
import '@kedoupi/shared/styles/site.css';

const { siteName, tagline, footerNote, navLinks, applicationCategory } = siteConfig;
const personalSite = siteConfig.personalSite === true;
const primaryNavLinks = personalSite
  ? [...navLinks, { href: '/desk/', label: '我的工作台' }]
  : navLinks;
const extraFooterLinks = siteConfig.extraFooterLinks ?? [];
const defaultRobots = siteConfig.defaultRobots ?? 'index, follow';

interface Props {
  title: string;
  description: string;
  pathname: string;
  schemaType?: 'WebApplication' | 'WebSite' | 'WebPage';
  locale?: string;
  robots?: string;
  canonical?: string;
}
const SITE = import.meta.env.SITE;
const { title, description, pathname, schemaType = 'WebApplication', locale = personalSite ? 'zh' : defaultLocale, robots = defaultRobots, canonical } = Astro.props;
const localeInfo = getLocale(locale);
const canonicalURL = canonical || new URL(pathname, SITE).toString();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const home = personalSite && pathname === '/';
const logoPngSrcset = `${CODEPI_LOGO_450W_PNG} 450w, ${CODEPI_LOGO_900W_PNG} 900w, ${CODEPI_LOGO_PNG} ${CODEPI_LOGO_WIDTH}w`;
const logoWebpSrcset = `${CODEPI_LOGO_450W_WEBP} 450w, ${CODEPI_LOGO_900W_WEBP} 900w, ${CODEPI_LOGO_WEBP} ${CODEPI_LOGO_WIDTH}w`;
const footerLinks = personalSite
  ? [{ href: '/about/', label: '关于' }, { href: '/blog/', label: '博客' }, { href: '/privacy/', label: '隐私' }, { href: '/contact/', label: '联系' }]
  : [...extraFooterLinks, { href: '/privacy/', label: 'Privacy' }, { href: '/terms/', label: 'Terms' }, { href: '/about/', label: 'About' }, { href: '/contact/', label: 'Contact' }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  url: canonicalURL,
  description,
  ...(schemaType === 'WebApplication' ? { applicationCategory: applicationCategory || 'WebApplication' } : {}),
};
---
<!doctype html>
<html lang={localeInfo.htmlLang} dir={localeInfo.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#FAF8F4" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="stylesheet" href="/fonts/misans/misans.css" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main-content" class="kdp-skip">{personalSite ? '跳到正文' : 'Skip to main content'}</a>
  <header class:list={['kdp-header', { 'kdp-header--home': home }]}>
    <div class="kdp-container kdp-header-inner">
      <a href="/" class="kdp-brand" aria-label={personalSite ? `${PRODUCT_BRAND} 首页` : siteName}>
        {personalSite
          ? <picture class="kdp-logo-frame">
              <source type="image/webp" srcset={logoWebpSrcset} sizes="(max-width: 720px) 104px, 124px" />
              <img
                class="kdp-logo"
                src={CODEPI_LOGO_PNG}
                srcset={logoPngSrcset}
                alt="CodePi"
                width={CODEPI_LOGO_WIDTH}
                height={CODEPI_LOGO_HEIGHT}
                sizes="(max-width: 720px) 104px, 124px"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          : <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" /><span class="kdp-wordmark">{siteName}</span></>}
      </a>
      <nav class="kdp-nav" aria-label={personalSite ? '主导航' : 'Primary navigation'}>
        {primaryNavLinks.map((link) => (
          <a class:list={[{ 'kdp-nav-entry': link.href === '/desk/' }]} href={link.href} aria-current={link.href === pathname ? 'page' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}
      </nav>
      <details class="kdp-mobile-nav">
        <summary class="kdp-mobile-nav-toggle" aria-label="打开导航菜单"><span class="kdp-mobile-nav-icon" aria-hidden="true"></span><span class="sr-only">菜单</span></summary>
        <nav class="kdp-mobile-nav-panel" aria-label={personalSite ? '主导航' : 'Primary navigation'}>
          {primaryNavLinks.map((link) => (
            <a href={link.href} aria-current={link.href === pathname ? 'page' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
          ))}
        </nav>
      </details>
      <script is:inline>
        (() => {
          const drawer = document.querySelector('.kdp-mobile-nav');
          if (!drawer) return;
          const close = () => { drawer.removeAttribute('open'); };
          drawer.addEventListener('click', event => {
            if (event.target instanceof HTMLAnchorElement) close();
          });
          document.addEventListener('click', event => {
            if (drawer.hasAttribute('open') && !drawer.contains(event.target)) close();
          });
          document.addEventListener('keydown', event => {
            if (event.key === 'Escape') close();
          });
        })();
      </script>
    </div>
  </header>
  <main id="main-content" class:list={['kdp-container kdp-main', { 'kdp-main--home': home }]} tabindex="-1">
    <slot />
  </main>
  <footer class:list={['kdp-footer', { 'kdp-footer--home': home }]}>
    <div class="kdp-container kdp-footer-inner">
      <div>
        <a href="/" class="kdp-brand" aria-label={personalSite ? PRODUCT_BRAND : siteName}>
          {personalSite
            ? <picture class="kdp-logo-frame">
                <source type="image/webp" srcset={logoWebpSrcset} sizes="(max-width: 720px) 100px, 114px" />
                <img
                  class="kdp-logo"
                  src={CODEPI_LOGO_PNG}
                  srcset={logoPngSrcset}
                  alt="CodePi"
                  width={CODEPI_LOGO_WIDTH}
                  height={CODEPI_LOGO_HEIGHT}
                  sizes="(max-width: 720px) 100px, 114px"
                  decoding="async"
                  loading="lazy"
                />
              </picture>
            : <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" loading="lazy" /><span class="kdp-wordmark">{siteName}</span></>}
        </a>
        <p class="kdp-footer-note">{personalSite ? footerNote : tagline}</p>
      </div>
      <div>
        <nav class="kdp-footer-links" aria-label={personalSite ? '页脚导航' : 'Footer navigation'}>
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <p class="kdp-copyright">© {new Date().getFullYear()} {siteName}{!personalSite && ` · ${footerNote}`}</p>
      </div>
    </div>
  </footer>
</body>
</html>
