---
import * as siteConfig from '@site/site.config.js';
import { defaultLocale, getLocale } from '@kedoupi/shared/i18n/config.js';
import {
  CODEPI_SYMBOL_HEIGHT,
  CODEPI_SYMBOL_PNG,
  CODEPI_SYMBOL_WIDTH,
  PRODUCT_BRAND,
} from '@kedoupi/shared/brand';
import '@kedoupi/shared/styles/site.css';

const { siteName, tagline, footerNote, navLinks, applicationCategory } = siteConfig;
const personalSite = siteConfig.personalSite === true;
const deskLink = { href: '/desk/', label: '我的工作台' };
const primaryNavLinks = navLinks;
const mobileNavLinks = personalSite ? [...navLinks, deskLink] : navLinks;
const extraFooterLinks = siteConfig.extraFooterLinks ?? [];
const defaultRobots = siteConfig.defaultRobots ?? 'index, follow';

interface Props {
  title: string;
  description: string;
  pathname: string;
  schemaType?: 'WebApplication' | 'WebSite' | 'WebPage';
  locale?: string;
  robots?: string;
  canonical?: string;
}
const SITE = import.meta.env.SITE;
const { title, description, pathname, schemaType = 'WebApplication', locale = personalSite ? 'zh' : defaultLocale, robots = defaultRobots, canonical } = Astro.props;
const localeInfo = getLocale(locale);
const canonicalURL = canonical || new URL(pathname, SITE).toString();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const home = personalSite && pathname === '/';
const footerLinks = personalSite
  ? [...navLinks, deskLink]
  : extraFooterLinks;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  url: canonicalURL,
  description,
  ...(schemaType === 'WebApplication' ? { applicationCategory: applicationCategory || 'WebApplication' } : {}),
};
---
<!doctype html>
<html lang={localeInfo.htmlLang} dir={localeInfo.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#FAF8F4" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="stylesheet" href="/fonts/misans/misans.css" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main-content" class="kdp-skip">{personalSite ? '跳到正文' : 'Skip to main content'}</a>
  <header class="kdp-header">
    <div class="kdp-container kdp-header-inner">
      <a href="/" class="kdp-brand" aria-label={personalSite ? `${PRODUCT_BRAND} 首页` : siteName}>
        {personalSite
          ? <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" /><span class="kdp-wordmark">Code<span class="kdp-wordmark-pi">Pi</span></span></>
          : <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" /><span class="kdp-wordmark">{siteName}</span></>}
      </a>
      <nav class="kdp-nav" aria-label={personalSite ? '主导航' : 'Primary navigation'}>
        {primaryNavLinks.map((link) => (
          <a href={link.href} aria-current={link.href === pathname ? 'page' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}
      </nav>
      <div class="kdp-header-action">
        {personalSite && <a href={deskLink.href}>{deskLink.label}</a>}
      </div>
      <details class="kdp-mobile-nav">
        <summary class="kdp-mobile-nav-toggle" aria-label="打开菜单"><span class="kdp-mobile-nav-icon" aria-hidden="true"></span><span class="sr-only">菜单</span></summary>
        <nav class="kdp-mobile-nav-panel" aria-label={personalSite ? '主导航' : 'Primary navigation'}>
          {mobileNavLinks.map((link) => (
            <a href={link.href} aria-current={link.href === pathname ? 'page' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
          ))}
        </nav>
      </details>
      <script is:inline>
        (() => {
          const drawer = document.querySelector('.kdp-mobile-nav');
          if (!drawer) return;
          const close = () => { drawer.removeAttribute('open'); };
          drawer.addEventListener('click', event => {
            if (event.target instanceof HTMLAnchorElement) close();
          });
          document.addEventListener('click', event => {
            if (drawer.hasAttribute('open') && !drawer.contains(event.target)) close();
          });
          document.addEventListener('keydown', event => {
            if (event.key === 'Escape') close();
          });
        })();
      </script>
    </div>
  </header>
  <main id="main-content" class:list={['kdp-container kdp-main', { 'kdp-main--home': home }]} tabindex="-1">
    <slot />
  </main>
  <footer class:list={['kdp-footer', { 'kdp-footer--home': home }]}>
    <div class="kdp-container kdp-footer-inner">
      <div>
        <a href="/" class="kdp-brand" aria-label={personalSite ? PRODUCT_BRAND : siteName}>
          {personalSite
            ? <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" loading="lazy" /><span class="kdp-wordmark">Code<span class="kdp-wordmark-pi">Pi</span></span></>
            : <><img class="kdp-mark" src={CODEPI_SYMBOL_PNG} alt="" width={CODEPI_SYMBOL_WIDTH} height={CODEPI_SYMBOL_HEIGHT} decoding="async" loading="lazy" /><span class="kdp-wordmark">{siteName}</span></>}
        </a>
        {personalSite
          ? <p class="kdp-footer-note kdp-signature-note">BUILD · THINK · CREATE</p>
          : <p class="kdp-footer-note">{tagline}</p>}
      </div>
      <div>
        <nav class="kdp-footer-links" aria-label={personalSite ? '页脚导航' : 'Footer navigation'}>
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <p class="kdp-copyright">{personalSite ? '© 2026 kedoupi（codepi）' : `© ${new Date().getFullYear()} ${siteName} · ${footerNote}`}</p>
      </div>
    </div>
  </footer>
</body>
</html>
