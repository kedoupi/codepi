---
import * as siteConfig from '@site/site.config.js';
import { defaultLocale, getLocale } from '@shared/i18n/config.js';
import { PRODUCT_BRAND } from '@shared/brand';
import '@shared/styles/site.css';

const { siteName, tagline, footerNote, navLinks, applicationCategory } = siteConfig;
const personalSite = siteConfig.personalSite === true;
const extraFooterLinks = siteConfig.extraFooterLinks ?? [];
const defaultRobots = siteConfig.defaultRobots ?? 'index, follow';

interface Props {
  title: string;
  description: string;
  pathname: string;
  schemaType?: 'WebApplication' | 'WebSite' | 'WebPage';
  locale?: string;
  robots?: string;
  canonical?: string;
}
const SITE = import.meta.env.SITE;
const { title, description, pathname, schemaType = 'WebApplication', locale = personalSite ? 'zh' : defaultLocale, robots = defaultRobots, canonical } = Astro.props;
const localeInfo = getLocale(locale);
const canonicalURL = canonical || new URL(pathname, SITE).toString();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const home = personalSite && pathname === '/';
const footerLinks = personalSite
  ? [{ href: '/about/', label: '关于' }, { href: '/blog/', label: '博客' }, { href: '/privacy/', label: '隐私' }, { href: '/contact/', label: '联系' }]
  : [...extraFooterLinks, { href: '/privacy/', label: 'Privacy' }, { href: '/terms/', label: 'Terms' }, { href: '/about/', label: 'About' }, { href: '/contact/', label: 'Contact' }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  url: canonicalURL,
  description,
  ...(schemaType === 'WebApplication' ? { applicationCategory: applicationCategory || 'WebApplication' } : {}),
};
---
<!doctype html>
<html lang={localeInfo.htmlLang} dir={localeInfo.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main-content" class="kdp-skip">{personalSite ? '跳到正文' : 'Skip to main content'}</a>
  <header>
    <div class="kdp-container kdp-header-inner">
      <a href="/" class="kdp-brand" aria-label={personalSite ? `${PRODUCT_BRAND} 首页` : siteName}>
        <span class="kdp-mark" aria-hidden="true">k</span>
        <span class="kdp-wordmark">{personalSite ? <>kedoupi<small>(codepi)</small></> : siteName}</span>
      </a>
      <nav class="kdp-nav" aria-label={personalSite ? '主导航' : 'Primary navigation'}>
        {navLinks.map((link) => (
          <a href={link.href} aria-current={link.href === pathname ? 'page' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}
        {personalSite && <a class="kdp-nav-entry kdp-desk-entry" href="/desk/" aria-current={pathname === '/desk/' ? 'page' : undefined}>我的工作台</a>}
      </nav>
    </div>
  </header>
  <main id="main-content" class:list={['kdp-container kdp-main', { 'kdp-main--home': home }]} tabindex="-1">
    <slot />
  </main>
  <footer class="kdp-footer">
    <div class="kdp-container kdp-footer-inner">
      <div>
        <a href="/" class="kdp-brand" aria-label={personalSite ? PRODUCT_BRAND : siteName}>
          <span class="kdp-mark" aria-hidden="true">k</span>
          <span class="kdp-wordmark">{personalSite ? <>kedoupi<small>(codepi)</small></> : siteName}</span>
        </a>
        <p class="kdp-footer-note">{personalSite ? footerNote : tagline}</p>
      </div>
      <div>
        <nav class="kdp-footer-links" aria-label={personalSite ? '页脚导航' : 'Footer navigation'}>
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <p class="kdp-copyright">© {new Date().getFullYear()} {siteName}{!personalSite && ` · ${footerNote}`}</p>
      </div>
    </div>
  </footer>
</body>
</html>
