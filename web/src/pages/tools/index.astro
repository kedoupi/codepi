---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
const groups = [
  { name: '金融计算器', description: '以前做过的计算器与计算过程说明。结果依赖工具注明的假设和更新日期。', links: [ ['房贷计算器', '/mortgage-calculator/'], ['工资计算器', '/paycheck-calculator/'], ['所得税计算器', '/income-tax-calculator/'], ['其他金融计算器', 'https://calc.kdp.cool/'], ['计算说明与指南', '/guides/'] ] },
  { name: '日常与开发工具', description: '按需使用的小工具，继续保留原有入口。', links: [ ['单位与时区转换', 'https://convert.kdp.cool/'], ['文本工具', 'https://text.kdp.cool/'], ['开发工具', 'https://dev.kdp.cool/'], ['AI 工具', 'https://ai.kdp.cool/'] ] },
];
---
<BaseLayout title="工具存档" description="保留以前做过的计算器、转换器、文本和开发工具入口。" pathname="/tools/" schemaType="WebPage">
  <article class="personal-article">
    <h1>做过的小工具</h1>
    <p class="lead">这里保留了一些以前做过的东西。需要的时候，仍然可以打开使用。</p>
    <p>它们已经退出主站的主要导航；旧地址继续保留。使用前，请留意每个工具的计算范围和数据更新时间。</p>
    {groups.map((group) => <section>
      <h2>{group.name}</h2>
      <p>{group.description}</p>
      <ul>{group.links.map(([name, href]) => <li><a href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{name}</a></li>)}</ul>
    </section>)}
    <p class="archive-back"><a href="/apps/">回到现在的应用</a></p>
  </article>
</BaseLayout>
<style>.archive-back { margin-top: 36px; }</style>
