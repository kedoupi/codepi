---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import AdSense from '@shared/components/AdSense.astro';
import { guides } from '../../guides.js';

const title = 'Guides — how the calculators actually work';
const description = 'Original explainers from Kdp.Cool on mortgage payments, take-home pay, and US federal tax brackets. Each guide includes a static worked example you can check without JavaScript.';
---
<BaseLayout title={title} description={description} pathname="/guides/" schemaType="WebPage">
  <section class="max-w-3xl">
    <p class="kdp-section-label mb-3">From the portal</p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl">Guides</h1>
    <p class="mt-5 text-xl leading-8 text-stone-700">
      These pages exist so you can read the method before you move a slider. Each guide is written in English, stays on kdp.cool, and includes at least one fully worked numeric example that does not depend on JavaScript. Topics cover mortgage term tradeoffs, prepayments, PITI versus lender disclosures, paycheck withholding models, FICA versus ordinary tax, pretax 401(k) effects, and marginal versus effective rates.
    </p>
    <p class="mt-4 text-stone-600 leading-7">
      The mortgage, paycheck, and income-tax calculators are on this site. Use a guide when you want the story; use a calculator when you want to change inputs. Neither one is tax, lending, or legal advice.
    </p>
  </section>

  <AdSense adSlot="guides-index-top" style="min-height:90px" />

  <section class="mt-10 grid grid-cols-1 gap-4">
    {guides.map((guide) => (
      <a href={guide.href} class="kdp-card block rounded-2xl p-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2">
        <h2 class="font-serif text-2xl font-semibold tracking-normal text-stone-950">{guide.title}</h2>
        <p class="mt-3 text-sm leading-7 text-stone-600">{guide.description}</p>
        <p class="kdp-link mt-4 text-sm">Read the guide -&gt;</p>
      </a>
    ))}
  </section>

  <section class="kdp-prose mt-14 max-w-3xl border-t border-[#e6d9c8] pt-8">
    <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">How we write these</h2>
    <ul class="mt-5 list-disc space-y-3 pl-6">
      <li><strong>Cite public methods.</strong> Mortgage math uses the standard fully amortizing payment formula. Federal tax figures come from IRS Revenue Procedure 2025-32 for tax year 2026.</li>
      <li><strong>Show the arithmetic.</strong> A reader should be able to reproduce the example with a calculator and a pencil.</li>
      <li><strong>Label the limits.</strong> State tax, credits, PMI, and employer withholding tables are often left out on purpose. We say so.</li>
      <li><strong>Keep tools free.</strong> The guides and the calculators stay free. Ads, when they appear, sit in reserved slots and do not gate the explanation.</li>
    </ul>
    <p class="mt-6">
      Looking for a shorter version first? The <a href="/" class="kdp-link">homepage</a> has two static mini-examples, and <a href="/about/" class="kdp-link">About</a> explains who maintains the site.
    </p>
  </section>
</BaseLayout>
