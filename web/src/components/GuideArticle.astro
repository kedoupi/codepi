---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import { guides } from '../guides.js';
import { PRODUCT_BRAND } from '@shared/brand';

interface Props {
  title: string;
  description: string;
  pathname: string;
  reviewed: string;
  toolHref: string;
  toolLabel: string;
}

const { title, description, pathname, reviewed, toolHref, toolLabel } = Astro.props;
const related = guides.filter((guide) => guide.href !== pathname);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: reviewed,
  inLanguage: 'en',
  author: { '@type': 'Person', name: PRODUCT_BRAND, url: 'https://kdp.cool/' },
  publisher: { '@type': 'Person', name: PRODUCT_BRAND, url: 'https://kdp.cool/' },
  mainEntityOfPage: new URL(pathname, 'https://kdp.cool').toString(),
};
---
<BaseLayout locale="en" title={title} description={description} pathname={pathname} schemaType="WebPage">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <article class="kdp-prose max-w-3xl">
    <p class="text-sm text-stone-500">
      <a href="/" class="hover:text-stone-950">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/guides/" class="hover:text-stone-950">Guides</a>
    </p>
    <p class="kdp-section-label mt-5 mb-3">Educational guide</p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl">{title}</h1>
    <p class="mt-4 text-lg leading-8 text-stone-700">{description}</p>
    <p class="mt-3 text-sm text-stone-500">Last reviewed: {reviewed}. Estimates only — not financial, tax, or legal advice.</p>

    <div class="mt-8 space-y-5 text-[1.05rem] leading-8 text-stone-800">
      <slot />
    </div>

    <aside class="mt-12 rounded-2xl border border-[var(--kdp-line)] bg-white p-6">
      <p class="kdp-section-label">Try the live tool</p>
      <p class="mt-2 text-stone-700">Want to change the numbers? The matching calculator runs in your browser and shows the same method.</p>
      <p class="mt-4">
        <a href={toolHref} class="kdp-link" target="_blank" rel="noopener">{toolLabel} -&gt;</a>
      </p>
    </aside>

    <nav class="mt-10 border-t border-[var(--kdp-line)] pt-6" aria-label="More guides">
      <p class="kdp-section-label mb-3">More guides</p>
      <ul class="space-y-2">
        {related.map((guide) => (
          <li><a href={guide.href} class="kdp-link">{guide.title}</a></li>
        ))}
        <li><a href="/guides/" class="text-stone-600 hover:text-stone-950">All guides</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>
