---
interface Faq {
  q: string;
  a: string;
}

interface Related {
  href: string;
  label: string;
  note: string;
  external?: boolean;
}

interface Props {
  faqs: Faq[];
  related?: Related[];
  relatedTitle?: string;
  reviewed?: string;
  disclaimer?: string;
}

const {
  faqs,
  related = [],
  relatedTitle = 'Related calculators',
  reviewed = '2026-09-16',
  disclaimer = 'Results are educational estimates for planning — not financial, tax, or legal advice, and not a lender quote, payroll stub, or filed return.',
} = Astro.props;
---
<section class="mt-10">
  <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
  <div class="space-y-2">
    {faqs.map((f) => (
      <details class="border border-slate-200 rounded p-4 group">
        <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
        <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
})} />

{related.length > 0 && (
  <section class="mt-10 pt-8 border-t border-slate-200">
    <h2 class="text-lg font-semibold mb-3">{relatedTitle}</h2>
    <ul class="space-y-2 text-sm">
      {related.map((item) => (
        <li>
          →{' '}
          {item.external ? (
            <a href={item.href} class="text-blue-600 hover:underline font-medium" target="_blank" rel="noopener">{item.label}</a>
          ) : (
            <a href={item.href} class="text-blue-600 hover:underline font-medium">{item.label}</a>
          )}
          {' '}— {item.note}
        </li>
      ))}
    </ul>
  </section>
)}

<p class="mt-10 text-sm text-slate-500">
  <strong>Last reviewed {reviewed}</strong>. {disclaimer}
</p>
