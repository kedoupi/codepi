---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'AI Prompt Builder - Create Structured Prompts';
const description = 'Build a clear AI prompt from role, task, context, inputs, constraints, output format, and acceptance criteria. Browser-only, no signup.';

const faqs = [
  {
    q: 'Does this call an AI model?',
    a: 'No. This is a local prompt template builder. It organizes what you type into a reusable prompt but does not send anything to an AI service.',
  },
  {
    q: 'Why include acceptance criteria?',
    a: 'Acceptance criteria tell the AI how you will judge the answer. That usually produces more useful output than a vague request like "make this better".',
  },
  {
    q: 'Can I use the output with ChatGPT, Claude, Gemini, or local models?',
    a: 'Yes. The output is plain text and can be pasted into most chat or API tools.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/prompt-builder/">
  <CalculatorShell
    title="AI Prompt Builder"
    intro="Fill in the fields you know. The tool turns them into a structured prompt you can copy into ChatGPT, Claude, Gemini, or an API request."
  >
    <AdSense slot="top-ad" adSlot="ai-prompt-builder-top" style="min-height:90px" />

    <div slot="inputs" class="space-y-4">
      <div>
        <label for="pb-role" class="block text-sm font-medium text-slate-700 mb-1">Role</label>
        <input id="pb-role" value="You are a pragmatic senior software engineer"
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600" />
      </div>
      <div>
        <label for="pb-task" class="block text-sm font-medium text-slate-700 mb-1">Task</label>
        <textarea id="pb-task" rows="3" placeholder="What do you want the AI to do?"
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600"></textarea>
      </div>
      <div>
        <label for="pb-context" class="block text-sm font-medium text-slate-700 mb-1">Context</label>
        <textarea id="pb-context" rows="3" placeholder="Background, audience, existing constraints, project state..."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600"></textarea>
      </div>
      <div>
        <label for="pb-inputs" class="block text-sm font-medium text-slate-700 mb-1">Input material</label>
        <textarea id="pb-inputs" rows="3" placeholder="Paste data, notes, rough draft, or describe what you will provide..."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600"></textarea>
      </div>
      <div>
        <label for="pb-format" class="block text-sm font-medium text-slate-700 mb-1">Output format</label>
        <input id="pb-format" value="Use concise Markdown with clear headings and short bullets"
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600" />
      </div>
      <div>
        <label for="pb-criteria" class="block text-sm font-medium text-slate-700 mb-1">Acceptance criteria</label>
        <textarea id="pb-criteria" rows="3" placeholder="How should the AI check whether the answer is useful?"
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600"></textarea>
      </div>
    </div>

    <div slot="results" class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Generated prompt</h2>
        <div class="flex items-center gap-3">
          <span id="pb-copy-status" class="text-xs text-emerald-600 hidden">Copied</span>
          <button type="button" id="pb-copy" class="text-sm font-medium text-teal-700 hover:text-teal-800">Copy</button>
        </div>
      </div>
      <textarea id="pb-output" rows="22" readonly
        class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm leading-relaxed resize-y bg-white"></textarea>
    </div>

    <AdSense slot="middle-ad" adSlot="ai-prompt-builder-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">How to use the prompt builder</h2>
      <p class="mb-3">Good prompts usually contain the job, the context, the input material, the expected output format, and how to judge the answer. This page keeps those pieces separate so you do not have to remember a prompt formula every time.</p>
      <p class="mb-3"><strong>Success sign:</strong> the copied prompt should be specific enough that another person could understand the job without asking what you meant.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Limitations</h3>
      <p class="mb-3">This tool does not magically make a vague task clear. If the goal, source material, or expected output is missing, the generated prompt will still be incomplete. It also does not validate facts or call an AI model.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. Everything runs locally in your browser.</p>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

    <AdSense slot="bottom-ad" adSlot="ai-prompt-builder-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    const ids = ['pb-role', 'pb-task', 'pb-context', 'pb-inputs', 'pb-format', 'pb-criteria'];
    const els = Object.fromEntries(ids.map((id) => [id, document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement]));
    const $output = document.getElementById('pb-output') as HTMLTextAreaElement;
    const $copy = document.getElementById('pb-copy') as HTMLButtonElement;
    const $copyStatus = document.getElementById('pb-copy-status') as HTMLElement;

    function block(label: string, value: string, fallback: string): string {
      const clean = value.trim();
      return `## ${label}\n${clean || fallback}`;
    }

    function update() {
      $output.value = [
        els['pb-role'].value.trim() || 'You are a helpful assistant.',
        '',
        block('Task', els['pb-task'].value, 'Ask clarifying questions if the task is ambiguous.'),
        '',
        block('Context', els['pb-context'].value, 'Use only the context provided by the user. State assumptions when needed.'),
        '',
        block('Input Material', els['pb-inputs'].value, 'The user will provide the input after this prompt.'),
        '',
        block('Output Format', els['pb-format'].value, 'Use clear Markdown.'),
        '',
        block('Acceptance Criteria', els['pb-criteria'].value, 'The answer should be accurate, specific, and directly usable.'),
      ].join('\n');
    }

    Object.values(els).forEach((el) => el.addEventListener('input', update));
    $copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText($output.value);
      $copyStatus.classList.remove('hidden');
      setTimeout(() => $copyStatus.classList.add('hidden'), 1200);
    });
    update();
  </script>
</BaseLayout>
