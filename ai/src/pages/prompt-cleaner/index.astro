---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'AI Prompt Cleaner - Turn Messy Requirements Into a Clear Prompt';
const description = 'Reformat rough AI instructions into a clearer prompt structure. Browser-only template tool, no AI call, no signup.';

const faqs = [
  {
    q: 'Does this rewrite my prompt with AI?',
    a: 'No. It uses a local template and light cleanup only. Nothing is uploaded and no model is called.',
  },
  {
    q: 'What is the point if it does not use AI?',
    a: 'Many bad prompts fail because the request is unstructured. Separating goal, context, constraints, and output format often improves results before any model sees the prompt.',
  },
  {
    q: 'Can it detect missing information?',
    a: 'It can remind you to fill missing sections, but it cannot know your real intent. Review the generated prompt before using it.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/prompt-cleaner/">
  <CalculatorShell
    title="AI Prompt Cleaner"
    intro="Paste a rough request. This tool reshapes it into a clearer prompt outline without sending it to an AI model."
  >
    <AdSense slot="top-ad" adSlot="ai-cleaner-top" style="min-height:90px" />

    <div slot="inputs" class="space-y-4">
      <div>
        <label for="pc-rough" class="block text-sm font-medium text-slate-700 mb-1">Messy prompt or rough notes</label>
        <textarea id="pc-rough" rows="16" spellcheck="false" placeholder="Example: help me make this article better, maybe more direct, for founders, keep it short, don't sound too salesy..."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="pc-tone" class="block text-sm font-medium text-slate-700 mb-1">Tone</label>
          <select id="pc-tone" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600">
            <option>Direct and practical</option>
            <option>Friendly and simple</option>
            <option>Professional and concise</option>
            <option>Technical and precise</option>
          </select>
        </div>
        <div>
          <label for="pc-output-type" class="block text-sm font-medium text-slate-700 mb-1">Output type</label>
          <select id="pc-output-type" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600">
            <option>General answer</option>
            <option>Article draft</option>
            <option>Code review</option>
            <option>Implementation plan</option>
            <option>Summary</option>
          </select>
        </div>
      </div>
    </div>

    <div slot="results" class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Cleaned prompt</h2>
        <div class="flex items-center gap-3">
          <span id="pc-copy-status" class="text-xs text-emerald-600 hidden">Copied</span>
          <button type="button" id="pc-copy" class="text-sm font-medium text-teal-700 hover:text-teal-800">Copy</button>
        </div>
      </div>
      <textarea id="pc-output" rows="22" readonly
        class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm leading-relaxed resize-y bg-white"></textarea>
    </div>

    <AdSense slot="middle-ad" adSlot="ai-cleaner-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">How the cleaner works</h2>
      <p class="mb-3">The cleaner does not invent new facts. It wraps your rough notes in a stable prompt shape: goal, context, constraints, output format, and quality bar. That structure makes it easier to spot missing information before you paste the prompt into an AI tool.</p>
      <p class="mb-3"><strong>Success sign:</strong> after cleaning, you should be able to point to what the AI must do, what it should avoid, and what the final answer should look like.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Limitations</h3>
      <p class="mb-3">The cleaner cannot tell whether your goal is wise, whether your facts are correct, or whether the target audience is real. It only improves structure. Review the output before using it.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. Input stays in your browser.</p>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

    <AdSense slot="bottom-ad" adSlot="ai-cleaner-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    const $rough = document.getElementById('pc-rough') as HTMLTextAreaElement;
    const $tone = document.getElementById('pc-tone') as HTMLSelectElement;
    const $outputType = document.getElementById('pc-output-type') as HTMLSelectElement;
    const $output = document.getElementById('pc-output') as HTMLTextAreaElement;
    const $copy = document.getElementById('pc-copy') as HTMLButtonElement;
    const $copyStatus = document.getElementById('pc-copy-status') as HTMLElement;

    function update() {
      const rough = $rough.value.trim();
      const source = rough || '[Paste your rough request here before using the cleaned prompt.]';
      $output.value = [
        'You are a careful assistant. Help with the task below.',
        '',
        '## Goal',
        `Produce a ${$outputType.value.toLowerCase()} from the source request.`,
        '',
        '## Source Request',
        source,
        '',
        '## Constraints',
        `- Use a ${$tone.value.toLowerCase()} tone.`,
        '- Preserve the user intent; do not add facts that were not provided.',
        '- If information is missing, list the missing questions before answering.',
        '- Keep the answer directly usable.',
        '',
        '## Output Format',
        '- Start with the answer, not background theory.',
        '- Use clear headings when the answer has multiple parts.',
        '- Include assumptions only when they affect the answer.',
        '',
        '## Quality Bar',
        '- Specific enough to act on.',
        '- No filler or generic advice.',
        '- Call out risks, tradeoffs, or missing inputs plainly.',
      ].join('\n');
    }

    [$rough, $tone, $outputType].forEach((el) => el.addEventListener('input', update));
    $tone.addEventListener('change', update);
    $outputType.addEventListener('change', update);
    $copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText($output.value);
      $copyStatus.classList.remove('hidden');
      setTimeout(() => $copyStatus.classList.add('hidden'), 1200);
    });
    update();
  </script>
</BaseLayout>
