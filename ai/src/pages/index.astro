---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'AIKDP - Free AI Prompt, Token, Cost, Skill, and Privacy Tools';
const description = 'Practical browser-only AI utilities: token and cost calculator, prompt builder, skill builder, prompt cleaner, and privacy checker. Free, no signup.';

const tools = [
  { href: '/token-cost-calculator/', name: 'AI Token & Cost Calculator', blurb: 'Estimate tokens, output length, and API cost using transparent pricing assumptions.' },
  { href: '/prompt-builder/', name: 'Prompt Builder', blurb: 'Turn a task, context, constraints, and output format into a structured prompt.' },
  { href: '/skill-builder/', name: 'AI Skill Builder', blurb: 'Create reusable skill files for Codex, Claude, Cursor, and generic AI agents.' },
  { href: '/prompt-cleaner/', name: 'Prompt Cleaner', blurb: 'Rewrite messy requirements into a clearer prompt outline without calling an AI model.' },
  { href: '/privacy-checker/', name: 'AI Privacy Checker', blurb: 'Scan text locally for emails, phone-like strings, keys, tokens, and other sensitive patterns.' },
];
---
<BaseLayout title={title} description={description} pathname="/" schemaType="WebSite">
  <section class="mb-10 max-w-4xl space-y-4">
    <p class="kdp-section-label">Preparation tools before you send anything to a model</p>
    <h1 class="text-5xl font-semibold leading-[1.02] sm:text-6xl">Practical AI tools, not another AI directory</h1>
    <p class="max-w-3xl text-xl leading-8 text-stone-700">Use AI more deliberately: estimate cost before running prompts, structure messy requests, and check for sensitive data before pasting text into a chatbot or API. Every listed tool runs in your browser.</p>
    <p class="max-w-3xl text-stone-600 leading-7">AIKDP is for people who already use AI assistants and want cleaner inputs, safer drafts, and more predictable costs. The tools do not call an AI model on your behalf; they help you prepare better material before you choose where to run it.</p>
  </section>

  <AdSense adSlot="ai-home-top" style="min-height:90px" />

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    {tools.map((c) => (
      <a href={c.href} class="kdp-card block rounded-2xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2">
        <article>
          <h2 class="font-serif text-2xl font-semibold tracking-normal mb-2">{c.name}</h2>
          <p class="text-sm leading-6 text-stone-600 mb-4">{c.blurb}</p>
          <p class="kdp-link text-sm">Use Tool -></p>
        </article>
      </a>
    ))}
  </section>

  <section class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">What these AI utilities are for</h2>
      <p>
        AI work often fails before the model runs: the prompt is vague, the expected output is missing, a private token gets pasted by accident, or nobody checks the likely cost of a large context window. These tools address those preparation steps with deterministic browser logic.
      </p>
      <p>
        The prompt tools are intentionally structured. They ask for purpose, context, constraints, inputs, and success criteria because those fields make the final request easier for a human or model to inspect. The privacy checker uses pattern matching, so it is a review aid rather than a guarantee.
      </p>
    </div>

    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">How these tools are maintained</h2>
      <p>
        AIKDP is built for repeatable tasks rather than AI news or tool rankings. Pages include limitations, source links where outside data matters, and review dates so you can judge whether a tool fits your current workflow.
      </p>
      <p>
        Cost estimates are only estimates. Provider pricing, model names, billing units, and discounts can change, so always check the official provider page before making budget decisions.
      </p>
    </div>
  </section>

  <section class="kdp-prose mt-12 max-w-3xl space-y-3">
    <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">Before you copy the result</h2>
    <ul class="list-disc pl-6 space-y-2">
      <li>Token and cost calculations make assumptions visible instead of hiding them in a black box.</li>
      <li>Prompt pages create structured drafts that you can copy, edit, and review before using any model.</li>
      <li>Skill output is a starting point for human review, not an automatic installer or a claim of client support.</li>
      <li>Privacy checks should be combined with your own review when handling real customer, employee, financial, or credential data.</li>
    </ul>
  </section>

  <section class="mt-12 pt-8 border-t border-[#e6d9c8]">
    <h2 class="kdp-section-label mb-3">About this site</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li><a href="/about/" class="text-teal-700 hover:underline">About</a></li>
      <li><a href="/privacy/" class="text-teal-700 hover:underline">Privacy</a></li>
      <li><a href="/terms/" class="text-teal-700 hover:underline">Terms</a></li>
      <li><a href="/contact/" class="text-teal-700 hover:underline">Contact</a></li>
    </ul>
  </section>

  <AdSense adSlot="ai-home-bottom" style="min-height:90px" />
</BaseLayout>
