---
import LocalizedHome from '@shared/components/LocalizedHome.astro';
import { translatedLocaleCodes } from '@shared/i18n/config.js';

export function getStaticPaths() {
  return translatedLocaleCodes.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
---
<LocalizedHome siteKey="ai" locale={locale} />
