---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';

const title = 'AI Privacy Checker - Scan Text Before Pasting Into AI';
const description = 'Browser-only privacy checker for prompts and documents. Detect emails, phone-like strings, SSN-like IDs, credit-card-like numbers, API keys, and token patterns.';

const faqs = [
  {
    q: 'Does this guarantee my text is safe to paste into AI?',
    a: 'No. This is a pattern-based reminder tool. It can miss sensitive information and can flag harmless text. Review the text yourself before sharing it.',
  },
  {
    q: 'Is the text uploaded for scanning?',
    a: 'No. The checks run in your browser with JavaScript. Your text is not sent to a server.',
  },
  {
    q: 'What should I do when something is flagged?',
    a: 'Remove, redact, or replace the sensitive value before sending the text to an AI tool. For example, replace real emails with person@example.com and real keys with [API_KEY_REDACTED].',
  },
];
---
<BaseLayout title={title} description={description} pathname="/privacy-checker/">
  <CalculatorShell
    title="AI Privacy Checker"
    intro="Paste text before sending it to an AI system. The checker scans locally for common sensitive patterns and suggests what to redact."
  >

    <div slot="inputs" class="space-y-4">
      <div>
        <label for="pc-text" class="block text-sm font-medium text-slate-700 mb-1">Text to check</label>
        <textarea id="pc-text" rows="18" spellcheck="false" placeholder="Paste prompt, notes, logs, email draft, or document excerpt here..."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 font-mono text-sm leading-relaxed resize-y"></textarea>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" id="pc-sample" class="px-3 py-1.5 bg-slate-200 text-slate-800 rounded hover:bg-slate-300 text-sm font-medium">Load sample</button>
        <button type="button" id="pc-clear" class="px-3 py-1.5 text-slate-500 hover:text-slate-700 text-sm">Clear</button>
      </div>
    </div>

    <div slot="results" class="space-y-4">
      <div id="pc-status" class="rounded border px-3 py-2 text-sm font-medium border-emerald-200 bg-emerald-50 text-emerald-800">No text entered</div>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-lg border border-slate-200 p-3 bg-white">
          <p class="text-xs uppercase tracking-wider text-slate-500">Findings</p>
          <p id="pc-count" class="text-2xl font-bold tabular-nums">0</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-3 bg-white">
          <p class="text-xs uppercase tracking-wider text-slate-500">Characters</p>
          <p id="pc-chars" class="text-2xl font-bold tabular-nums">0</p>
        </div>
      </div>
      <div id="pc-results" class="space-y-2 text-sm"></div>
    </div>


    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">How the privacy checker works</h2>
      <p class="mb-3">The checker uses local regular-expression patterns to find common things people accidentally paste into AI tools: emails, phone-like strings, SSN-like IDs, credit-card-like numbers, API keys, bearer tokens, private key headers, and common secret variable names.</p>
      <p class="mb-3">It is intentionally conservative. A false positive is cheaper than accidentally sending a real credential, customer email, or internal token to a third-party AI system.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Limitations</h3>
      <p class="mb-3">Pattern matching cannot understand every secret. It may miss names, addresses, internal project codes, unusual credentials, screenshots, proprietary text, or regulated data that does not match a simple pattern. Treat the output as a checklist, not approval.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. The scan runs locally in your browser; text is not uploaded.</p>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

  </CalculatorShell>

  <script>
    const CHECKS: Array<{ label: string; severity: 'high' | 'medium'; pattern: RegExp; advice: string }> = [
      { label: 'Email address', severity: 'medium', pattern: /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi, advice: 'Replace real emails with placeholders like person@example.com.' },
      { label: 'Phone-like number', severity: 'medium', pattern: /(?:\+?\d{1,3}[\s.-]?)?(?:\(?\d{3}\)?[\s.-]?)\d{3}[\s.-]?\d{4}\b/g, advice: 'Remove or mask phone numbers unless the AI truly needs them.' },
      { label: 'US SSN-like ID', severity: 'high', pattern: /\b\d{3}-\d{2}-\d{4}\b/g, advice: 'Do not send government ID numbers to general AI tools.' },
      { label: 'Credit-card-like number', severity: 'high', pattern: /\b(?:\d[ -]*?){13,19}\b/g, advice: 'Remove payment card numbers. Use fake test numbers only when needed.' },
      { label: 'OpenAI-style API key', severity: 'high', pattern: /\bsk-[A-Za-z0-9_-]{20,}\b/g, advice: 'Revoke exposed API keys and replace them before sharing logs or code.' },
      { label: 'Bearer token', severity: 'high', pattern: /\bBearer\s+[A-Za-z0-9._~+/=-]{20,}/gi, advice: 'Remove authorization headers and session tokens.' },
      { label: 'Private key header', severity: 'high', pattern: /-----BEGIN [A-Z ]*PRIVATE KEY-----/g, advice: 'Never paste private keys into AI tools.' },
      { label: 'Secret variable name', severity: 'high', pattern: /\b(?:api[_-]?key|secret|token|password|passwd|pwd)\s*[:=]\s*['"]?[^'"\s]{8,}/gi, advice: 'Redact secret environment variables and config values.' },
    ];

    const $text = document.getElementById('pc-text') as HTMLTextAreaElement;
    const $status = document.getElementById('pc-status') as HTMLElement;
    const $count = document.getElementById('pc-count') as HTMLElement;
    const $chars = document.getElementById('pc-chars') as HTMLElement;
    const $results = document.getElementById('pc-results') as HTMLElement;
    const $sample = document.getElementById('pc-sample') as HTMLButtonElement;
    const $clear = document.getElementById('pc-clear') as HTMLButtonElement;

    function mask(s: string): string {
      if (s.length <= 8) return '[redacted]';
      return `${s.slice(0, 4)}...${s.slice(-4)}`;
    }

    function update() {
      const text = $text.value;
      const findings: Array<{ label: string; severity: string; sample: string; advice: string }> = [];
      for (const check of CHECKS) {
        const matches = [...text.matchAll(check.pattern)].slice(0, 5);
        for (const match of matches) {
          findings.push({ label: check.label, severity: check.severity, sample: mask(match[0]), advice: check.advice });
        }
      }

      $chars.textContent = text.length.toLocaleString();
      $count.textContent = findings.length.toLocaleString();
      $results.innerHTML = '';

      if (!text.trim()) {
        $status.textContent = 'No text entered';
        $status.className = 'rounded border px-3 py-2 text-sm font-medium border-emerald-200 bg-emerald-50 text-emerald-800';
        return;
      }

      if (findings.length === 0) {
        $status.textContent = 'No common sensitive patterns found. Still review manually before sharing.';
        $status.className = 'rounded border px-3 py-2 text-sm font-medium border-emerald-200 bg-emerald-50 text-emerald-800';
        return;
      }

      const high = findings.some((f) => f.severity === 'high');
      $status.textContent = high ? 'High-risk pattern found. Redact before sharing.' : 'Sensitive-looking pattern found. Review before sharing.';
      $status.className = high
        ? 'rounded border px-3 py-2 text-sm font-medium border-red-200 bg-red-50 text-red-800'
        : 'rounded border px-3 py-2 text-sm font-medium border-amber-200 bg-amber-50 text-amber-800';

      for (const f of findings) {
        const div = document.createElement('div');
        div.className = 'rounded border border-slate-200 bg-white p-3';
        div.innerHTML = `<p class="font-medium">${f.label} <span class="${f.severity === 'high' ? 'text-red-700' : 'text-amber-700'}">(${f.severity})</span></p><p class="font-mono text-xs mt-1 text-slate-600">${f.sample}</p><p class="mt-2 text-slate-700">${f.advice}</p>`;
        $results.appendChild(div);
      }
    }

    $text.addEventListener('input', update);
    $sample.addEventListener('click', () => {
      $text.value = 'Please summarize this customer issue. Email: alex@example.com. Phone: 415-555-0199. API_KEY=sk-example1234567890abcdef. Authorization: Bearer eyJhbGciOi...';
      update();
    });
    $clear.addEventListener('click', () => {
      $text.value = '';
      update();
      $text.focus();
    });
    update();
  </script>
</BaseLayout>
