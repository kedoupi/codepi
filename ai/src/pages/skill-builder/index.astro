---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'AI Skill Builder - Multi-Client Skill Template Generator';
const description = 'Create reusable AI skill files for Codex AGENTS.md, Claude SKILL.md, Cursor rules, and generic AI agents. Browser-only, no signup.';

const faqs = [
  {
    q: 'Does this call an AI model?',
    a: 'No. The builder runs in your browser and formats the fields you provide into client-specific Markdown. Nothing is uploaded.',
  },
  {
    q: 'Which AI clients does it support?',
    a: 'The first version supports Codex AGENTS.md style instructions, Claude SKILL.md files, Cursor project rules, and a generic agent skill prompt.',
  },
  {
    q: 'Can I install a generated skill automatically?',
    a: 'No. The output is copy-ready text only. Automatic install is intentionally out of scope because skills can contain risky instructions or scripts.',
  },
  {
    q: 'What makes a good AI skill?',
    a: 'A good skill has a clear trigger, narrow scope, concrete steps, output expectations, safety limits, and a success check.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/skill-builder/">
  <CalculatorShell
    title="Multi-Client AI Skill Builder"
    intro="Turn a repeatable AI workflow into a reusable skill file for Codex, Claude, Cursor, or a generic AI agent. The generator is local, copy-only, and does not call an AI model."
  >
    <AdSense slot="top-ad" adSlot="ai-skill-builder-top" style="min-height:90px" />

    <div slot="inputs" class="space-y-5">
      <div>
        <label for="sb-template" class="block text-sm font-medium text-slate-700 mb-1">Starting template</label>
        <select id="sb-template" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600">
          <option value="custom">Custom workflow</option>
          <option value="code-review">Code review</option>
          <option value="seo">SEO content audit</option>
          <option value="writing">Article writing workflow</option>
          <option value="support">Customer support triage</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sb-client" class="block text-sm font-medium text-slate-700 mb-1">Output client</label>
          <select id="sb-client" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600">
            <option value="codex">Codex AGENTS.md</option>
            <option value="claude">Claude SKILL.md</option>
            <option value="cursor">Cursor rules</option>
            <option value="generic">Generic agent skill</option>
          </select>
        </div>
        <div>
          <label for="sb-name" class="block text-sm font-medium text-slate-700 mb-1">Skill name</label>
          <input id="sb-name" value="Project Code Review"
            class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600" />
        </div>
      </div>

      <div>
        <label for="sb-purpose" class="block text-sm font-medium text-slate-700 mb-1">Purpose</label>
        <textarea id="sb-purpose" rows="3" placeholder="What repeatable job should this skill help with?"
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
      </div>

      <div>
        <label for="sb-trigger" class="block text-sm font-medium text-slate-700 mb-1">When to use it</label>
        <textarea id="sb-trigger" rows="3" placeholder="Describe the trigger words, user intent, repo context, or file patterns."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
      </div>

      <div>
        <label for="sb-steps" class="block text-sm font-medium text-slate-700 mb-1">Workflow steps</label>
        <textarea id="sb-steps" rows="5" placeholder="One step per line. Example: inspect changed files, identify risks, run focused tests..."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sb-inputs" class="block text-sm font-medium text-slate-700 mb-1">Useful inputs</label>
          <textarea id="sb-inputs" rows="4" placeholder="Files, links, logs, screenshots, issue text..."
            class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
        </div>
        <div>
          <label for="sb-output" class="block text-sm font-medium text-slate-700 mb-1">Expected output</label>
          <textarea id="sb-output" rows="4" placeholder="Review findings, implementation plan, draft, checklist..."
            class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
        </div>
      </div>

      <div>
        <label for="sb-limits" class="block text-sm font-medium text-slate-700 mb-1">Safety limits</label>
        <textarea id="sb-limits" rows="4" placeholder="What should the assistant avoid? Mention secrets, destructive actions, account access, or unsupported claims."
          class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-600 text-sm leading-relaxed resize-y"></textarea>
      </div>

      <label class="flex items-start gap-3 rounded border border-slate-200 p-3 text-sm text-slate-700">
        <input id="sb-safety" type="checkbox" checked class="mt-1 h-4 w-4 rounded border-slate-300 text-teal-700 focus:ring-teal-600" />
        <span>Add a safety checklist for secrets, risky scripts, broad permissions, and unclear triggers.</span>
      </label>
    </div>

    <div slot="results" class="space-y-3">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold">Generated skill</h2>
          <p id="sb-client-note" class="text-xs text-slate-500 mt-1">Copy this into your selected client.</p>
        </div>
        <div class="flex items-center gap-3">
          <span id="sb-copy-status" class="text-xs text-emerald-600 hidden">Copied</span>
          <button type="button" id="sb-copy" class="rounded px-3 py-2 text-sm font-medium text-white bg-teal-700 hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">Copy</button>
        </div>
      </div>
      <textarea id="sb-output-md" rows="30" readonly spellcheck="false"
        class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm leading-relaxed resize-y bg-white"></textarea>
      <div class="rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
        <strong>Safety note:</strong> review generated skills before sharing or installing them. Do not include API keys, private account details, or scripts you do not understand.
      </div>
    </div>

    <AdSense slot="middle-ad" adSlot="ai-skill-builder-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">What this builder is for</h2>
      <p class="mb-3">AI skills are reusable instructions for repeated work. Instead of pasting the same long prompt every time, you can define when the workflow should trigger, what steps the assistant should follow, what output you expect, and what risks it must avoid.</p>
      <p class="mb-3">This page focuses on portable skill writing. It does not install anything, execute scripts, or connect to an AI account. That keeps the first version fast, private, and useful across several clients.</p>
      <p class="mb-3"><strong>Success sign:</strong> after copying the generated file, another person should understand when to use the skill, what it does, and what it must not do.</p>

      <h3 class="text-xl font-bold mt-6 mb-2">Client format guide</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <section class="border border-slate-200 rounded p-4">
          <h4 class="font-semibold text-slate-900">Codex AGENTS.md</h4>
          <p class="mt-2 text-sm text-slate-700">Best for project-level coding guidance. Put stable repo rules, workflow preferences, and verification expectations in the generated section.</p>
        </section>
        <section class="border border-slate-200 rounded p-4">
          <h4 class="font-semibold text-slate-900">Claude SKILL.md</h4>
          <p class="mt-2 text-sm text-slate-700">Best for reusable skills with a clear name, description, trigger, steps, and optional examples.</p>
        </section>
        <section class="border border-slate-200 rounded p-4">
          <h4 class="font-semibold text-slate-900">Cursor rules</h4>
          <p class="mt-2 text-sm text-slate-700">Best for editor-level project rules. Keep the scope narrow so the rule helps without overriding every request.</p>
        </section>
        <section class="border border-slate-200 rounded p-4">
          <h4 class="font-semibold text-slate-900">Generic agent skill</h4>
          <p class="mt-2 text-sm text-slate-700">Best when you want a portable Markdown prompt for ChatGPT, custom agents, or another tool.</p>
        </section>
      </div>

      <h3 class="text-xl font-bold mt-6 mb-2">Limitations</h3>
      <p class="mb-3">The builder cannot prove a skill is safe, complete, or supported by a specific client version. It also cannot inspect scripts, dependencies, or external repositories. Treat the output as a strong draft, then review it before use.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-15. Everything runs locally in your browser.</p>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

    <AdSense slot="bottom-ad" adSlot="ai-skill-builder-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    import { decodeState, pushUrlState } from '@shared/lib/url-state.js';

    const templates = {
      custom: {
        name: 'Reusable AI Workflow',
        purpose: 'Guide an AI assistant through a repeatable workflow with consistent inputs, steps, and output quality.',
        trigger: 'Use this when the user asks to run this recurring workflow or provides matching source material.',
        steps: 'Clarify the goal if it is ambiguous.\nInspect the provided context before producing output.\nFollow the workflow in order.\nCall out assumptions, risks, and missing inputs.\nReturn the final answer in the requested format.',
        inputs: 'User request\nRelevant files, notes, links, logs, or examples\nAny constraints that affect the result',
        output: 'A clear Markdown response with the result first, followed by assumptions, risks, and next steps when useful.',
        limits: 'Do not invent facts.\nDo not expose secrets or private account details.\nDo not run destructive actions without explicit user approval.',
      },
      'code-review': {
        name: 'Project Code Review',
        purpose: 'Review code changes for bugs, regressions, security issues, performance risks, and missing tests.',
        trigger: 'Use this when the user asks for a code review, PR review, diff review, or quality pass on changed files.',
        steps: 'Identify the changed files and intended behavior.\nPrioritize real bugs and user-visible regressions.\nCheck edge cases, error handling, security, and performance.\nVerify whether tests cover the changed behavior.\nReturn findings first, ordered by severity, with file references.',
        inputs: 'Git diff or changed files\nRelevant tests\nIssue, PR, or product context\nError logs if available',
        output: 'Findings first with severity, file path, and reason. Then open questions, test gaps, and a brief summary.',
        limits: 'Do not list style-only comments unless they hide a real bug.\nDo not claim a test passed unless it was actually run.\nDo not revert unrelated user changes.',
      },
      seo: {
        name: 'SEO Content Audit',
        purpose: 'Review a website page for search intent fit, content depth, title and description quality, internal links, and schema opportunities.',
        trigger: 'Use this when the user asks to improve SEO, review a landing page, thicken a thin page, or compare site-family content quality.',
        steps: 'Identify the page purpose and target search intent.\nCheck title, meta description, headings, canonical, and structured data.\nReview content depth, examples, limitations, and FAQ coverage.\nFind internal linking gaps and duplicate keyword promises.\nRecommend focused content edits before infrastructure changes.',
        inputs: 'Page source or URL\nTarget keyword or audience\nCurrent title and description\nRelated pages in the site family',
        output: 'A prioritized SEO audit with concrete edits, thin-page risks, and validation steps.',
        limits: 'Do not promise rankings.\nDo not rewrite unrelated pages.\nDo not change ad or account configuration unless explicitly requested.',
      },
      writing: {
        name: 'Article Writing Workflow',
        purpose: 'Turn research notes and a selected angle into a clear article draft with a strong opening, structured body, and practical takeaway.',
        trigger: 'Use this when the user asks to draft, polish, or package an article from notes, research, or a topic idea.',
        steps: 'Confirm the audience and core angle.\nExtract the strongest claim and supporting points.\nBuild a concise outline before drafting.\nWrite the opening, body, and close in the requested voice.\nCheck for repetition, vague claims, and unsupported facts.',
        inputs: 'Topic\nAudience\nResearch notes\nPreferred title or angle\nPublishing constraints',
        output: 'A publishable Markdown draft plus title options and any source or fact-check notes.',
        limits: 'Do not fabricate sources.\nDo not turn a practical article into a generic tutorial.\nDo not over-polish away the author voice.',
      },
      support: {
        name: 'Customer Support Triage',
        purpose: 'Classify support messages, identify urgency, extract needed account or product context, and draft a concise response.',
        trigger: 'Use this when the user provides customer messages, inbox threads, or support tickets that need triage.',
        steps: 'Summarize the customer problem in one sentence.\nClassify urgency and category.\nIdentify missing information needed to resolve it.\nDraft a direct response with next steps.\nFlag refunds, legal, security, or account access issues for human review.',
        inputs: 'Customer message\nOrder, account, or product context\nPolicy notes\nPrior replies',
        output: 'Category, urgency, issue summary, missing info, and a customer-ready response draft.',
        limits: 'Do not request passwords or sensitive secrets.\nDo not make policy exceptions unless authorized.\nEscalate legal, safety, billing, or account-security issues.',
      },
    };

    const fields = ['sb-template', 'sb-client', 'sb-name', 'sb-purpose', 'sb-trigger', 'sb-steps', 'sb-inputs', 'sb-output', 'sb-limits'];
    const els = Object.fromEntries(fields.map((id) => [id, document.getElementById(id)])) as Record<string, HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>;
    const $safety = document.getElementById('sb-safety') as HTMLInputElement;
    const $output = document.getElementById('sb-output-md') as HTMLTextAreaElement;
    const $copy = document.getElementById('sb-copy') as HTMLButtonElement;
    const $copyStatus = document.getElementById('sb-copy-status') as HTMLElement;
    const $clientNote = document.getElementById('sb-client-note') as HTMLElement;
    let hasBooted = false;

    const defaults = {
      template: 'code-review',
      client: 'codex',
      name: templates['code-review'].name,
      purpose: templates['code-review'].purpose,
      trigger: templates['code-review'].trigger,
      steps: templates['code-review'].steps,
      inputs: templates['code-review'].inputs,
      output: templates['code-review'].output,
      limits: templates['code-review'].limits,
      safety: true,
    };

    function lines(value: string, fallback: string): string[] {
      return (value.trim() || fallback)
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);
    }

    function bullets(value: string, fallback: string): string {
      return lines(value, fallback).map((line) => `- ${line}`).join('\n');
    }

    function numbered(value: string, fallback: string): string {
      return lines(value, fallback).map((line, index) => `${index + 1}. ${line}`).join('\n');
    }

    function slugify(value: string): string {
      return (value || 'ai-skill')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'ai-skill';
    }

    function state() {
      return {
        template: els['sb-template'].value,
        client: els['sb-client'].value,
        name: els['sb-name'].value,
        purpose: els['sb-purpose'].value,
        trigger: els['sb-trigger'].value,
        steps: els['sb-steps'].value,
        inputs: els['sb-inputs'].value,
        output: els['sb-output'].value,
        limits: els['sb-limits'].value,
        safety: $safety.checked,
      };
    }

    function safetySection(enabled: boolean): string {
      if (!enabled) return '';
      return [
        '## Safety Checklist',
        '- Remove API keys, tokens, private account details, and customer secrets before using examples.',
        '- Treat third-party skill files and scripts as untrusted until reviewed.',
        '- Ask before running destructive commands, changing billing settings, or accessing external accounts.',
        '- Keep the trigger narrow enough that the skill does not override unrelated tasks.',
      ].join('\n');
    }

    function codexSkill(data: ReturnType<typeof state>): string {
      return [
        `# ${data.name || 'AI Skill'} Instructions`,
        '',
        'Use this section in a project `AGENTS.md` when the repository needs this repeatable workflow.',
        '',
        '## Purpose',
        data.purpose || defaults.purpose,
        '',
        '## When To Use',
        bullets(data.trigger, defaults.trigger),
        '',
        '## Workflow',
        numbered(data.steps, defaults.steps),
        '',
        '## Inputs To Inspect',
        bullets(data.inputs, defaults.inputs),
        '',
        '## Expected Output',
        data.output || defaults.output,
        '',
        '## Limits',
        bullets(data.limits, defaults.limits),
        '',
        safetySection(data.safety),
      ].filter(Boolean).join('\n');
    }

    function claudeSkill(data: ReturnType<typeof state>): string {
      return [
        '---',
        `name: ${slugify(data.name)}`,
        `description: ${data.purpose || defaults.purpose}`,
        '---',
        '',
        `# ${data.name || 'AI Skill'}`,
        '',
        '## When To Use This Skill',
        bullets(data.trigger, defaults.trigger),
        '',
        '## What This Skill Does',
        data.purpose || defaults.purpose,
        '',
        '## Process',
        numbered(data.steps, defaults.steps),
        '',
        '## Inputs',
        bullets(data.inputs, defaults.inputs),
        '',
        '## Output Format',
        data.output || defaults.output,
        '',
        '## Guardrails',
        bullets(data.limits, defaults.limits),
        '',
        safetySection(data.safety),
      ].filter(Boolean).join('\n');
    }

    function cursorRule(data: ReturnType<typeof state>): string {
      return [
        '---',
        `description: ${data.purpose || defaults.purpose}`,
        'alwaysApply: false',
        '---',
        '',
        `# ${data.name || 'AI Skill'}`,
        '',
        'Apply this rule when:',
        bullets(data.trigger, defaults.trigger),
        '',
        'Follow this workflow:',
        numbered(data.steps, defaults.steps),
        '',
        'Use these inputs when available:',
        bullets(data.inputs, defaults.inputs),
        '',
        'Return:',
        data.output || defaults.output,
        '',
        'Do not:',
        bullets(data.limits, defaults.limits),
        '',
        safetySection(data.safety),
      ].filter(Boolean).join('\n');
    }

    function genericSkill(data: ReturnType<typeof state>): string {
      return [
        `# ${data.name || 'AI Skill'}`,
        '',
        'You are helping with a repeatable AI workflow.',
        '',
        '## Goal',
        data.purpose || defaults.purpose,
        '',
        '## Trigger',
        bullets(data.trigger, defaults.trigger),
        '',
        '## Steps',
        numbered(data.steps, defaults.steps),
        '',
        '## Inputs',
        bullets(data.inputs, defaults.inputs),
        '',
        '## Final Answer',
        data.output || defaults.output,
        '',
        '## Constraints',
        bullets(data.limits, defaults.limits),
        '',
        safetySection(data.safety),
      ].filter(Boolean).join('\n');
    }

    function updateNote(client: string) {
      const notes = {
        codex: 'Suggested use: paste into a project AGENTS.md or merge the section into existing repo instructions.',
        claude: 'Suggested use: save as SKILL.md inside a Claude skill folder after reviewing the content.',
        cursor: 'Suggested use: paste into a Cursor rule file and keep alwaysApply false unless the rule is truly global.',
        generic: 'Suggested use: paste into ChatGPT, a custom agent, or a shared team prompt library.',
      };
      $clientNote.textContent = notes[client] || notes.generic;
    }

    function updateUrlSoon() {
      if (!hasBooted) return;
      window.clearTimeout((updateUrlSoon as any).timer);
      (updateUrlSoon as any).timer = window.setTimeout(() => {
        const data = state();
        pushUrlState(
          {
            template: data.template,
            client: data.client,
          },
          {
            ownedKeys: ['template', 'client', 'name', 'purpose', 'trigger', 'steps', 'inputs', 'output', 'limits', 'safety'],
          },
        );
      }, 250);
    }

    function render() {
      const data = state();
      const renderers = {
        codex: codexSkill,
        claude: claudeSkill,
        cursor: cursorRule,
        generic: genericSkill,
      };
      $output.value = (renderers[data.client] || genericSkill)(data);
      updateNote(data.client);
      updateUrlSoon();
    }

    function applyTemplate(key: string) {
      const selected = templates[key] || templates.custom;
      els['sb-name'].value = selected.name;
      els['sb-purpose'].value = selected.purpose;
      els['sb-trigger'].value = selected.trigger;
      els['sb-steps'].value = selected.steps;
      els['sb-inputs'].value = selected.inputs;
      els['sb-output'].value = selected.output;
      els['sb-limits'].value = selected.limits;
    }

    function boot() {
      const decoded = decodeState(window.location.search, defaults);
      els['sb-template'].value = decoded.template;
      els['sb-client'].value = decoded.client;
      els['sb-name'].value = decoded.name;
      els['sb-purpose'].value = decoded.purpose;
      els['sb-trigger'].value = decoded.trigger;
      els['sb-steps'].value = decoded.steps;
      els['sb-inputs'].value = decoded.inputs;
      els['sb-output'].value = decoded.output;
      els['sb-limits'].value = decoded.limits;
      $safety.checked = decoded.safety;
      render();
      hasBooted = true;
    }

    fields.forEach((id) => {
      els[id].addEventListener('input', render);
      els[id].addEventListener('change', render);
    });
    els['sb-template'].addEventListener('change', () => {
      applyTemplate(els['sb-template'].value);
      render();
    });
    $safety.addEventListener('change', render);
    $copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText($output.value);
      $copyStatus.classList.remove('hidden');
      setTimeout(() => $copyStatus.classList.add('hidden'), 1200);
    });

    boot();
  </script>
</BaseLayout>
