---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import CalculatorShell from '@shared/components/CalculatorShell.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'Temperature Converter - Celsius, Fahrenheit, Kelvin';
const description = 'Convert between Celsius, Fahrenheit, and Kelvin. Free, instant, with formula explanation.';

const TEMP_UNITS = [
  { id: 'C', label: 'Celsius (°C)' },
  { id: 'F', label: 'Fahrenheit (°F)' },
  { id: 'K', label: 'Kelvin (K)' },
];

const faqs = [
  {
    q: 'Why is temperature not converted with a simple multiplier?',
    a: 'Celsius, Fahrenheit, and Kelvin have different zero points. Fahrenheit also uses a different interval size, so most conversions need both multiplication and addition or subtraction.',
  },
  {
    q: 'Can Kelvin be negative?',
    a: 'No. Kelvin starts at absolute zero. This tool still shows the math for any numeric input, but negative Kelvin values are not physically meaningful.',
  },
  {
    q: 'Are the results exact?',
    a: 'The formulas are exact for scale conversion, but the displayed result is rounded to four decimal places for readability.',
  },
];
---
<BaseLayout title={title} description={description} pathname="/temperature-converter/">
  <CalculatorShell
    title="Temperature Converter"
    intro="Convert between Celsius, Fahrenheit, and Kelvin with the actual formula shown."
  >
    <AdSense slot="top-ad" adSlot="temp-top" style="min-height:90px" />

    <form id="tc-form" class="space-y-5" slot="inputs" autocomplete="off">
      <div>
        <label for="tc-value" class="block text-sm font-medium text-slate-700 mb-1">Value</label>
        <input id="tc-value" type="number" inputmode="decimal" step="any" value="100"
               class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div>
        <label for="tc-from" class="block text-sm font-medium text-slate-700 mb-1">From</label>
        <select id="tc-from" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
          {TEMP_UNITS.map((u) => <option value={u.id}>{u.label}</option>)}
        </select>
      </div>

      <div>
        <label for="tc-to" class="block text-sm font-medium text-slate-700 mb-1">To</label>
        <select id="tc-to" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
          {TEMP_UNITS.map((u) => <option value={u.id}>{u.label}</option>)}
        </select>
      </div>

      <button type="button" id="tc-swap-btn" class="text-sm text-blue-600 hover:text-blue-700 underline">Swap From / To</button>
    </form>

    <div slot="results" class="space-y-5">
      <div>
        <p class="text-sm uppercase tracking-wider text-slate-500">Result</p>
        <p id="tc-r-value" class="text-3xl sm:text-4xl font-bold text-slate-900 tabular-nums"></p>
        <p id="tc-r-equation" class="text-sm text-slate-500 mt-1"></p>
      </div>
    </div>

    <AdSense slot="middle-ad" adSlot="temp-middle" format="rectangle" style="min-height:250px;max-width:300px;margin-left:auto;margin-right:auto" />

    <div slot="content">
      <h2 class="text-2xl font-bold mb-3">Celsius, Fahrenheit, and Kelvin formulas</h2>
      <p class="mb-3">Unlike length or weight, temperature scales have different zero points, so you can't just multiply. The conversion goes through Celsius as the bridge:</p>
      <ul class="list-disc list-inside mb-3 text-sm space-y-1">
        <li><strong>°F → °C:</strong> <code>(°F − 32) × 5⁄9</code></li>
        <li><strong>K → °C:</strong> <code>K − 273.15</code></li>
        <li><strong>°C → °F:</strong> <code>°C × 9⁄5 + 32</code></li>
        <li><strong>°C → K:</strong> <code>°C + 273.15</code></li>
      </ul>
      <p class="mb-3">Some quick reference points: water freezes at 0°C / 32°F / 273.15 K; water boils (at 1 atm) at 100°C / 212°F / 373.15 K; absolute zero is 0 K / −273.15°C / −459.67°F.</p>
      <p class="mb-3">For unit ratios that <em>are</em> a simple multiplication (length, weight, volume, area), see the <a href="/unit-converter/" class="text-blue-600 hover:underline">unit converter</a>.</p>
      <p class="mb-3"><strong>Limitations:</strong> this converter handles temperature scales only. It does not adjust for altitude, pressure, weather station calibration, or scientific measurement uncertainty.</p>
      <p class="text-sm text-slate-500">Last reviewed: 2026-05-14. The formulas are the standard Celsius/Fahrenheit/Kelvin relationships and run locally in your browser.</p>

      <details class="mt-6 group">
        <summary class="cursor-pointer text-sm font-medium text-blue-700 hover:text-blue-800">Show the math</summary>
        <div id="tc-show-math" class="mt-3 text-sm text-slate-700 leading-relaxed bg-slate-50 border border-slate-200 rounded p-4 font-mono whitespace-pre-line"></div>
      </details>

      <section class="mt-10">
        <h2 class="text-2xl font-bold mb-4">Frequently asked questions</h2>
        <div class="space-y-2">
          {faqs.map((f) => (
            <details class="border border-slate-200 rounded p-4 group">
              <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
              <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    </div>

    <AdSense slot="bottom-ad" adSlot="temp-bottom" style="min-height:90px" />
  </CalculatorShell>

  <script>
    import { decodeState, pushUrlState } from '@shared/lib/url-state.js';

    const SYM = { C: '°C', F: '°F', K: 'K' };
    const NAME = { C: 'Celsius', F: 'Fahrenheit', K: 'Kelvin' };

    const $val = document.getElementById('tc-value');
    const $from = document.getElementById('tc-from');
    const $to = document.getElementById('tc-to');

    const DEFAULTS = { val: 100, from: 'C', to: 'F' };
    const init = decodeState(window.location.search, DEFAULTS);
    if (Number.isFinite(init.val)) $val.value = String(init.val);
    if (NAME[init.from]) $from.value = init.from;
    if (NAME[init.to]) $to.value = init.to;

    document.getElementById('tc-swap-btn').addEventListener('click', () => {
      const f = $from.value, t = $to.value;
      $from.value = t; $to.value = f;
      update();
    });

    let urlTimer;
    function syncUrl() {
      clearTimeout(urlTimer);
      urlTimer = setTimeout(() => pushUrlState({
        val: $val.value, from: $from.value, to: $to.value,
      }), 250);
    }

    function toCelsius(v, unit) {
      if (unit === 'C') return v;
      if (unit === 'F') return (v - 32) * 5 / 9;
      return v - 273.15; // K
    }
    function fromCelsius(c, unit) {
      if (unit === 'C') return c;
      if (unit === 'F') return c * 9 / 5 + 32;
      return c + 273.15;
    }

    function fmt(n) {
      if (!Number.isFinite(n)) return '—';
      // 4 decimal places max; trim trailing zeros.
      const fixed = n.toFixed(4);
      return parseFloat(fixed).toString();
    }

    function explain(value, fromUnit, toUnit, celsius, result) {
      const v = fmt(value);
      const r = fmt(result);
      if (fromUnit === toUnit) {
        return `${v} ${SYM[fromUnit]} = ${r} ${SYM[toUnit]} (same scale)`;
      }
      // Direct paths from Celsius save a step.
      if (fromUnit === 'C' && toUnit === 'F') {
        return `${v} °C × 9⁄5 + 32 = ${fmt(value * 9 / 5)} + 32 = ${r} °F`;
      }
      if (fromUnit === 'F' && toUnit === 'C') {
        return `(${v} − 32) × 5⁄9 = ${fmt(value - 32)} × 5⁄9 = ${r} °C`;
      }
      if (fromUnit === 'C' && toUnit === 'K') {
        return `${v} °C + 273.15 = ${r} K`;
      }
      if (fromUnit === 'K' && toUnit === 'C') {
        return `${v} K − 273.15 = ${r} °C`;
      }
      // F ↔ K both go through Celsius.
      const c = fmt(celsius);
      if (fromUnit === 'F' && toUnit === 'K') {
        return [
          `Step 1: (${v} − 32) × 5⁄9 = ${c} °C`,
          `Step 2: ${c} + 273.15 = ${r} K`,
        ].join('\n');
      }
      if (fromUnit === 'K' && toUnit === 'F') {
        return [
          `Step 1: ${v} − 273.15 = ${c} °C`,
          `Step 2: ${c} × 9⁄5 + 32 = ${r} °F`,
        ].join('\n');
      }
      return `${v} ${SYM[fromUnit]} = ${r} ${SYM[toUnit]}`;
    }

    function update() {
      const value = parseFloat($val.value);
      const fromUnit = $from.value;
      const toUnit = $to.value;
      const valid = Number.isFinite(value);
      const celsius = valid ? toCelsius(value, fromUnit) : NaN;
      const result = valid ? fromCelsius(celsius, toUnit) : NaN;

      document.getElementById('tc-r-value').textContent = valid ? `${fmt(result)} ${SYM[toUnit]}` : '—';
      document.getElementById('tc-r-equation').textContent = valid
        ? `${fmt(value)} ${SYM[fromUnit]} (${NAME[fromUnit]}) = ${fmt(result)} ${SYM[toUnit]} (${NAME[toUnit]})`
        : 'Enter a numeric value to see the result.';

      const mathEl = document.getElementById('tc-show-math');
      mathEl.textContent = valid
        ? explain(value, fromUnit, toUnit, celsius, result)
        : 'Enter a numeric value to see the math.';

      syncUrl();
    }

    document.getElementById('tc-form').addEventListener('input', update);
    update();
  </script>
</BaseLayout>
