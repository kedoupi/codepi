---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import AdSense from '@shared/components/AdSense.astro';

const title = 'Free Format Converters for Time Zones, Units, and Temperature';
const description = 'Free, no-signup converters for time zones, units, and temperature. Instant browser results with formulas, examples, and clear limitations.';

const tools = [
  { href: '/time-zone-converter/',   name: 'Time Zone Converter',   blurb: 'Convert any date and time between 80+ time zones with DST handling.' },
  { href: '/unit-converter/',        name: 'Unit Converter',        blurb: 'Length, weight, volume, and area conversions between metric and imperial units.' },
  { href: '/temperature-converter/', name: 'Temperature Converter', blurb: 'Convert Celsius, Fahrenheit, and Kelvin with the formula shown on the page.' },
];
---
<BaseLayout title={title} description={description} pathname="/" schemaType="WebSite">
  <section class="mb-10 max-w-4xl space-y-4">
    <p class="kdp-section-label">Small converters with the assumptions left visible</p>
    <h1 class="text-5xl font-semibold leading-[1.02] sm:text-6xl">Free Format Converters</h1>
    <p class="max-w-3xl text-xl leading-8 text-stone-700">Fast, no-signup converters for time zones, units, and temperature. Each tool gives instant results in your browser and explains the assumptions or formula behind the conversion.</p>
    <p class="max-w-3xl text-stone-600 leading-7">Use ConvertKDP for everyday planning tasks: scheduling across regions, checking metric and imperial measurements, or translating a temperature between weather, cooking, science, and engineering contexts.</p>
  </section>

  <AdSense adSlot="convert-home-top" style="min-height:90px" />

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    {tools.map((c) => (
      <a href={c.href} class="kdp-card block rounded-2xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2">
        <article>
          <h2 class="font-serif text-2xl font-semibold tracking-normal mb-2">{c.name}</h2>
          <p class="text-sm leading-6 text-stone-600 mb-4">{c.blurb}</p>
          <p class="kdp-link text-sm">Use Converter -></p>
        </article>
      </a>
    ))}
  </section>

  <section class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">Why these converters include explanations</h2>
      <p>
        Simple conversions can still go wrong when the context is unclear. A time-zone conversion depends on date, daylight saving rules, and location names. Unit conversion depends on whether you need length, area, volume, mass, or temperature. ConvertKDP keeps the result next to the method so you can check both the answer and the interpretation.
      </p>
      <p>
        The tools are designed for quick reference, planning, writing, travel, schoolwork, engineering notes, and product documentation. They are not a substitute for regulated measurement systems or professional specifications where exact calibration matters.
      </p>
    </div>

    <div class="kdp-prose space-y-3">
      <h2 class="font-serif text-3xl font-semibold tracking-normal text-stone-950">Good use cases</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li>Coordinate meetings across cities without manually counting hours.</li>
        <li>Convert recipe, shipping, construction, or fitness measurements between metric and imperial units.</li>
        <li>Translate weather and science temperatures while seeing the exact Celsius, Fahrenheit, or Kelvin formula.</li>
        <li>Copy clean results into notes, messages, spreadsheets, or documentation.</li>
      </ul>
    </div>
  </section>

  <section class="mt-12 pt-8 border-t border-[#e6d9c8]">
    <h2 class="kdp-section-label mb-3">About this site</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li><a href="/about/" class="text-blue-600 hover:underline">About</a></li>
      <li><a href="/privacy/" class="text-blue-600 hover:underline">Privacy</a></li>
      <li><a href="/terms/" class="text-blue-600 hover:underline">Terms</a></li>
      <li><a href="/contact/" class="text-blue-600 hover:underline">Contact</a></li>
    </ul>
  </section>

  <AdSense adSlot="convert-home-bottom" style="min-height:90px" />
</BaseLayout>
